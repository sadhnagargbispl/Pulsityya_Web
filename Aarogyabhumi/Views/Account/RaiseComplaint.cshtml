@model Shopinv.Models.M_Complaint
@{
    ViewBag.Title = "RaiseComplaint";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode == 46) {
            return true;
        }
        else if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
    function validateEmail(email) {
        var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        return emailRegex.test(email);
    }

    function SaveCompaint() {
        $("#Apply").prop('disabled', true);
        var complaintid = $("#complaintid").val();
        var subject = $("#subject").val();
        if (subject == "") {
            alert("Please enter subject");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var email = $("#email").val();
        if (email == "") {
            alert("Please enter email");
            $("#Apply").prop('disabled', false);
            return false;
        }
        if (email != "" && validateEmail(email) == false) {
            alert("Please enter valid email");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var Name = $("#Name").val();
        if (Name == "") {
            alert("Please enter name");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var mobileno = $("#mobileno").val();
        if (mobileno == "") {
            alert("Please enter mobileno");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var description = $("#description").val();
        if (description == "") {
            alert("Please enter description");
            $("#Apply").prop('disabled', false);
            return false;
        }

        $.ajax({
            type: "Post",
            url: "/Account/SaveCompaint",
            async: true,
            data: {
                Complaintid: complaintid, Subject: subject, Email: email,
                Name: Name, Mobileno: mobileno, Description: description
            },
            success: function (data) {
                debugger;
                if (data.msg != "") {
                    alert(data.msg);
                }
                if (data.status == "OK") {
                    $("#subject").val('');
                    $("#email").val('');
                    $("#Name").val('');
                    $("#mobileno").val('');
                    $("#description").val('');
                }
                $("#Apply").prop('disabled', false);
            },
            failure: function (response) {
                console.log(response.responseText);
                $("#Apply").prop('disabled', false);
            },
            error: function (response) {
                console.log(response.responseText);
                $("#Apply").prop('disabled', false);
            }
        });
    }

</script>
<!-- Mini Banner (Green Offer Bar) -->
<div class="mini-banner bg-success py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">

            </div>
        </div>
    </div>
</div>

<section class="pt-4 pb-4">
    <div class="container">
        <div class="row justify-content-center align-items-center g-5">
            <div class="col-lg-10 col-sm-10 col-12">
                <div class="bg-white rounded-4 border shadow-sm overflow-hidden p-3">
                    <div class="p-3">
                        <div class="mb-lg-9 mb-4">
                            <h4 class="mb-2 fw-bold">Raise Complaint</h4>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Complaint Type</label>
                                    <select class="form-select" id="complaintid">
                                        @if (Model.complainttype != null && Model.complainttype.Count > 0)
                                        {
                                            foreach (var item in Model.complainttype)
                                            {
                                                <option value="@item.complaintid">@item.complaintname</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Subject</label>
                                    <input type="text" class="form-control" style="height:37px;" id="subject" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Name</label>
                                    <input type="text" class="form-control" value="@Convert.ToString(Session["UserName"])"  style="height:37px;" id="Name" readonly required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Mobileno</label>
                                    <input type="text" class="form-control" style="height:37px;" value="@Convert.ToString(Session["MobileNo"])" onkeypress="return isNumberKey(event);" readonly id="mobileno" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="@Convert.ToString(Session["Email"])" style="height:37px;" id="email" readonly required />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-4">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" id="description" required></textarea>
                                </div>
                            </div>

                        </div>

                        <div class="d-grid">
                            <button type="submit" id="Apply" onclick="SaveCompaint()" class="btn btn-dark w-100 mb-2">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
