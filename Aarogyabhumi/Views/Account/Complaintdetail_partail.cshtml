@model Shopinv.Models.ComplaintReplyDetailsRes
@* Reply popup body - injected into #GrdOrderNo on TicketList via /Account/GetComplaintReplyDetails (JSON tblOrder). *@
<div class="table-responsive">
    @if (Model != null && Model.response == "OK" && Model.complaintreplydetail != null && Model.complaintreplydetail.Count > 0)
    {
        <table class="table mytable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Reply</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.complaintreplydetail)
                {
                    <tr>
                        <td style="white-space: nowrap;">@item.replydate</td>
                        <td>@item.reply</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="no-record">No Record Found</p>
    }
</div>
