
@{
    ViewBag.Title = "Forgot Password";
}

<div class="content-row">
    <div class="container">
        <div class="login-bar">
            <div class="login-col">
                <h3>Forgot Password ?</h3>
                <p>Enter your User ID and we will send your password to your registered email ID.</p>
                <div class="form-group">
                    <label for="userid">User ID</label>
                    <input type="text" id="userid" class="form-control" placeholder="Enter your User ID" />
                </div>
                <button type="button" id="signupbtn" onclick="Forgotpassword()" class="btn btn-sub">Get Password</button>
                <p class="link-register">Remember your password ? <a href="@Url.Action("Login", "Account")">Login</a> now.</p>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function Forgotpassword() {
        $("#signupbtn").prop("disables", true);
        var userid = $("#userid").val();
        if (userid == "") {
            alert("Enter user id.");
            $("#userid").focus();
            $("#signupbtn").prop("disables", false);
            return false;
        }

        $.ajax({
            type: "POST",
            url: "/Account/Forgotpassword",
            async: true,
            dataType: "Json",
            timeout: 900000,
            data: { Userid: userid },
            success: function (data) {
                alert(data.msg);
                $("#signupbtn").prop("disables", false);
                $("#userid").val('');
            },
            error: function (error) {
                console.log(error);
            }
        });
    }
</script>
