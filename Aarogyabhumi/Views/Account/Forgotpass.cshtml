
@{
    ViewBag.Title = "Forgotpass";
}
<div class="mini-banner bg-success py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">
            </div>
        </div>
    </div>
</div>
<section class="pt-4 pb-4">
    <div class="container">
        <div class="row justify-content-center align-items-center g-5">
            <div class="col-lg-5 col-sm-10 col-12">
                <div class="bg-white rounded-4 border shadow-sm overflow-hidden p-3">
                    <div class="p-3">
                        <div class="mb-lg-9 mb-4">
                            <h4 class="mb-2 fw-bold">Forgot Password</h4>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Userid</label>
                            <input type="text" id="userid" class="form-control" />
                        </div>
                        <div class="d-grid">
                            <button type="button" id="signupbtn" onclick="Forgotpassword()" class="btn btn-dark w-100 mb-2">Get Password</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    function Forgotpassword() {
        $("#signupbtn").prop("disables", true);
        var userid = $("#userid").val();
        if (userid == "") {
            alert("Enter user id.");
            $("#userid").focus();
            $("#signupbtn").prop("disables", false);
            return false;
        }

        $.ajax({
            type: "POST",
            url: "/Account/Forgotpassword",
            async: true,
            dataType: "Json",
            timeout: 900000,
            data: { Userid: userid },
            success: function (data) {
                alert(data.msg);
                $("#signupbtn").prop("disables", false);
                $("#userid").val('');
            },
            error: function (error) {
                console.log(error);
            }
        });
    }
</script>
