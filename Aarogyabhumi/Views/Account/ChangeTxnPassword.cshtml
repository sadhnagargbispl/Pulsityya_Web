@model Shopinv.Models.M_Changepassword
@{
    ViewBag.Title = "Change Txn Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (ViewBag.passerr != null)
{

    if (ViewBag.passerr == "Change")
    {
        <script type="text/javascript">
            alert('Password change successfully.');
            //window.location.href = "/Account/LogOff"
            $("#passwd").val('');
            $("#newpass").val('');
        </script>
    }
    else
    {
        <script type="text/javascript">
         alert('@ViewBag.passerr');
        </script>
    }
}

<section class="pt-4 pb-4">
    <div class="container">
        <div class="row justify-content-center align-items-center g-5">
            <div class="col-lg-6 col-sm-10 col-12">
                <div class="bg-white rounded-4 border shadow-sm overflow-hidden p-3">
                    <div class="p-3">
                        <div class="mb-lg-9 mb-4">
                            <h4 class="mb-2 fw-bold">Change Txn Password</h4>
                        </div>
                        @using (Html.BeginForm("ChangeTxnPassword", "Account", FormMethod.Post, new { id = "registerForm" }))
                        {

                            <div class="mb-4">
                                <label class="form-label">Old Password</label>
                                @Html.TextBoxFor(m => m.passwd, new { @id = "passwd", @placeholder = "Enter Old password", @class = "form-control", @required = "required" })
                                <b><span id="spid" class="text-success"></span></b>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">New Password</label>
                                @Html.TextBoxFor(m => m.npasswd, new { @id = "newpass", @placeholder = "Enter New Password", @class = "form-control", @required = "required" })
                            </div>

                            <div class="d-grid">
                                <button type="submit" id="signupbtn" class="btn btn-dark w-100 mb-2">Change</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

