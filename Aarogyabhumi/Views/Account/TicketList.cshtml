@model Shopinv.Models.M_Complaint
@{
    ViewBag.Title = "Complaints";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasRows = Model.complaintdetail != null && Model.complaintdetail.Count > 0;
}

<section class="contents">
    <div class="breadcrmb plain">
        <div class="breadcrmb-content">
            <div class="container">
                <ul class="breadcrmb-loc">
                    <li><a href="~/Home/Index">Home</a></li>
                    <li><a class="active">Complaints</a></li>
                </ul>
            </div>
        </div>
    </div>
    <!--  -->
    <div class="content-row">
        <div class="my-account">
            <div class="container">
                <div class="table-responsive">
                    <table class="table mytable">
                        <thead>
                            <tr>
                                <th>Complaint ID</th>
                                <th>Date</th>
                                <th>Complaint</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hasRows)
                            {
                                foreach (var item in Model.complaintdetail)
                                {
                                    <tr>
                                        <td>@item.complaintid</td>
                                        <td>@item.complaintdate</td>
                                        <td>@item.complaint</td>
                                        <td>
                                            <a class="view" href="javascript:void(0)" onclick="ShowReply('@item.complaintid')">View Reply</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="no-record">You have not raised any complaint yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!--modal box-->
    <div class="modal fade" id="myModal" role="dialog">
        <div class="modal-dialog" style="max-width: 700px;">
            <div class="modal-content">
                <button type="button" class="close" data-dismiss="modal"></button>
                <h4>Complaint Reply</h4>
                <div id="GrdOrderNo"></div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script type="text/javascript">
        function ShowReply(complaintid) {
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/Account/GetComplaintReplyDetails")',
                dataType: "json",
                data: { complaintid: complaintid }
            }).done(function (data) {
                $('#GrdOrderNo').html(data.tblOrder);
                $('#myModal').modal('show');
            }).fail(function (error) {
                alert(error.statusText);
            });
        }
    </script>
}
