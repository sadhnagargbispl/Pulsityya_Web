                            }
                            @if (!string.IsNullOrEmpty(youtubeUrl))
                            {
                                <li><a href="@youtubeUrl" target="_blank" rel="noopener"><i class="fa fa-youtube-play fa-lg">&nbsp;</i></a></li>
                            }
                            @if (!string.IsNullOrEmpty(linkedInUrl))
