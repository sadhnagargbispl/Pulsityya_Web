                        <div class="mb-menu"><span></span><span></span><span></span></div>
                        <a href="~/Home/Index" class="logo mb">@logoHtml</a>
                        <div class="buyer-crt"><a href="~/ViewCart/ViewCart"><span class="crt-icon"><span class="crt-qty cart-count" id="cartCount">@cartCount</span></span></a></div>
                        <div class="buyer-fav"><a href="@(loggedIn ? Url.Content("~/ViewCart/Wishlist") : Url.Content("~/Account/Login"))"><span class="fav-icon"></span></a></div>
                        <nav class="byer-nav">
                            <ul class="stge1">
                                @if (loggedIn)
                                {
                                    <li>
                                        <a href="~/Home/MemberProfile"><img src="~/theme/img/icon-buyer.png" alt="" /><span class="nav-lbl">Hi, @Convert.ToString(Session["UserName"])</span><i class="fa fa-angle-down" aria-hidden="true"></i></a>
                                        <ul class="stge2">
                                            <li><a href="~/Home/MemberProfile">Profile</a></li>
                                            @if (isDistributor)
                                            {
                                                <li><a href="~/Account/RedirectToCPanel">My Account</a></li>
                                            }
                                            <li><a href="~/ViewCart/ViewCart">Cart</a></li>
                                            <li><a href="~/Home/Myorders">Orders</a></li>
                                            <li><a href="~/Account/RaiseComplaint">Complaint</a></li>
                                            <li><a href="~/Account/TicketList">Complaint List</a></li>
                                            @if (isDistributor)
                                            {
                                                <li><a href="~/Home/WalletDetail">Wallet</a></li>
                                                <li><a href="~/Home/ReferalLinkPage">Refer</a></li>
                                                <li><a href="~/Account/ChangeTxnPassword">Change Txn Password</a></li>
