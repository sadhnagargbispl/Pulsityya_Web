    <!-- scripts -->
    <script src="~/theme/js/bootstrap.min.js"></script>
    <!--Plugins-->
    <script src="~/theme/plugins/animation/js/wow.min.js"></script>
    <script src="~/theme/plugins/owl-carousel/owl.carousel.js"></script>
    <!-- layout.js calls .nivoSlider() on every page; without the plugin it throws and the carousels never start -->
    <script src="~/theme/plugins/nivo-slider/nivo.js"></script>
    @RenderSection("scripts", required: false)
    <!-- custom js -->
    <script src="~/theme/js/layout.js"></script>
    <script src="~/theme/js/shop.js"></script>
    <script>
        $(function () {
            // header search -> product listing
            function goSearch() {
                var key = $.trim($('#search-key').val());
                window.location.href = '@Url.Content("~/CategoryList/CategoryList")' + '?CatName=' + encodeURIComponent(key);
            }
            $('#search-btn').on('click', goSearch);
            $('#search-key').on('keydown', function (e) {
                if (e.which === 13) { e.preventDefault(); goSearch(); }
            });

            // "Products" menu is filled from the category master, then the mobile drawer copy
            // (built by layout.js on page load) is rebuilt so it gets the categories too
            $.ajax({ type: 'POST', url: '@Url.Content("~/Home/CategoryList")' }).done(function (data) {
                var $sub = $('.tp-menu .stge-2');
                $sub.html(data.tblOrder);
                $sub.find('a').removeClass('dropdown-item');
                $('.mb-menu-lst.main').html('<ul>' + $('.stge-1').html() + '</ul>');
                var $mbSub = $('.mb-menu-lst.main').find('.stge-2');
                $mbSub.unwrap();
                $mbSub.removeAttr('class');
            });

            // one-time notice popup (home page), once per browser session
            var $notice = $('#onloadModal');
            if ($notice.length) {
                try {
                    if (!sessionStorage.getItem('onloadModalShown')) {
                        $notice.modal({ backdrop: 'static', keyboard: false });
                        sessionStorage.setItem('onloadModalShown', 'true');
                    }
                } catch (e) {
                    $notice.modal('show');
                }
            }
        });
    </script>
    @Html.Partial("_VoiceAssistant")
</body>
</html>
