                                }
                                else
                                {
                                    <li>
                                        <a href="~/Account/Login"><img src="~/theme/img/icon-buyer.png" alt="" /><span class="nav-lbl">Login / Register</span><i class="fa fa-angle-down" aria-hidden="true"></i></a>
                                        <ul class="stge2">
                                            <li><a href="~/Account/Login">Login</a></li>
