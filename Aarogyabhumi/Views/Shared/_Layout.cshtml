                                }
                                @if (!string.IsNullOrEmpty(compMail))
                                {
                                    <li><a class="email" href="mailto:@compMail"><i class="fa fa-envelope">&nbsp;</i> <span class="cont-text">@compMail</span></a></li>
                                }
                                @if (!string.IsNullOrEmpty(workingHours))
                                {
