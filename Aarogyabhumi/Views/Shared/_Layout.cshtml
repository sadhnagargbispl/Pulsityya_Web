@{
    // every company detail comes from m_companymaster (loaded into Session by SiteExtension/CompanyDetail.cs)
    string compName = Convert.ToString(Session["CompName"]);
    string compTitle = Convert.ToString(Session["CompTitle"]);
    if (string.IsNullOrEmpty(compTitle)) { compTitle = compName; }
    string compTagline = Convert.ToString(Session["CompTagline"]);
    string compAdd = Convert.ToString(Session["CompAdd"]);
    string compMail = Convert.ToString(Session["CompMail"]);
    string contactNo = Convert.ToString(Session["ContactNo"]).Replace("?", "").Trim();
    string telHref = new string(contactNo.Where(c => char.IsDigit(c) || c == '+').ToArray());
    string workingHours = Convert.ToString(Session["CompWorkingHours"]);
    string aboutUs = Convert.ToString(Session["CompAboutUs"]);
    string freeShip = Convert.ToString(Session["FreeShipAmount"]);
    string webSite = Convert.ToString(Session["WebSite"]);
    string facebookUrl = Convert.ToString(Session["FacebookUrl"]);
    string instagramUrl = Convert.ToString(Session["InstagramUrl"]);
    string twitterUrl = Convert.ToString(Session["TwitterUrl"]);
    string youtubeUrl = Convert.ToString(Session["YoutubeUrl"]);
    string linkedInUrl = Convert.ToString(Session["LinkedInUrl"]);
    bool hasSocial = !string.IsNullOrEmpty(facebookUrl) || !string.IsNullOrEmpty(instagramUrl) || !string.IsNullOrEmpty(twitterUrl)
                     || !string.IsNullOrEmpty(youtubeUrl) || !string.IsNullOrEmpty(linkedInUrl);

    // logo only from m_companymaster.CompLogo (resolved to a full URL in CompanyDetail.cs);
    // when it is empty the company name is shown as text - no image fallback
    string logoUrl = Convert.ToString(Session["CompLogoUrl"]);
    string logoAlt = string.IsNullOrEmpty(compTagline) ? compName : compName + " | " + compTagline;
    IHtmlString logoHtml = !string.IsNullOrEmpty(logoUrl)
        ? new HtmlString("<img src=\"" + HttpUtility.HtmlAttributeEncode(logoUrl) + "\" alt=\"" + HttpUtility.HtmlAttributeEncode(logoAlt) + "\">")
        : new HtmlString("<span class=\"logo-txt\">" + HttpUtility.HtmlEncode(compTitle) + "</span>");

    bool loggedIn = Session["UserDetail"] != null;
    bool isDistributor = Convert.ToString(Session["MemMode"]) == "D";
    string cartCount = Session["cartcount"] != null ? Convert.ToString(Session["cartcount"]) : "0";
    string pageTitle = Convert.ToString(ViewBag.Title);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(pageTitle) ? "" : pageTitle + " | ")@compName@(string.IsNullOrEmpty(compTagline) ? "" : " | " + compTagline)</title>
    @if (!string.IsNullOrEmpty(logoUrl))
    {
        <link rel="icon" href="@logoUrl" />
    }
    <meta name="description" content="@aboutUs" />
    <meta name="author" content="@compName" />
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#176a3a" />
    <meta name="language" content="EN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@compName" />
    <meta property="og:description" content="@aboutUs" />
    <meta property="og:url" content="@webSite" />
    <meta property="og:image" content="@logoUrl" />
    <!--css styles -->
    <link rel="stylesheet" href="~/theme/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/theme/css/bs5-compat.css">
    <link rel="stylesheet" href="~/theme/css/layout.css">
    <link rel="stylesheet" href="~/theme/css/layout-responsive.css">
    <link rel="stylesheet" href="~/theme/css/popup-view.css">
    <link rel="stylesheet" href="~/theme/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/theme/css/message.css" />
    <!--nav styles-->
    <link rel="stylesheet" href="~/theme/css/menu.css">
    <!--Plugins-->
    <link rel="stylesheet" href="~/theme/plugins/animation/css/animate.css">
    <link rel="stylesheet" href="~/theme/plugins/owl-carousel/owl.custom.css">
    <link rel="stylesheet" href="~/theme/plugins/owl-carousel/owl.carousel.min.css">
    <link rel="stylesheet" href="~/theme/plugins/owl-carousel/owl.theme.default.min.css">
    <!--MVC additions on top of the theme-->
    <link rel="stylesheet" href="~/theme/css/custom-mvc.css">
    <!--Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    @RenderSection("styles", required: false)
    <style>
        .page-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(255, 255, 255, 0.85); z-index: 1055; display: none; align-items: center; justify-content: center; }
        .page-overlay.show { display: flex; }
        .logo .logo-txt { display: inline-block; font-size: 1.5em; font-weight: 800; line-height: 1.2; color: #176a3a; }
    </style>
    <!-- jQuery stays in the head: many views run inline scripts -->
    <script src="~/theme/js/jquery.min.js"></script>
    <script>
        // views that still carry Bootstrap 5 markup: map data-bs-* onto the Bootstrap 3 theme
        (function ($) {
            function mapBs5(root) {
                $(root || document).find('[data-bs-toggle],[data-bs-target],[data-bs-dismiss]').each(function () {
                    var $el = $(this);
                    $.each(['toggle', 'target', 'dismiss'], function (i, k) {
                        var v = $el.attr('data-bs-' + k);
                        if (v && !$el.attr('data-' + k)) { $el.attr('data-' + k, v); }
                    });
                });
            }
            $(function () { mapBs5(); });
            $(document).ajaxComplete(function () { mapBs5(); });

            function ModalShim(el) {
                return {
                    show: function () { $(el).modal('show'); },
                    hide: function () { $(el).modal('hide'); },
                    toggle: function () { $(el).modal('toggle'); }
                };
            }
            ModalShim.getInstance = ModalShim;
            ModalShim.getOrCreateInstance = ModalShim;
            window.bootstrap = window.bootstrap || { Modal: ModalShim };
        })(jQuery);
    </script>
</head>
<body>
