                    <nav class="social-media">
                        <ul>
                            @if (!string.IsNullOrEmpty(facebookUrl))
                            {
                                <li><a href="@facebookUrl" target="_blank" rel="noopener"><i class="fa fa-facebook fa-lg">&nbsp;</i></a></li>
                            }
                            @if (!string.IsNullOrEmpty(instagramUrl))
                            {
