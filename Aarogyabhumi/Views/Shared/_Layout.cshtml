    <section class="contents">
        @RenderBody()
    </section>

    <footer>
        <div class="ftr-row-top"></div>
        <div class="ftr-row-middle">
            <div class="container">
                <a href="~/Home/Index" class="logo">@logoHtml</a>
                @if (!string.IsNullOrEmpty(aboutUs))
                {
                    <p>@aboutUs</p>
                }
                @if (hasSocial)
                {
