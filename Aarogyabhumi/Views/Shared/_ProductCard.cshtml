@model Shopinv.Entity.E_Product
@*
    Mirrors the demo's product card markup exactly (demo/product-list.asp).
    The .item-btn row is present but hidden by layout.css, same as the demo -
    adding to the cart happens on the product detail page.
*@
@{
    var discount = 0;
    if (Model.MRP > 0 && Model.MRP > Model.Price)
    {
        discount = Convert.ToInt32(Math.Round(((Model.MRP - Model.Price) * 100) / Model.MRP));
    }
    var detailUrl = Url.Content("~/ProductDetail/ProductDetail?ProdId=" + Model.ProdId);
}
<div class="item">
    <div class="item-container" data-prodid="@Model.ProdId">
        <a class="item_wshlst"><span class="icon-wshlst"></span><span class="txt-wshlst">Wishlist</span></a>
        <div class="item-pic-container">
            <a href="@detailUrl" class="item-back"></a>
            <div class="item-pic">
                <img src="@Model.ImagePath" onerror="this.onerror=null;this.src='@Url.Content("~/theme/img/sample-product.jpg")';" alt="@Model.ProductName" />
            </div>
        </div>
        <p class="item-name"><a href="@detailUrl" class="item-lnk">@Model.ProductName</a></p>
        <p class="item-price">
            <span class="price-before">&#8377;@Model.MRP</span>
            <span class="price-now">&#8377;@Model.Price</span>
            @if (discount > 0)
            {
                <span class="discount">@discount% Off</span>
            }
            <span class="sv">BV : @Model.BV.ToString("0.##")</span>
        </p>
        <div class="item-btn"><a href="@detailUrl" class="item_add"><span>Add to cart</span></a></div>
    </div>
</div>
