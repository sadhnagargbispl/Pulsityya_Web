<div class="content-row">
    <div class="container">
        <div class="cart-row">
            <div class="row">
                <div class="col-sm-7 col-md-8">
                    <div class="container-address">
                        <h5><i class="fa fa-credit-card"></i>&nbsp; Select Payment Method</h5>
                        <div class="row">
                            <!-- LEFT SIDE NAV -->
                            <div class="col-sm-5">
                                <div class="pay-methods" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                                    <button class="pay-method active" id="v-pills-my-address-tab" data-pane="#v-pills-my-address" type="button">
                                        <i class="fa fa-google-wallet"></i> Shopping Wallet
                                    </button>
                                    <!-- Only Offline Active -->
                                    <button class="pay-method" id="v-pills-my-offlineorder-tab" data-pane="#v-pills-my-offlineorder" type="button" style="display:none;">
                                        <i class="fa fa-qrcode"></i> Payment Gateway
                                    </button>
                                </div>
                            </div>

                            <!-- RIGHT SIDE CONTENT -->
                            <div class="col-sm-7">
                                <div class="tab-content" id="v-pills-tabContent">
                                    <div class="tab-pane fade in active pay-pane" id="v-pills-my-address" role="tabpanel" aria-labelledby="v-pills-my-address-tab">
                                        <div class="dlvry-note">
                                            <strong>Shopping Wallet Fund</strong>
                                            <b id="spnShoppingFund">Rs. 0.00/-</b>
                                        </div>
                                        <div class="form-group">
                                            <label>Total Amount</label>
                                            <input readonly type="text" name="" id="Amount" class="form-control" placeholder="Enter Amount Here..." aria-describedby="helpId" value="@Session["totalamount"]">
                                        </div>
                                        <button type="button" onclick="SaveProceed()" class="btn btn-sub btn-order" id="walletpaybtn">Pay</button>
                                    </div>

                                    <!-- OFFLINE PAYMENT ACTIVE -->
                                    <div class="tab-pane fade pay-pane" id="v-pills-my-offlineorder" role="tabpanel" aria-labelledby="v-pills-my-offlineorder-tab">
                                        <div class="form-group">
                                            <label>Total Amount</label>
                                            <input type="text" readonly value="@totalnetpay" id="pgamount" name="pgamount" class="form-control">
                                        </div>
                                        <button id="pgpayBtn" type="button" class="btn btn-sub btn-order" onclick="CashfreeInitiate()">
                                            <i class="fa fa-paper-plane"></i>&nbsp; Submit Payment
                                        </button>
                                    </div>
                                    <!-- END OFFLINE -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-5 col-md-4">
                    <div class="price-lst-smry">
                        <h5>Payment Summary</h5>
                        <ul>
                            <li><span class="lft">Order Amount</span><span class="rght">&#8377;@String.Format("{0:N2}", totalamount)</span></li>
                            <li><span class="lft">Shipping Fee (+)</span><span class="rght">&#8377;@String.Format("{0:N2}", CourierCharge)</span></li>
                            <li class="ftr"><span class="lft">Net Payable </span><span class="rght">&#8377;@String.Format("{0:N2}", totalnetpay)</span></li>
                        </ul>
                        <ul class="smry-nte">
                            <li>The wallet Pay button is shown only when your balance covers the net payable amount.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
