                                                    </div>
                                                </td>
                                                <td class="text-center">@item.qty</td>
                                                <td class="text-end">₹@String.Format("{0:N2}", item.Price * item.qty)</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-4">Your cart is empty.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Convert.ToString(Session["MemMode"]) == "D" && Convert.ToInt32(Session["KitId"]) != 1)
                        {
                            <div class="d-flex justify-content-between text-success mb-2">
                                <select id="Kitbilltype" class="form-select">
                                    @if (Convert.ToInt32(Session["KitId"]) == 2)
                                    {
                                        <option value="A">Topup</option>
                                        <option value="T">Upgrade</option>
                                        <option value="R">Repuchase</option>
                                    }
                                    else if (Convert.ToInt32(Session["KitId"]) == 3)
                                    {
                                        <option value="T">Upgrade</option>
                                        <option value="R">Repuchase</option>
                                    }
                                    else
                                    {
                                        <option value="R">Repuchase</option>
                                    }
                                </select>
                            </div>
                        }
                        <input id="memmode" type="hidden" value="@Convert.ToString(Session["MemMode"])" />
                        <input id="kitid" type="hidden" value="@Convert.ToInt32(Session["KitId"])" />
                        <!-- Totals -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span class="fw-bold">₹@String.Format("{0:N2}", TotPrice)</span>
                        </div>

                        @if (Convert.ToString(Session["MemMode"]) == "D")
                        {
                            <div class="d-flex justify-content-between text-success mb-2">
                                <span>Total SV</span>
                                <span>@Totbv</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping Charge</span>
                            <span id="shippingCharge">₹@CourierCharge</span>
                        </div>
                        @*<div class="d-flex justify-content-between fw-bold h5 mt-3">
                                <span>Grand Total</span>
                                <span class="text-success">₹@String.Format("{0:N2}", ToTpayAmount)</span>
                            </div>*@
                        @*<div class="d-flex justify-content-between text-success mb-2">
                                <span>Coupon Applied</span>
                                <span>- ₹@HttpContext.Current.Session["couponamount"]</span>
                            </div>*@
                        <div class="d-flex justify-content-between fw-bold h6">
                            <span>Net Amount</span>
                            <span class="text-success" id="netAmount">₹@ToTpayAmount</span>
                        </div>

                        <hr>
                        <p class="text-muted small mb-3">
                            <i class="fa fa-info-circle me-1 text-secondary"></i> Free Delivery on Order above Rs. 4999/-.
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="fa fa-info-circle me-1 text-secondary"></i> Tax included. Shipping calculated at checkout.
                        </p>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="terms" name="terms" required="">
                            <label class="form-check-label" for="terms" id="dtc">
                                I agree to the <a href="javascript:void()" data-bs-toggle="modal" data-bs-target="#exampleModal">Terms &amp; Conditions</a>
                            </label>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="ReturnShipping" name="ReturnShipping" required="">
                            <label class="form-check-label" for="ReturnShipping" id="rsc">
                                <a href="/Home/ReturnPolicy" target="_blank">
                                    Agree with Return
                                </a>  & <a href="/Home/ShippingPolicy" target="_blank">
                                    Shipping Policy
                                </a>
                                @*<a href="https://d9cpanel.bisplindia.in/">(Visit Website)</a>*@
                            </label>
                        </div>
                        <a href="javascript:void(0);" onclick="SaveOtherAddressDetail(this, 'SaveUserShippingDetail')" class="btn btn-dark w-100 mb-2">
                            <i class="fa fa-credit-card me-2"></i> Proceed To Pay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-lg fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-body">
                <p>Declaration of Voluntary Purchase</p>
                <p>I hereby declare that I am purchasing the product(s) of my own free will and with my full consent. I confirm that I am completely satisfied with the product information provided and have made this purchase happily and without any pressure, coercion, or undue influence from any person.</p>
                <p>I further declare that I have personally read, understood, and verified all details, terms, conditions, and specifications of the product(s) from the official website before making this purchase.</p>
                <p>I fully agree and accept that the purchase is voluntary and based on my independent decision.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function copyShipping() {
        const checkbox = document.getElementById('sameAsShipping');

        const sAddr = document.getElementById('otherdetailUser_Address');
        const sCity = document.getElementById('otherdetailUser_City');
        const sPin = document.getElementById('otherdetailUser_PinCode');
        const sState = document.getElementById('otherdetailUser_StateCode');

        const bAddr = document.getElementById('billingAddress');
        const bCity = document.getElementById('billingCity');
        const bPin = document.getElementById('billingPincode');
        const bState = document.getElementById('otherdetailUser_BillingStateCode');

        if (checkbox.checked) {
            // Copy values when checked
            bAddr.value = sAddr.value;
            bCity.value = sCity.value;
            bPin.value = sPin.value;
            bState.value = sState.value;
        } else {
            // Clear values when unchecked
            bAddr.value = '';
            bCity.value = '';
            bPin.value = '';
            bState.value = '';
        }
    }
</script>
