    function Checkmobileno() {
        var mobl = $("#otherdetailUser_MobileNo").val();
        if (mobl.length != 10) {
            alert("please insert correct mobile no.");
            $("#otherdetailUser_MobileNo").val("");
            return false;
        }
    }
    function Checkpincode() {
        var mobl = $("#otherdetailUser_PinCode").val();
        if (mobl.length != 6) {
            alert("please insert correct pincode");
            $("#otherdetailUser_PinCode").val("");
            return false;
        }
    }


    function validateEmail() {
        debugger;
        var email = $("#otherdetailUser_Email").val();
        var expr = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        if (expr.test(email)) {
            return true;
        } else {
            alert("Please insert a valid email !");
            $("#otherdetailUser_Email").val("");
            return false;
        }
    }
