    //decimal TotPrice = 0;
    //decimal Totbv = 0;
    var TotPrice1 = "";
    var Totbv1 = "";
    decimal TotalBunchQtyAmount = 0;
    decimal TotalAmount = 0;
    int Totalbunchbv = 0;
    int TotalBV = 0;
    var GstWithOutPrice = 0;
    var GstAmt = 0;

}
