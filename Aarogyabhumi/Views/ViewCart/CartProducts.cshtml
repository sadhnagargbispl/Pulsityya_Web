    function UpdateProdQty(obj, prodid) {
        debugger;
        //var qty = $(obj).parent().prev().find('input[name="qty"]').val();
        var Qty1 = $("#qtyText_" + prodid).val();
        if (Qty1 >= 1) {
            if (Qty1 == "") {
                alert("Please Enter the Quantity!");
                return false;
            }
            if (Qty1 == "0") {
                alert("Quantity should be grater than 0!");
                return false;
            }
            Qty1 = parseInt(Qty1) + 1;
            $("#qtyText_" + prodid).val(Qty1);
            $.ajax({
                type: "POST",
                url: '/ViewCart/UpadteCartdetail',
                datatype: "html",
                data: { ProdId: prodid, Quantity: Qty1 },
                success: function (data) {
                    if (data.msg == "S") {
                        alert("cart Deatails Updated!");
                    }
                    $("#cartProducts").html('').html(data.tblOrder);
                    
                }

            });
        }
        else {
            $("#qtyText_" + prodid).val('1');
        }
    }
    function UpdateProdQtyMinus(obj, prodid) {
        debugger;
        //var qty = $(obj).parent().prev().find('input[name="qty"]').val();
        var Qty1 = $("#qtyText_" + prodid).val();
        Qty1 = parseInt(Qty1) - 1;
        if (Qty1 >= 1) {
            if (Qty1 == "") {
                alert("Please Enter the Quantity!");
                return false;
            }
            if (Qty1 == "0") {
                alert("Quantity should be grater than 0!");
                return false;
            }

            $("#qtyText_" + prodid).val(Qty1);
            $.ajax({
                type: "POST",
                url: '/ViewCart/UpadteCartdetail',
                datatype: "html",
                data: { ProdId: prodid, Quantity: Qty1 },
                success: function (data) {
                    if (data.msg == "S") {
                        alert("cart Deatails Updated!");
                    }
                    $("#cartProducts").html('').html(data.tblOrder);
                    
                }

            });
        }
        else {
            $("#qtyText_" + prodid).val('1');
        }
    }


    function GetCouponInfo(CouponNo, TotalAmount, totalbv) {

        debugger;
        $.ajax({
            url: '@Url.Action("GetCouponInfo", "ViewCart")',
            type: 'POST',
            data: { "CouponNo": CouponNo ,"TotalAmount": TotalAmount,"TotalBV": totalbv},
            dataType: "json",
            success: function (objResult) {

                if (objResult != null) {
                    $("#CouponAmount").text(objResult.amount);

                    var netamount;
                    if (TotalAmount >= objResult.amount)
                        {
                        netamount= TotalAmount - (objResult.amount);
                    }
                    else
                    {
                        netamount = 0;
                    }

                    $("#paidamount").text(netamount);
                    debugger;
                    if (objResult.SuccessMsg != '') {
                        $("#successmsg").text(objResult.SuccessMsg);
                        $("#successmsg").removeAttr("style");
                        $("#paidbv").text(objResult.remainbv);
                        document.getElementById("failedmsg").style.display = "none";


                    }
                    else if (objResult.FailedMsg != '') {
                        alert(objResult.FailedMsg);
                        $("#failedmsg").text(objResult.FailedMsg);
                        $("#failedmsg").removeAttr("style");
                        document.getElementById("successmsg").style.display = "none";
                        //$("#successmsg").setAttribute('style', 'display:none');
                        //$("#paidbv").text(0);
                    }
                    else {
                        document.getElementById("failedmsg").style.display = "none";
                        document.getElementById("successmsg").style.display = "none";
}
                }



            },
            error: function (xhr, data) {
                //  return false;
                console.log(xhr);
                console.log("Error:", data);
            }
        });

    }
    $("#CouponApplied").click(function (e) {

        var Value = $("#TxtCoupon").val();
        var netamount = $("#netamount").text();
        var totalbv = $("#totalbv").text();
        if (Value != "")
            GetCouponInfo(Value, netamount, totalbv);
        //  }
    });

</script>


<!-- Features Area -->
<div class="products-details-area bg-white ">
    <div class="container my-4">
        <div class="shop-details-content pl-0">
            <div class="card shadow-lg border-0 rounded-3 p-2">
                <div class="row g-0">
                    <div class="col-12 p-3">
                        <h5 class="fw-bold mb-3">My Shopping Cart</h5>
                        <p class="text-muted">You have @cartCount items in your cart</p>

                        <div class="table-responsive">
                            <table class="table table-bordered shadow-sm align-middle mb-0" id="cartTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Details</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CartDetail != null && Model.CartDetail.Any())
                                    {
                                        foreach (var data in Model.CartDetail)
                                        {
                                            <tr data-price="@data.Price" data-bv="@data.bv">
                                                <td>
                                                    <a href="~/ProductDetail/ProductDetail?ProdID=@data.ProdId">
                                                        <img src="@data.imagePath"
                                                             onerror="this.src='https://genesisemart.com/img/noimage.png';"
                                                             alt="@data.ProdName"
                                                             class="img-fluid rounded"
                                                             style="max-width: 90px;">
                                                    </a>
                                                </td>
                                                <td>
                                                    <h6 class="fw-bold mb-1">@data.ProdName</h6>
                                                    <p class="mb-0">
                                                        <span class="badge bg-success">In Stock</span>
                                                        <span class="text-muted">| Product ID: @data.ProdId</span>
                                                    </p>
                                                </td>
                                                <td>
                                                    <span class="h6 text-success fw-bold">
                                                        ₹@String.Format("{0:N2}", data.Price)
                                                    </span><br>
                                                    @if (Convert.ToString(Session["MemMode"]) == "D")
                                                    {
                                                        <span class="text-primary small">SV: @data.bv</span>
                                                    }

                                                </td>
                                                <td class="text-center">
                                                    <div class="input-group input-group-sm mx-auto" style="max-width: 100px;">
                                                        <button class="btn btn-outline-secondary btn-minus"
                                                                type="button"
                                                                onclick="UpdateProdQtyMinus(this,@data.ProdId,@data.Price);">
                                                            -
                                                        </button>
                                                        <input type="number"
                                                               class="form-control text-center quantity"
                                                               id="qtyText_@data.ProdId"
                                                               value="@data.qty"
                                                               min="1"
                                                               readonly>
                                                        <button class="btn btn-outline-secondary btn-plus"
                                                                type="button"
                                                                onclick="UpdateProdQty(this,@data.ProdId,@data.Price);">
                                                            +
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="item-total fw-bold text-success">
                                                    ₹@String.Format("{0:N2}", data.Price * data.qty)
                                                </td>
                                                <td>
                                                    <button class="btn btn-danger btn-sm btn-remove"
                                                            onclick="DeleteRow(this,'@data.id','@data.ProdId','@data.imagePath','@data.qty','@data.Price','@data.bv','@data.IpAddress')">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="fa fa-shopping-cart fa-2x mb-2"></i><br />
                                                Your cart is empty.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <!-- LEFT: Special Instructions -->
                    @*<div class="col-md-6" style="visibility">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100">
                                <h5 class="fw-bold mb-3">Special Instructions for Seller</h5>
                                <textarea id="specialInstructions"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Special instructions for seller"></textarea>
                            </div>
                        </div>*@
                    <div class="col-md-6">
                    </div>
                    <!-- RIGHT: Order Summary -->
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 rounded-3 p-3 h-100">
                            <h5 class="fw-bold mb-3">Order Summary</h5>

                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span class="fw-bold" id="subtotal">₹@String.Format("{0:N2}", TotPrice)</span>
                            </div>

                            @if (Convert.ToString(Session["MemMode"]) == "D")
                            {
                                <div class="d-flex justify-content-between text-success mb-2">
                                    <span>Total SV</span>
                                    <span id="totalbv">@Totbv</span>
                                </div>
                            }
                            @*<div class="d-flex justify-content-between mb-2">
                                <span>Shipping Charge</span>
                                <span class="fw-bold" id="subtotal">₹@String.Format("{0:N2}", CourierCharge)</span>
                            </div>*@
                            <div class="d-flex justify-content-between fw-bold h5 mt-3">
                                <span>Grand Total</span>
                                <span class="text-success" id="grandTotal">₹@String.Format("{0:N2}", TotPrice)</span>
                            </div>

                            <hr>

                            <p class="text-muted small mb-3">
                                <i class="fa fa-info-circle me-1 text-secondary"></i>
                                Tax included. Shipping calculated at checkout.
                            </p>

                            <a href="javascript:void(0);"
                               onclick="prceedCheckOut(this,@Totbv,0);"
                               class="btn btn-dark w-100 mb-2">
                                <i class="fa fa-credit-card me-2"></i> Proceed to Checkout
                            </a>
                            <a href="~/Home/Index" class="btn btn-outline-danger w-100">
                                <i class="fa fa-shopping-cart me-2"></i> Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function updateCart() {
                    let subtotal = 0;
                    document.querySelectorAll("#cartTable tbody tr").forEach(row => {
                        let price = parseFloat(row.dataset.price);
                        let qty = parseInt(row.querySelector(".quantity").value) || 1;
                        let total = price * qty;
                        subtotal += total;
                        row.querySelector(".item-total").innerText = "₹" + total.toLocaleString("en-IN");
                    });

                    document.getElementById("subtotal").innerText = "₹" + subtotal.toLocaleString("en-IN");
                    document.getElementById("grandTotal").innerText = "₹" + subtotal.toLocaleString("en-IN");
                }

                //document.querySelectorAll(".btn-plus").forEach(btn => {
                //    btn.addEventListener("click", e => {
                //        let input = e.target.closest(".input-group").querySelector(".quantity");
                //        input.value = parseInt(input.value) + 1;
                //        updateCart();
                //    });
                //});

                //document.querySelectorAll(".btn-minus").forEach(btn => {
                //    btn.addEventListener("click", e => {
                //        let input = e.target.closest(".input-group").querySelector(".quantity");
                //        input.value = Math.max(1, parseInt(input.value) - 1);
                //        updateCart();
                //    });
                //});

                document.querySelectorAll(".btn-remove").forEach(btn => {
                    btn.addEventListener("click", e => {
                        e.target.closest("tr").remove();
                        updateCart();
                    });
                });

                updateCart();
            </script>
        </div>
    </div>
</div>


