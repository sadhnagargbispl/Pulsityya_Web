    var totPV = Model.CartDetail.Sum(s => (s.PV * s.qty));
    var totWeight = Model.CartDetail.Sum(s => (s.PV * s.Weight));
    var cartCount = Model.CartDetail != null ? Model.CartDetail.Count() : 0;
    var CourierCharge = Convert.ToDecimal(Session["CourierCharge"]);
    var ToTpayAmount = TotPrice + CourierCharge;
    //decimal TotPrice = 0;
    //decimal Totbv = 0;
    var TotPrice1 = "";
    var Totbv1 = "";
    decimal TotalBunchQtyAmount = 0;
    decimal TotalAmount = 0;
    int Totalbunchbv = 0;
    int TotalBV = 0;
    var GstWithOutPrice = 0;
    var GstAmt = 0;

    var isDistributor = Convert.ToString(Session["MemMode"]) == "D";
