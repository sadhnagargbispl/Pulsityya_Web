@model Shopinv.Models.M_Category

@if (Model.ProductReview != null && Model.ProductReview.Count() > 0)
{
    foreach (var item in Model.ProductReview)
    {
        <div class="review-item border-bottom pb-3 mb-3">
            <p class="mb-1"><strong>@item.username</strong> <span class="text-muted">- @item.Rating Stars</span></p>
            <p>"@item.Review"</p>
        </div>
    }

}
