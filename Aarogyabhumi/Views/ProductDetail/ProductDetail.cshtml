@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "ProductDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Refid = "";
    if (Session["RefId"] != null)
    {
        Refid = Session["RefId"].ToString();
    }
    else
    {
        Refid = null;
    }

    // the page shows one product (the live view looped, but only the first row's inputs were ever used)
    var product = Model.ProductDetail != null ? Model.ProductDetail.FirstOrDefault() : null;
    if (product != null && !string.IsNullOrWhiteSpace(product.ProductName))
    {
        ViewBag.Title = product.ProductName;
    }
    else
    {
        ViewBag.Title = "Product Details";
    }

    var discount = 0;
    var inStock = false;
    var maxQty = "1";
    if (product != null)
    {
        if (product.MRP > 0 && product.MRP > product.Price)
        {
            discount = Convert.ToInt32(Math.Round(((product.MRP - product.Price) * 100) / product.MRP));
        }
        inStock = product.StockQTY != 0;
        maxQty = decimal.Floor(product.StockQTY).ToString("0");
    }
}

<div class="breadcrmb plain">
    <div class="breadcrmb-content">
        <div class="container">
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/")">Home</a></li>
                <li><a href="@Url.Content("~/CategoryList/CategoryList")">Products</a></li>
                @if (product != null && !string.IsNullOrWhiteSpace(product.CatName))
                {
                    <li><a href="@Url.Action("CategoryList", "CategoryList", new { CatName = product.CatName })">@product.CatName</a></li>
                }
                <li><a class="active">@(product != null ? product.ProductName : "Product Details")</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="content-row">
    <div class="itm-dtls-row">
        <div class="item-container">
            <div class="container">
                @if (product != null)
                {
                    <input type="hidden" id="hdnprodname" value="@product.ProductName" />
                    <input type="hidden" id="hdnimage" value="@product.ImagePath" />
                    <input type="hidden" id="hdnBunchQty" value="@product.BunchQty" />
                    <input type="hidden" id="hdnprice" value="@product.Price" />
                    <input type="hidden" id="hdnBv" value="@product.BV" />
                    <input type="hidden" id="hdnPv" value="@product.PV" />
                    <input type="hidden" id="hdnprodCode" value="@product.ProdId" />
                    <input type="hidden" id="hdnWeight" value="@product.Weight" />
                    <input type="hidden" id="hdnGst" value="@product.Gst" />
                    <input type="hidden" id="hdnpcode" value="@product.ProdId" />
                    <input type="hidden" id="hdnstockqty" value="@product.StockQTY" />
                    <input type="hidden" id="memmode" value="@Convert.ToString(Session["MemMode"])" />
                    <input type="hidden" id="kycstatus" value="@ViewBag.kycstatus" />

                    <div class="row">
                        <div class="col-xs-12 col-sm-5">
                            @* gallery markup lives in _Imagedetail (also re-rendered by GetImageBycolor) *@
                            <div id="prdarea">
                                @Html.Partial("_Imagedetail", Model)
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7">
                            <h2 class="pr_name">@product.ProductName <span class="pr_sku">Product Code : @product.ProdId</span></h2>
                            <h3 class="pr_rate">
                                @if (product.MRP > product.Price)
                                {
                                    <span class="pr_mrp">&#x20b9; @product.MRP</span>
                                }
                                <span class="pr_offerprice">&#x20b9; @product.Price</span>
                                @if (discount > 0)
                                {
                                    <span class="pr_discount">@discount% Off</span>
                                }
                                <span class="pr_note">Inclusive of all taxes</span>
                            </h3>
                            <p class="pr_points">
                                <span>BV : @product.BV.ToString("0.##")</span>
                                @if (product.MRP > product.Price)
                                {
                                    <span class="save">You save &#x20b9; @(product.MRP - product.Price)</span>
                                }
                            </p>
                            <p class="pr_stock">
                                <strong>Availability :</strong>
                                @if (inStock)
                                {
                                    <span>In Stock</span>
                                }
                                else
                                {
                                    <span class="out">Out Of Stock</span>
                                }
                            </p>

                            <div class="row">
                                @if (inStock)
                                {
                                    <div class="col-xs-3 col-md-3 col-lg-2 no-padding-right">
                                        <div class="num-incr-decr">
                                            <span class="decrMent" dt-min="1"></span>
                                            <input step="1" value="1" min="1" type="text" name="quantity" id="Qty" readonly>
                                            <span class="incrMent" dt-max="@maxQty"></span>
                                        </div>
                                    </div>
                                    <div class="col-xs-6 col-md-4 col-lg-4">
                                        <div class="cart-btn-col">
                                            <a href="javascript:CheckLoginPopUp('DetailBuy');" class="btn-sub pr_add_cart"><span class="icon-add-cart"></span><span class="txt-add-cart">Add to cart</span></a>
                                        </div>
                                    </div>
                                }
                                <div class="@(inStock ? "col-xs-3 col-md-3 col-lg-2 no-padding-left" : "col-xs-6 col-md-4 col-lg-3")">
                                    <a class="pr-shre" href="javascript:void(0)" data-title="@product.ProductName" onclick="shareItem(this.getAttribute('data-title'), window.location.href)"><i class="fa fa-share-alt"></i> Share</a>
                                </div>
                            </div>

                            <div class="pr_desc">
                                @if (!string.IsNullOrWhiteSpace(product.ProductDesc))
                                {
                                    <h1>Product Description</h1>
                                    <div>
                                        <div class="desc-inf">
                                            @Html.Raw(product.ProductDesc)
                                        </div>
                                    </div>
                                }
                                <h1>Reviews</h1>
                                <div>
                                    <div class="desc-inf">
                                        <div id="reviewdiv">
                                            @Html.Partial("ProductReview_partial", Model)
                                        </div>
                                        <form class="review-form" onsubmit="SaveReview(); return false;">
                                            <h4 class="desc-title">Write a Review</h4>
                                            <div class="row">
                                                <div class="col-xs-12 col-sm-6">
                                                    <div class="form-group">
                                                        <label for="reviewName">Name</label>
                                                        <input type="text" class="form-control" id="reviewName" placeholder="Enter your name">
                                                    </div>
                                                </div>
                                                <div class="col-xs-12 col-sm-6">
                                                    <div class="form-group">
                                                        <label for="reviewRating">Rating</label>
                                                        <select class="form-control" id="reviewRating">
                                                            <option value="5">5 Stars</option>
                                                            <option value="4">4 Stars</option>
                                                            <option value="3">3 Stars</option>
                                                            <option value="2">2 Stars</option>
                                                            <option value="1">1 Star</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="reviewMessage">Review</label>
                                                <textarea class="form-control" id="reviewMessage" rows="3" placeholder="Write your review here"></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-sub">Submit Review</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-product">
                        <p>Product not found<span>It may have been removed or is no longer available.</span></p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.RelatedProduct != null && Model.RelatedProduct.Any())
{
    <div class="pr-related-row">
        <div class="container">
            <h2 class="first-head">Related Products</h2>
            <div class="product-carousel owl-carousel">
                @foreach (var itm in Model.RelatedProduct)
                {
                    @Html.Partial("_ProductCard", itm)
                }
            </div>
        </div>
    </div>
}

@section styles {
    <link rel="stylesheet" href="~/theme/plugins/accordion/css/woco-accordion.min.css">
    <link rel="stylesheet" href="~/theme/plugins/spotlight-master/css/spotlight.min.css">
    <style>
        /* gallery thumbnails (click = jump to slide) */
        .itm-dtls-row .pr-thumbs {
            list-style: none;
            margin: 12px 0 0 !important;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
        }
        .itm-dtls-row .pr-thumbs li {
            width: 64px;
            height: 64px;
            margin: 0 8px 8px 0 !important;
            border: 2px solid #f2f2f2;
            border-radius: 6px;
            overflow: hidden;
            background: #fff;
        }
        .itm-dtls-row .pr-thumbs li.active {
            border-color: #176a3a;
        }
        .itm-dtls-row .pr-thumbs li a {
            display: block;
            width: 100%;
            height: 100%;
        }
        .itm-dtls-row .pr-thumbs img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        /* BV / saving pills under the price */
        .itm-dtls-row .pr_points {
            margin-bottom: 12px !important;
        }
        .itm-dtls-row .pr_points span {
            display: inline-block;
            background: #f1f9e8;
            border: 1px solid #d6ecdd;
            color: #176a3a;
            border-radius: 3px;
            padding: 2px 8px;
            margin: 0 6px 6px 0;
            font-size: 13px;
            font-weight: 600;
        }
        .itm-dtls-row .pr_points span.save {
            background: #fff4e3;
            border-color: #f7d9a8;
            color: #b86b00;
        }
        /* CMS description: layout.css strips all margins, give the copy some rhythm back */
        .itm-dtls-row .pr_desc .desc-inf {
            padding-bottom: 15px;
            line-height: 22px;
        }
        .itm-dtls-row .pr_desc .desc-inf p {
            margin-bottom: 10px !important;
        }
        .itm-dtls-row .pr_desc .desc-inf h2,
        .itm-dtls-row .pr_desc .desc-inf h3,
        .itm-dtls-row .pr_desc .desc-inf h4,
        .itm-dtls-row .pr_desc .desc-inf h5,
        .itm-dtls-row .pr_desc .desc-inf h6 {
            font-size: 1.05em;
            font-weight: 700;
            margin: 14px 0 6px !important;
        }
        /* reviews */
        .itm-dtls-row .no-review {
            color: #999;
        }
        .itm-dtls-row .review-form {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #eef3f0;
        }
        .itm-dtls-row .review-form label {
            font-weight: 600;
        }
    </style>
}

@section scripts {
    <script src="~/theme/plugins/accordion/js/woco.accordion.min.js"></script>
    <script src="~/theme/plugins/spotlight-master/js/spotlight.min.js"></script>
    <script type="text/javascript">
        // ---------------- product gallery ----------------
        // Same options layout.js uses for .itm-dtls-carousel, but with loop:false: layout.js
        // decides "loop" by counting every .item on the page (the related-product cards), and
        // looping makes owl clone the slides, which then show up as duplicates in the spotlight
        // zoom gallery. Initialising here (before layout.js runs) makes layout.js's call a no-op
        // for this element. Also re-used after Imagebycolorid() swaps the gallery.
        function initDetailGallery() {
            var $gal = $('#prdarea .itm-dtls-carousel');
            if (!$gal.length || $gal.data('owl.carousel')) {
                return;
            }
            $gal.owlCarousel({
                margin: 15,
                stagePadding: 0,
                loop: false,
                autoplay: false,
                autoplaySpeed: 1000,
                autoplayTimeout: 3000,
                dots: false,
                nav: true,
                responsive: {
                    320: { items: 1 }
                }
            });
        }

        // thumbnail -> slide
        $(document).on('click', '#prdarea .pr-thumbs a', function (e) {
            e.preventDefault();
            $('#prdarea .itm-dtls-carousel').trigger('to.owl.carousel', [parseInt($(this).attr('data-index'), 10), 300]);
        });

        // slide -> active thumbnail
        $(document).on('changed.owl.carousel', '#prdarea .itm-dtls-carousel', function (e) {
            if (!e.property || e.property.name !== 'position') {
                return;
            }
            var pos = e.relatedTarget ? e.relatedTarget.relative(e.property.value) : e.property.value;
            $('#prdarea .pr-thumbs li').removeClass('active').eq(pos).addClass('active');
        });

        initDetailGallery();

        // ---------------- description / reviews accordion (demo) ----------------
        // woco-accordion treats every <h1> inside .pr_desc as a panel header, so demote any
        // <h1> that comes from the CMS product description first.
        $('.pr_desc .desc-inf h1').each(function () {
            $(this).replaceWith($('<h3/>').html($(this).html()));
        });
        $('.pr_desc').accordion();

        // ---------------- quantity ----------------
        // layout.js does the +/- (limited by dt-max = stock); keep the live "max stock" warning.
        $(document).on('click', '.itm-dtls-row .num-incr-decr .incrMent', function () {
            var stock = parseInt($('#hdnstockqty').val(), 10);
            var qty = parseInt($('#Qty').val(), 10);
            if (!isNaN(stock) && qty >= stock) {
                alert("Maximum available stock reached!");
            }
        });

        // ---------------- cart ----------------
        function CheckLoginPopUp(ProductAddFrom) {
            var ProductCode = $('#hdnprodCode').val();
            var Qty = $("#Qty").val();
            if (Qty == 0) {
                alert("Please enter quantity greater than 0!");
                return false;
            }
            var prodname = jQuery('#hdnprodname').val();
            var image = jQuery('#hdnimage').val();
            var price = jQuery('#hdnprice').val();
            var bv = jQuery('#hdnBv').val();
            var BunchQty = jQuery('#hdnBunchQty').val();
            var PV = jQuery('#hdnPv').val();
            var Weight = jQuery('#hdnWeight').val();
            var string = Math.floor(Math.random() * 1000) + Date.now();

            // Only SIZE logic remains
            var SIZE = "";
            //var SIZE = $("input[name='size']:checked").val();
            //if (SIZE == "" || SIZE == undefined || SIZE == null) {
            //    alert("Please select size!");
            //    return false;
            //}

            $.ajax({
                url: '/ProductDetail/CheckLogin',
                type: 'GET',
                async: false,
                data: {}
            }).done(function (result) {
                if (result == 'Yes') {
                    var memmode = $("#memmode").val();
                    var kycstatus = $("#kycstatus").val();
                    //if (memmode == "D" && kycstatus != "Verified") {
                    //    alert("Please update your KYC.");
                    //    return false;
                    //}
                    AddProductInCart(ProductCode, Qty, prodname, image, price, bv, string, ProductAddFrom, PV, Weight, SIZE);
                }
                else {
                    if ("@Refid" != null && "@Refid" != "") {
                        AddProductInCartOuter(ProductCode, Qty, prodname, image, price, bv, string, ProductAddFrom, PV, Weight);
                    }
                    else {
                        window.location.href = "/Account/Login";
                    }
                }
            }).fail(function (error) {
                alert(error.statusText);
                $(".preloader").hide();
            });
            return false;
        }

        function AddProductInCart(ProductCode, Quantity, prodname, image, price, bv, string, AddProductInCart, PV, Weight, SIZE) {
            $.ajax({
                type: "POST",
                url: '/ProductDetail/AddProductInToCart',
                async: false,
                dataType: "Json",
                data: { ProductCode: ProductCode, Qty: Quantity, ProdName: prodname, Image: image, Price: price, Bv: bv, UniqId: string, PV: PV, Weight: Weight, Color: "", SIZE: SIZE },
                success: function (data) {
                    if (data.save == 'S') {
                        alert("Item added in Your cart Sucessfully!");
                    }
                    window.location.href = "/ViewCart/ViewCart";
                }
            });
            return false;
        }

        // Referral (RefId) visitors: CheckLoginPopUp has always called this, but it was never
        // defined in JS. It posts to the existing ProductDetail/AddProductInCartOuter action;
        // ViewCart/ViewCart already redirects RefId visitors to ViewCart/CartProductsOuter.
        if (typeof window.AddProductInCartOuter !== 'function') {
            window.AddProductInCartOuter = function (ProductCode, Quantity, prodname, image, price, bv, string, ProductAddFrom, PV, Weight) {
                $.ajax({
                    type: "POST",
                    url: '/ProductDetail/AddProductInCartOuter',
                    async: false,
                    dataType: "Json",
                    data: { ProductCode: ProductCode, Qty: Quantity, ProdName: prodname, Image: image, Price: price, Bv: bv, UniqId: string, PV: PV, Weight: Weight, Color: "", SIZE: "" },
                    success: function (data) {
                        if (data.save == 'S') {
                            alert("Item added in Your cart Sucessfully!");
                        }
                        window.location.href = "/ViewCart/ViewCart";
                    }
                });
                return false;
            };
        }

        // colour-wise images (no colour picker is rendered at the moment; kept for when #colorselect is added)
        function Imagebycolorid() {
            var dd = $("#colorselect").val();
            var Colorname = $('#colorselect option:selected').text();
            $.ajax({
                type: "POST",
                url: '/ProductDetail/GetImageBycolor',
                async: false,
                dataType: "Json",
                data: { colorId: dd, Colorname: Colorname },
                success: function (data) {
                    $("#sizeopt").empty().append('<option selected="selected" value="">Select Size</option>');
                    $.each(data.e_SizeMasters, function () {
                        $("#sizeopt").append($("<option/>").val(this.id).text(this.Size));
                    });
                    if (data.count > 0) {
                        $("#hdnimage").val(data.firstimg);
                        $("#prdarea").html(data.tblOrder);
                        initDetailGallery();
                    }
                }
            });
        }

        // ---------------- reviews ----------------
        function SaveReview() {
            var reviewMessage = $("#reviewMessage").val();
            var reviewRating = $("#reviewRating").val();
            var reviewName = $("#reviewName").val();
            if (reviewName == "") {
                $("#reviewName").focus();
                return false;
            }
            if (reviewMessage == "") {
                $("#reviewMessage").focus();
                return false;
            }
            var hdnpcode = $("#hdnpcode").val();
            $.ajax({
                type: "GET",
                url: '/ProductDetail/CheckLogin',
                async: false,
                dataType: "Json",
                data: {},
                success: function (result) {
                    if (result == 'Yes') {
                        $.ajax({
                            type: "POST",
                            url: '/ProductDetail/SaveReview',
                            async: false,
                            dataType: "Json",
                            data: { ReviewMessage: reviewMessage, ReviewRating: reviewRating, ReviewName: reviewName, Productcode: hdnpcode },
                            success: function (data) {
                                if (data.status == "1") {
                                    $("#reviewdiv").html(data.tblOrder);
                                    $("#reviewMessage").val('')
                                }
                                alert(data.msg);
                            }
                        });
                    }
                    else {
                        window.location.href = "/Account/Login";
                    }
                }
            });
        }

        // ---------------- wishlist ----------------
        // (no button on this page - the demo detail page has none; product cards use theme/js/shop.js)
        function SaveToWishlist() {
            var hdnpcode = $("#hdnpcode").val();
            $.ajax({
                type: "GET",
                url: '/ProductDetail/CheckLogin',
                async: false,
                dataType: "Json",
                data: {},
                success: function (result) {
                    if (result == 'Yes') {
                        $.ajax({
                            type: "POST",
                            url: '/ProductDetail/SaveToWishlist',
                            async: false,
                            dataType: "Json",
                            data: { ProductID: hdnpcode },
                            success: function (data) {
                                if (data.status == "1") {
                                    $("#wislistbtn").html('<i class="fa fa-heart"></i> Remove from Wishlist');
                                }
                                else if (data.status == "2") {
                                    $("#wislistbtn").html('<i class="fa fa-heart-o"></i> Add to Wishlist');
                                }
                                alert(data.msg);
                            }
                        });
                    }
                    else {
                        window.location.href = "/Account/Login";
                    }
                }
            });
        }
    </script>
}
