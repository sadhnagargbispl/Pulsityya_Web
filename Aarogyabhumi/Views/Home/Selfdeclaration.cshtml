
@{
    ViewBag.Title = "Selfdeclaration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrmb">
    <img src="@Url.Content("~/theme/img/page-banner.jpg")" alt="Self Declaration">
    <div class="breadcrmb-content">
        <div class="container">
            <h1>Self Declaration</h1>
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/Home/Index")">Home</a></li>
                <li><a class="active">Self Declaration</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="content-row">
    <div class="container">
        <div class="txt-page">

            <h4 class="mb-3">Self Declaration</h4>
            <hr>

            <p><strong>SELF DECLARATION UNDER CLAUSE 5 (1) (C) OF CONSUMER PROTECTION (DIRECT SELLING) RULES, 2021</strong></p>

            <p>I, Mr. Mukund Bhausaheb Wakale, Nodal Officer of @Convert.ToString(Session["CompName"]) declare that @Convert.ToString(Session["CompTitle"]) is compliant with the following:</p>

            <ol>
                <li>@Convert.ToString(Session["CompTitle"]) is not involved in any pyramid scheme, as defined in clause 3(i)(i) of Consumer Protection (Direct Selling) Rules, 2021.</li>
                <li>@Convert.ToString(Session["CompTitle"]) is not involved in any money circulation scheme, as defined in clause 3(i)(f) of Consumer Protection (Direct Selling) Rules, 2021.</li>
                <li>@Convert.ToString(Session["CompTitle"]) is compliant with all the provisions of the Consumer Protection (Direct Selling) Rules, 2021, issued by Department of Consumer Affairs.</li>
            </ol>

            <p class="sign">For @Convert.ToString(Session["CompName"])</p>

            @*<p class="mt-3 mb-0"><strong>Mukund Bhausaheb Wakale</strong><br>Nodal Officer</p>*@

        </div>
    </div>
</div>
