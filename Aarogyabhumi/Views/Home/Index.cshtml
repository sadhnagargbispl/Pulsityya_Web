@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var compTitle = Convert.ToString(Session["CompTitle"]);
    var compName = Convert.ToString(Session["CompName"]);
    var compTagline = Convert.ToString(Session["CompTagline"]);
    var compAbout = Convert.ToString(Session["CompAboutUs"]);
    var aboutParas = string.IsNullOrWhiteSpace(compAbout)
        ? new string[0]
        : compAbout.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
}
<!-- slider -->
@{ Html.RenderAction("IndexBanner", "Home"); }

<!-- best sellers starts-->
@if (Model.SpecialProductList != null && Model.SpecialProductList.Count() > 0)
{
    <div class="product-row">
        <div class="container">
            <div class="row">
                <div class="col-xs-8"><h2 class="first-head">Our Best Selling Products <span class="brdr"></span></h2></div>
                <div class="col-xs-4"><a href="~/CategoryList/CategoryList" class="btn btn-more">View All</a></div>
            </div>
            <div class="product-carousel owl-carousel">
                @foreach (var item in Model.SpecialProductList)
                {
                    @Html.Partial("_ProductCard", item)
                }
            </div>
        </div>
    </div>
}

<!-- top sellers starts-->
@if (Model.TopSellerProduct != null && Model.TopSellerProduct.Count() > 0)
{
    <div class="product-row">
        <div class="container">
            <div class="row">
                <div class="col-xs-8"><h2 class="first-head">Top Sellers <span class="brdr"></span></h2></div>
                <div class="col-xs-4"><a href="~/CategoryList/CategoryList" class="btn btn-more">View All</a></div>
            </div>
            <div class="product-carousel owl-carousel">
                @foreach (var item in Model.TopSellerProduct)
                {
                    @Html.Partial("_ProductCard", item)
                }
            </div>
        </div>
    </div>
}

<!--quality starts-->
<div class="qlty-row">
    <div class="container">
        <h1 class="first-head">Premium Quality,<br>Made for you <span class="brdr"></span></h1>
        <p>Clean ingredients, Powerful results For a better you, inside and out</p>
        <a href="~/CategoryList/CategoryList" class="btn btn-more">Shop Collection</a>
    </div>
</div>

<!-- welcome -->
<div class="wlcme-row">
    <div class="container">
        <div class="row">
            <div class="col-sm-6 col-lg-5">
                <div class="img-col"><img src="~/theme/img/wlcme.jpg" alt="@compTitle"></div>
            </div>
            <div class="col-sm-6 col-lg-7">
                <h1 class="first-head">Welcome to @compTitle <span class="brdr"></span>@if (!string.IsNullOrEmpty(compTagline)) { <span>@compTagline</span> }</h1>
                @foreach (var para in aboutParas)
                {
                    <p>@para</p>
                }
                <p><a href="~/Home/About" class="btn btn-more">Learn more</a></p>
            </div>
        </div>
    </div>
</div>

<!-- advantage starts-->
<div class="adv-row">
    <div class="container">
        <div class="row">
            <div class="col-xs-6 col-sm-3">
                <div class="adv">
                    <div class="adv-icon"><img src="~/theme/img/icon-price.png" alt="Transparent Price" /></div>
                    <div class="adv-text">
                        <p><strong>Transparent Price</strong>No hidden cost, we offer transparent prices.</p>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-3">
                <div class="adv">
                    <div class="adv-icon"><img src="~/theme/img/icon-rewards.png" alt="Rewards &amp; Recognition" /></div>
                    <div class="adv-text">
                        <p><strong>Rewards &amp; Recognition</strong>Get rewarded and recognized for your hard work consistently.</p>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-3">
                <div class="adv">
                    <div class="adv-icon"><img src="~/theme/img/icon-payout.png" alt="Instant Payout" /></div>
                    <div class="adv-text">
                        <p><strong>Instant Payout</strong>Receive your earnings instantly with fast and secure payouts.</p>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-3">
                <div class="adv">
                    <div class="adv-icon"><img src="~/theme/img/icon-support.png" alt="24 X 7 Support" /></div>
                    <div class="adv-text">
                        <p><strong>24 X 7 Support</strong>Receive prompt assistance around the clock from our team.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- onload notice (shown once per session by the layout) -->
<div class="modal fade" id="onloadModal" tabindex="-1" role="dialog" aria-labelledby="onloadModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="onloadModalLabel">Welcome!</h4>
            </div>
            <div class="modal-body">
                <p><strong>@compName</strong> (“कंपनी”) यह स्पष्ट करती है कि कंपनी में भर्ती (Recruitment) की प्रक्रिया केवल कंपनी के प्रधान कार्यालय (Head Office) के माध्यम से संचालित की जाती है।</p>
                <p>कंपनी ने किसी भी व्यक्ति, एजेंट, प्रतिनिधि, फ्रेंचाइज़ी, कंसल्टेंट या किसी भी तृतीय पक्ष को भर्ती, नियुक्ति अथवा रोजगार के लिए अधिकृत नहीं किया है।</p>
                <p>कंपनी में किसी भी प्रकार का पंजीकरण शुल्क, प्रोसेसिंग शुल्क, जॉइनिंग फीस, सिक्योरिटी डिपॉजिट या अन्य कोई भी शुल्क नहीं लिया जाता। यहाँ पर उत्पाद बिक्री के बाद ही आय प्राप्त होती है|</p>
                <p>यदि कोई व्यक्ति या संस्था कंपनी के नाम का दुरुपयोग करते हुए नौकरी दिलाने के नाम पर किसी भी प्रकार की धनराशि की मांग करती है, तो वह पूर्णतः अनधिकृत एवं अवैध है। ऐसे किसी भी अनधिकृत व्यक्ति द्वारा किए गए लेन-देन, वादे या समझौते के लिए कंपनी किसी भी प्रकार से उत्तरदायी नहीं होगी।</p>
                <p>कंपनी आम जनता से अनुरोध करती है कि वे ऐसे फर्जी भर्ती प्रस्तावों, भ्रामक सूचनाओं एवं धोखाधड़ीपूर्ण लेन-देन से सावधान रहें तथा ऐसी किसी भी घटना की सूचना तुरंत कंपनी को दें।</p>
                <p>
                    कंपनी उपभोक्ता मामलों के विभाग, भारत सरकार द्वारा अधिसूचित
                    डायरेक्ट सेलिंग (Regulation) Rules, 2021 तथा
                    ई-कॉमर्स (Consumer Protection) Rules, 2020
                    का पूर्ण अनुपालन सुनिश्चित करने के लिए प्रतिबद्ध है और अपने सभी व्यावसायिक कार्य लागू कानूनों एवं नियमों के अनुसार संचालित करती है।
                </p>
                <p>इस वेबसाइट पर उपलब्ध समस्त जानकारी केवल सामान्य सूचना के उद्देश्य से प्रदान की गई है। कंपनी बिना पूर्व सूचना के किसी भी समय सामग्री में परिवर्तन करने का अधिकार सुरक्षित रखती है।</p>
                <p>&copy; @compName. All rights reserved.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-more" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section styles {
    <style>
        /* layout.css zeroes paragraph margins - give the notice some rhythm */
        #onloadModal .modal-body p {
            margin-bottom: 10px !important;
        }
        .wlcme-row p {
            margin-bottom: 12px !important;
        }
    </style>
}
