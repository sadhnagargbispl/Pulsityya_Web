                                <label>Reject Reason : @Model.Userkycres.rejectreason</label><br />
                                <label>Reject Remark : @Model.Userkycres.rejectremark</label>
                            </div>
                        }

                        <!-- Aadhaar default hidden selection -->
                        <input type="hidden" id="IdType" name="IdType" value="1" />

                        <!-- Aadhaar verification section -->
                        <div class="row">

                            <div class="col-lg-10 col-8">

                                <div class="mb-3">

