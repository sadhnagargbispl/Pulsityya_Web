    <div class="container">
        <form class="p-4 bg-white rounded shadow-sm">

            <!-- STEP INDICATOR -->
            <div class="mb-4 step-indicator text-center">
                <input type="hidden" id="ispanverify" value="@Model.Userkycres.IsPanVerified" />
                <input type="hidden" id="isbankverify" value="@Model.Userkycres.isBankverified" />
                <input type="hidden" id="isaddrsverf" value="@Model.Userkycres.addrsverf" />
                <input type="hidden" id="isidproofverf" value="@Model.Userkycres.addressdetail.idproof" />
                @*<input type="hidden" id="Isformupload" value="@Model.Userkycres.Isformupload" />
                    <input type="hidden" id="isformuploadvalue" value="@Model.Userkycres.formuploaddetail.formupload" />*@
                <span id="s1" class="step-pending">1</span>
                <span id="s2" class="step-active">2</span>
                <span id="s3" class="step-pending">3</span>
                @*<span id="s4" class="step-pending">4</span>*@
                <span id="s4" class="step-pending">4</span>
            </div>


            <!-- ================= STEP 1 ================= -->
            <div class="card step-card" id="step1">
                <div class="card-header"><strong>1. PAN Card Details</strong></div>
                <div class="card-body">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">PAN Card No.</label>
                        <input type="text" id="PanNo" value="@Model.Userkycres.pandetail.panno" class="form-control" />
                    </div>

                    <button type="button" class="btn btn-success float-end" onclick="nextStep(1)">Next</button>
                    <br> <br>
                </div>
            </div>



            <!-- ================= STEP 2 ================= -->
            <div class="card step-card active" id="step2">
                <div class="card-header"><strong>2. Bank Information</strong></div>

                <div class="card-body">
                    @if (@Model.Userkycres.isBankverified == "P" || @Model.Userkycres.isBankverified == "R")
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account Type</label>
                                <select class="form-select" id="Actype" name="@Model.Userkycres.bankdetail.accounttype">
                                    <option value="0">CHOOSE ACCOUNT TYPE</option>
                                    <option value="SAVING ACCOUNT">SAVING ACCOUNT</option>
                                    <option value="CURRENT ACCOUNT">CURRENT ACCOUNT</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account No.</label>
                                <input type="text" id="Acno" value="@Model.Userkycres.bankdetail.acno" class="form-control" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Bank</label>
                                <select class="form-select" id="Bank">
                                    @foreach (var item in Model.BankLists)
                                    {
                                        if (!string.IsNullOrEmpty(Convert.ToString(Model.Userkycres.bankdetail.bankid)) && Convert.ToString(Model.Userkycres.bankdetail.bankid) == Convert.ToString(item.BankCode))
                                        {
                                            <option value="@item.BankCode" selected>@item.BankName</option>
                                        }
                                        <option value="@item.BankCode">@item.BankName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Branch Name</label>
                                <input type="text" id="BranchName" value="@Model.Userkycres.bankdetail.branchname" class="form-control" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">IFSC Code</label>
                                <input type="text" id="IFSCCode" value="@Model.Userkycres.bankdetail.ifscode" class="form-control" />
                            </div>
                        </div>

                        <button type="button" class="btn btn-secondary" onclick="prevStep(2)">Previous</button>
                        @*<button type="button" class="btn btn-success float-end"  onclick="nextStep(2)">Next</button>*@
                        <button type="button" class="btn btn-success float-end" id="bankbtn" onclick="BankKyc()">Next</button>
                        <button class="btn btn-success float-end" type="button" id="bankloader" style="display:none;" disabled>
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            Loading...
                        </button>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account Type</label>
                                @if (!string.IsNullOrEmpty(Model.Userkycres.bankdetail.accounttype))
                                {
                                    <select class="form-select" id="Actype" name="@Model.Userkycres.bankdetail.accounttype" disabled>
                                        <option value="0">CHOOSE ACCOUNT TYPE</option>
                                        <option value="SAVING ACCOUNT" selected>SAVING ACCOUNT</option>
                                        <option value="CURRENT ACCOUNT">CURRENT ACCOUNT</option>


                                    </select>
                                }
                                else
                                {
                                    <select class="form-select" id="Actype" name="@Model.Userkycres.bankdetail.accounttype" disabled>
                                        <option value="0">CHOOSE ACCOUNT TYPE</option>
                                        <option value="SAVING ACCOUNT">SAVING ACCOUNT</option>
                                        <option value="CURRENT ACCOUNT">CURRENT ACCOUNT</option>
                                    </select>
                                }

                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account No.</label>
                                <input type="text" id="Acno" value="@Model.Userkycres.bankdetail.acno" class="form-control" readonly />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Bank</label>
                                <select class="form-select" id="Bank" disabled>
                                    @foreach (var item in Model.BankLists)
                                    {
                                        if (!string.IsNullOrEmpty(Convert.ToString(Model.Userkycres.bankdetail.bankid)) && Convert.ToString(Model.Userkycres.bankdetail.bankid) == Convert.ToString(item.BankCode))
                                        {
                                            <option value="@item.BankCode" selected>@item.BankName</option>
                                        }
                                        <option value="@item.BankCode">@item.BankName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Branch Name</label>
                                <input type="text" id="BranchName" value="@Model.Userkycres.bankdetail.branchname" class="form-control" readonly />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">IFSC Code</label>
                                <input type="text" id="IFSCCode" value="@Model.Userkycres.bankdetail.ifscode" class="form-control" readonly />
                            </div>
                        </div>

                        <button type="button" class="btn btn-secondary" onclick="prevStep(2)">Previous</button>
                        <button type="button" class="btn btn-success float-end" onclick="nextStep(2)">Next</button>
                        @*<button type="button" class="btn btn-success float-end" id="bankbtn" onclick="BankKyc()">Next</button>*@
                        <button class="btn btn-success float-end" type="button" id="bankloader" style="display:none;" disabled>
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            Loading...
                        </button>
                    }


                </div>
            </div>



            <!-- ================= STEP 3 ================= -->
            <div class="card step-card" id="step3">

                <div class="card-header">
                    <strong>3. Aadhaar Details</strong>
                </div>

                <div class="card-body">

                    @if (Model.Userkycres.addrsverf == "P" || Model.Userkycres.addrsverf == "R")
