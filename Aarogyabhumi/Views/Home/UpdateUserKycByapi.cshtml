    <script type="text/javascript">
        function BankKyc() {
            $("#bankbtn").hide();
            $("#bankloader").show();
            var Actype = $("#Actype").val();
            if (Actype == "0") {
                alert("Please select account type");
                $("#bankbtn").show();
                $("#bankloader").hide();
                return false;
            }
            var Acno = $("#Acno").val();
            if (Acno == "") {
                alert("Please enter Account no.");
                $("#bankbtn").show();
                $("#bankloader").hide();
                return false;
            }
            if (!/^\d{8,20}$/.test($("#Acno").val())) {
                alert("Invalid Account Number");
                $("#Acno").focus();
                $("#bankbtn").show();
                $("#bankloader").hide();
                return false;
            }
            var Bank = $("#Bank").val();
            if (Bank == "0") {
                alert("Please select bank");
                $("#bankbtn").show();
                $("#bankloader").hide();
                return false;
            }
            var Bankname = $("#Bank :selected").text()
            var BranchName = $("#BranchName").val();
            if (BranchName == "") {
                alert("Please enter branch name");
                $("#bankbtn").show();
                $("#bankloader").hide();
                return false;
            }
            var IFSCCode = $("#IFSCCode").val();
            if (IFSCCode == "") {
                alert("Please enter IFSC Code");
                $("#bankbtn").show();
                $("#bankloader").hide();
                return false;
            }
            $.ajax({
                type: "POST",
                url: "/Account/AccountNumberVerify",
                async: true,
                data: { ifsc: IFSCCode, accountnumber: Acno, Actype: Actype, Bank: Bank, BranchName: BranchName, Bankname: Bankname },
                success: function (data) {
                    debugger;
                    alert(data.Message);
                    if (data.Status == true) {
                        window.location.reload();
                    }
                    else {
                        $("#bankbtn").show();
                        $("#bankloader").hide();
                    }
                },
                failure: function (response) {
                    console.log(response.responseText);
                },
                error: function (response) {
                    console.log(response.responseText);
                }
            });
        }
        function AddressVerify() {
            debugger;
            $("#addresskyc").hide();
            $("#adrsloader").show();


            var address = $("#address").val();

            if (address == "") {

                alert("Please enter address");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            var Pincode = $("#Pincode").val();

            if (Pincode == "") {

                alert("Please enter pincode");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            var statecode = $("#statecode").val();

            if (!statecode || statecode == "0") {

                alert("Please select state");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            var District = $("#District").val();

            if (District == "") {

                alert("Please enter district");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            var City = $("#City").val();

            if (City == "") {

                alert("Please enter city");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            /* ===============================
               Aadhaar Validation (Main Fix)
            =============================== */

            var Aadharno = $("#aadhar").val();

            if (Aadharno == "") {

                alert("Please enter Aadhaar number");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            if (Aadharno.length != 12) {

                alert("Aadhaar must be 12 digits");

                $("#addresskyc").show();
                $("#adrsloader").hide();

                return false;

            }


            /* ===============================
               Form Data Submit
            =============================== */

            var formData = new FormData();

            formData.append("Address", address);

            formData.append("Pincode", Pincode);

            formData.append("StateCode", statecode);

            formData.append("District", District);

            formData.append("City", City);

            formData.append("IdType", "1"); // Aadhaar fixed

            formData.append("Aadharno", Aadharno);


            $.ajax({

                url: '/Account/AddressVerify',

                type: 'POST',

                data: formData,

                contentType: false,

                processData: false,


                success: function (response) {

                    if (response.success) {

                        location.reload();

                    }
                    else {

                        $("#addresskyc").show();
                        $("#adrsloader").hide();

                    }

                    alert(response.message);

                },


                error: function () {

                    alert("Something went wrong");

                    $("#addresskyc").show();
                    $("#adrsloader").hide();

                }

            });

        }
