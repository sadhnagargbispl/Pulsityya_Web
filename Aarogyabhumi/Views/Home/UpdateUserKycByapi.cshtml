    <script>
        function setStep(step) {

            // hide all steps
            for (let i = 1; i <= 3; i++) {
                document.getElementById("step" + i).classList.remove("active");
                document.getElementById("s" + i).classList.remove("step-active");
                document.getElementById("s" + i).classList.add("step-pending");
            }

            // show current step
            document.getElementById("step" + step).classList.add("active");

            // highlight current indicator
            document.getElementById("s" + step).classList.add("step-active");
            document.getElementById("s" + step).classList.remove("step-pending");
        }


        function nextStep(step) {
            setStep(step + 1);
        }

        function prevStep(step) {
            setStep(step - 1);
        }
        var ispanverify = $("#ispanverify").val();
        var isbankverify = $("#isbankverify").val();
        var isaddrsverf = $("#isaddrsverf").val();
        var isidproofverf = $("#isidproofverf").val();
        //var Isformupload = $("#Isformupload").val();
        //var isformuploadvalue = $("#isformuploadvalue").val();
        debugger;
        // default open step 1
        if (ispanverify != "Y") {
            setStep(1);
        }
        else if (isbankverify != "Y") {
            setStep(2);
        }
        else if (isaddrsverf != "Y") {
            setStep(3);
        }
        else {
            if (isaddrsverf == "P")
            {
                setStep(3);
            }
            else if (isaddrsverf == "R")
            {
                setStep(3);
            }
            else if (isidproofverf == "")
            {
                setStep(3);
            }
            //else {
            //    if (Isformupload == "P")
            //    {
            //        setStep(4);
            //    }
            //    else if (Isformupload == "R")
            //    {
            //        setStep(4);
            //    }
            //    if (isformuploadvalue == "")
            //    {
            //        setStep(4);
            //    }
            //}

            if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "N" ) {
                setStep(4);
            }
            else if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "N" ) {
                setStep(4);
            }
            else if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "Y" ) {
                setStep(4);
            }
            else if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "Y" ) {
                setStep(4);
            }

        }



    </script>
    <script>

        /* ============================================================
           OTP TIMER CONFIG
        ============================================================ */

        var _otpTimer = null;


        /* ============================================================
           TIMER FORMAT HELPER
        ============================================================ */

        function formatTimer(s) {

            var m = Math.floor(s / 60);
            var sec = s % 60;

            return (m < 10 ? '0' : '') + m + ':' +
                (sec < 10 ? '0' : '') + sec;
        }


        /* ============================================================
           START OTP TIMER (5 MIN)
        ============================================================ */

        function startOtpTimer() {

            if (_otpTimer) clearInterval(_otpTimer);

            var seconds = 300;

            $('#aadharverifybtn')
                .prop('disabled', true)
                .text('Resend OTP (' + formatTimer(seconds) + ')');

            _otpTimer = setInterval(function () {

                seconds--;

                if ($('#isaadharverify').val() !== 'true') {

                    $('#aadharverifybtn')
                        .text('Resend OTP (' + formatTimer(seconds) + ')');

                }

                if (seconds <= 0) {

                    clearInterval(_otpTimer);
                    _otpTimer = null;

                    if ($('#isaadharverify').val() !== 'true') {

                        $('#otpsection').hide();

                        $('#aadharotp').val('');

                        $('#aadharverifybtn')
                            .prop('disabled', false)
                            .text('Resend OTP');

                    }

                }

            }, 1000);

        }


        /* ============================================================
           SEND OTP
        ============================================================ */

        function AadharVerification() {

            if ($('#isaadharverify').val() === 'true') {

                $('#aadharverifybtn')
                    .prop('disabled', true)
                    .text('Verified');

                return;

            }

            var aadhar = $('#aadhar').val().trim();

            if (!aadhar) {

                alert('Please enter Aadhaar number.');
                return;

            }

            if (aadhar.length !== 12 || isNaN(aadhar)) {

                alert('Please enter valid 12 digit Aadhaar number.');
                return;

            }

            $('#aadharverifybtn').prop('disabled', true);

            $('#aadharwait').show();


            $.ajax({

                type: "POST",

                url: "/Account/AadharOtpVerify",

                data: { AadharNo: aadhar },


                success: function (data) {

                    $('#aadharwait').hide();

                    alert(data.Message);


                    if (data.Status === true) {

                        $('#ReferenceIdHidden').val(data.ReferenceId);

                        $('#isaadharverify').val('otp_sent');

                        $('#otpsection').show();

                        startOtpTimer();

                    }
                    else {

                        $('#aadharverifybtn')
                            .prop('disabled', false)
                            .text('Send OTP');

                    }

                },


                error: function () {

                    $('#aadharwait').hide();

                    alert("OTP sending failed.");

                    $('#aadharverifybtn')
                        .prop('disabled', false)
                        .text('Send OTP');

                }

            });

        }


        /* ============================================================
           VERIFY OTP
        ============================================================ */

        function VerifyAadharOtp() {

            var otp = $('#aadharotp').val().trim();

            var referenceId = $('#ReferenceIdHidden').val();


            if (!otp) {

                alert('Enter OTP first');

                return;

            }


            $.ajax({

                type: "POST",

                url: "/Account/VerifyAadhaarOtp",

                data: {

                    ReferenceId: referenceId,

                    Otp: otp

                },


                success: function (res) {


                    if (res.Status === true) {

                        $('#isaadharverify').val('true');


                        if (_otpTimer) {

                            clearInterval(_otpTimer);

                            _otpTimer = null;

                        }


                        $('#aadharverifybtn')

                            .prop('disabled', true)

                            .text('Verified');


                        /* ===============================
                           AUTO ADDRESS FILL
                        =============================== */

                        if (res.FullAddress)
                            $('#address').val(res.FullAddress);

                        if (res.Pincode)
                            $('#Pincode').val(res.Pincode);

                        if (res.State) {

                            var apiState = res.State.trim().toLowerCase();

                            $("#statecode option").each(function () {

                                var optionText = $(this).text().trim().toLowerCase();

                                if (optionText.includes(apiState) || apiState.includes(optionText)) {

                                    $(this).prop("selected", true);

                                    return false;

                                }
                            });
                        }

                        if (res.District)
                            $('#District').val(res.District);

                        if (res.City)
                            $('#City').val(res.City);


                        /* ===============================
                           LOCK ADDRESS FIELDS
                        =============================== */

                        $('#aadhar,#address,#Pincode,#District,#City')

                            .prop('readonly', true);


                        $('#statecode').prop('disabled', true);


                        /* ===============================
                           HIDE OTP BOX
                        =============================== */

                        $('#otpsection').hide();


                        alert('Aadhaar verified successfully');

                    }

                    else {

                        alert(res.Message || "Invalid OTP");

                        $('#aadharotp').val('').focus();

                    }

                },


                error: function () {

                    alert("OTP verification failed");

                }

            });

        }


        /* ============================================================
           PAGE LOAD STATE RESTORE
        ============================================================ */

        $(document).ready(function () {

            if ($('#isaadharverify').val() === 'true') {

                $('#aadharverifybtn')

                    .prop('disabled', true)

                    .text('Verified');


                $('#aadhar,#address,#Pincode,#District,#City')

                    .prop('readonly', true);


                $('#statecode').prop('disabled', true);

            }

        });

    </script>
