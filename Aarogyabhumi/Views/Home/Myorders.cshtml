    function Showofflineorderdetail(OrderId) {
        $.ajax({
            type: "Post",
            url: '/Home/Showofflineorderdetail',
            dataType: "Json",
            data: { OrderId: OrderId },
            success: function (data) {
                debugger;

                $('#GrdOrderNo').html(data.tblOrder);
                //jQuery.noConflict();
                $('#myModal').modal('show');
