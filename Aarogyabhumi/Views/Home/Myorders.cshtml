<!-- Popup modal for order number -->

<section class="osahan-listingmy-account-main-page mt-3 mb-3">
    <div class="container">
        <div class="row m-0">
            <div class="col-lg-12">
                <div class="row row-cols-xl-1 row-cols-lg-1 row-cols-md-1 row-cols-1 g-3 osahan-my-orders">
                    <div class="table-responsive bg-white">
                        <table class="table table-bordered text-center mb-0 nowrap">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Order No</th>

                                    @*<th scope="col">BillNo</th>*@
                                    <th scope="col">Order Date</th>
                                    @*<th scope="col">Request</th>*@
                                    <th scope="col">Order Amount</th>
                                    <th scope="col">Courier Charge</th>
                                    <th scope="col"> By Wallet</th>

                                    @*<th scope="col"> Repurchase Wallet</th>*@
                                    @*<th scope="col">Coupon Amount</th>
                                        <th scope="col">Coupon</th>*@

                                    @*<th scope="col">Coupon Amount</th>
                                        <th scope="col">Coupon</th>*@


                                    <th scope="col">By Online</th>
                                    @if (Convert.ToString(Session["MemMode"]) == "D")
                                    {
                                        <th scope="col">Paid SV</th>
                                    }
                                    <th scope="col">Dispatch Status</th>
                                    <th scope="col">Remark</th>
                                    <th scope="col">Pay Mode</th>

                                    <th scope="col">Courier Name</th>
                                    <th scope="col">Docket No</th>
                                    <th scope="col">Docket Date</th>
                                    <th scope="col">Track</th>
                                    <th scope="col">Download Bill </th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model.OrderReport)
                                {
                                    if (!string.IsNullOrEmpty(item.Orderno))
                                    {
                                        <tr class="">

                                            <td>
                                                <a class="btn btn-outline-success" href="javascript:void(0)" onclick="ShowGrdOrderNo(this,'@item.Orderno','@item.status','@idno')">@item.Orderno</a>
                                            </td>

                                            @*<td> @item.BillNo</td>*@
                                            <td> @item.orderdate</td>

                                            @*<td>@item.KitName</td>*@
                                            <td>
                                                @(item.OrderAmount+item.CourierCharge)

                                            </td>
                                            <td>@item.CourierCharge</td>
                                            <td>@item.Pinwallet</td>
                                            @*<td>@item.OtherAmt</td>*@

                                            @*<td>@item.couponamount</td>
                                                <td>@item.coupon</td>*@
                                            <td>
                                                @item.Chamt
                                            </td>
                                            @if (Convert.ToString(Session["MemMode"]) == "D")
                                            {
                                                <td>@item.BV</td>
                                            }
                                            <td>
                                                @item.status
                                            </td>
                                            <td></td>
                                            <td>
                                                @item.Mode

                                            </td>

                                            <td>
                                                @if (item.CourierName != "-- SELECT --")
                                                {
                                                    @item.CourierName
                                                }
                                            </td>
                                            <td>@item.DocketNo</td>
                                            <td>
                                                @if (item.DocketDate != "01-Jan-1900")
                                                {
                                                    @item.DocketDate
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Website) && item.Website != "#")
                                                {
                                                    <a href="@item.Website" class="btn btn-rounded" target="_blank"><b>Track</b></a>
                                                }
                                            </td>
                                            <td>
                                                @if (item.status == "Dispatched" || item.status == "Partial Dispatched")
                                                {
                                                    <a class="btn btn-rounded" href="javascript:void(0)" onclick="showbillno('@item.InvBillno','@idno','@item.status')">Download Bill</a>

                                                }
                                            </td>

                                        </tr>
                                    }
                                }


                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal modal-lg fade quick-view-product" id="myModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="single-product-thumb" id="GrdOrderNo">
                    <div class="row">

                        @if (Model.OrderNoDetail != null && Model.OrderNoDetail.Count() > 0)
                        {
                            @Html.Partial("OrderDetail", Model);
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


