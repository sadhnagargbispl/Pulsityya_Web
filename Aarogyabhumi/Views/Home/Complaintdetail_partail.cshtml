@model Shopinv.Models.ComplaintReplyDetailsRes

<div class="axil-product-cart-area">
    <div class="table-responsive text-nowrap carttable">

        @if (Model != null && Model.response == "OK")
        {
            if (Model.complaintreplydetail != null && Model.complaintreplydetail.Count > 0)
            {
                <table class="table table-bordered">
                    <thead>
                        <tr class="nowrap info">
                            <th>Date</th>
                            <th>Reply</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.complaintreplydetail)
                        {
                            <tr>
                                <td>
                                    @item.replydate
                                </td>
                                <td>@item.reply</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <center> <p> No Record Found</p></center>
            }
        }
        else
        {
            <center> <p> No Record Found</p></center>
        }
    </div>
</div>
