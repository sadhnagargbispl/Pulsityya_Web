<script>
    $(document).ready(function () {

        $("#kycbtn").click(function () {
            debugger;
            if (!validateForm()) return;

            var IdType = $("#IdType").val();
            if (IdType == "0") {
                alert("Please select id proof type");
                return false;
            }
            var Actype = $("#Actype").val();
            if (Actype == "0") {
                alert("Please select account type");
                return false;
            }
            var Bank = $("#Bank").val();
            if (Bank == "0") {
                alert("Please select bank");
                return false;
            }
            var formData = new FormData();
            formData.append("Address", $("#address").val());
            formData.append("Pincode", $("#Pincode").val());
            formData.append("StateCode", $("#statecode").val());
            formData.append("District", $("#District").val());
            formData.append("City", $("#City").val());
            formData.append("IdType", $("#IdType").val());
            formData.append("Aadharno", $("#Aadharno").val());
            formData.append("Aadharfront", $("#Aadharfront")[0].files[0]);
            formData.append("Aadharback", $("#Aadharback")[0].files[0]);
            formData.append("Actype", $("#Actype").val());
            formData.append("Acno", $("#Acno").val());
            formData.append("Bank", $("#Bank").val());
            formData.append("Bankname", $("#Bank :selected").text());
            formData.append("BranchName", $("#BranchName").val());
            formData.append("IFSCCode", $("#IFSCCode").val());
            formData.append("Bankdoc", $("#Bankdoc")[0].files[0]);
            formData.append("PanNo", $("#PanNo").val());
            formData.append("Pandoc", $("#Pandoc")[0].files[0]);
            formData.append("kycdoc", $("#kycdoc")[0].files[0]);

            $.ajax({
                url: '/Account/SaveKyc',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    $("#kycbtn").prop("disabled", true).text("Saving...");
                },
                success: function (response) {
                    if (response.success) {

                        location.reload();
                    }
                    alert("" + response.message);
                },
                error: function (xhr, status, error) {
                    debugger;
                    let errorMessage = "Something went wrong";

                    // Try to get meaningful message from server
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        // Sometimes server sends plain text or HTML
                        errorMessage = xhr.responseText.substring(0, 300); // prevent too long alert
                    } else if (xhr.status === 0) {
                        errorMessage = "Connection failed (server offline / blocked by CORS / timeout)";
                    } else if (xhr.status === 413) {
                        errorMessage = "File too large (413 Payload Too Large)";
                    } else if (xhr.status >= 400 && xhr.status < 500) {
                        errorMessage = `Client error (${xhr.status}): ${xhr.statusText}`;
                    } else if (xhr.status >= 500) {
                        errorMessage = `Server error (${xhr.status})`;
                    }

                    alert("Error: " + errorMessage);
                    /*alert("Error:" + error);*/
                },
                complete: function () {
                    $("#kycbtn").prop("disabled", false).text("Save KYC");
                }
            });
        });

        function validateForm() {
            let required = [
                "#address", "#Pincode", "#statecode", "#District", "#City",
                "#Aadharno", "#Aadharfront", "#Aadharback", "#Actype", "#Acno",
                "#Bank", "#BranchName", "#IFSCCode", "#Bankdoc", "#PanNo", "#Pandoc", "#IdType"
            ];

            for (let f of required) {
                if ($(f).val() === "" || $(f).val() == null) {
                    alert("Please fill all mandatory fields!");
                    $(f).focus();
                    return false;
                }
            }

            if (!/^\d{6}$/.test($("#Pincode").val())) {
                alert("Invalid Pincode (6 digits only)");
                $("#Pincode").focus(); return false;
            }

            if ($("#Aadharno").val().length > 16) {
                alert("Max 16 digits character");
                $("#Aadharno").focus(); return false;
            }

            //if (!/^\d{16}$/.test($("#Aadharno").val())) {
            //    alert("Max 16 digits character");
            //    $("#Aadharno").focus(); return false;
            //}

            //if (!/^[A-Z]{4}0[A-Z0-9]{6}$/i.test($("#IFSCCode").val())) {
            //    alert("Invalid IFSC Code format");
            //    $("#IFSCCode").focus(); return false;
            //}

            if (!/^\d{8,20}$/.test($("#Acno").val())) {
                alert("Invalid Account Number");
                $("#Acno").focus(); return false;
            }

            if (!/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/i.test($("#PanNo").val())) {
                alert("Invalid PAN Number format");
                $("#PanNo").focus(); return false;
            }

            let allowed = [".jpg", ".jpeg", ".png", ".pdf"];
            let files = ["#Aadharfront", "#Aadharback", "#Bankdoc", "#Pandoc"];

            for (let file of files) {
                let name = $(file).val();
                if (name) {
                    let ext = name.substring(name.lastIndexOf('.')).toLowerCase();
                    if (!allowed.includes(ext)) {
                        alert("Invalid file type: " + name);
                        $(file).focus(); return false;
                    }
                }
            }

            let kycallowed = [".pdf"];
            let kycfiles = ["#kycdoc"];
            for (let file of kycfiles) {
                let name = $(file).val();
                if (name) {
                    let ext = name.substring(name.lastIndexOf('.')).toLowerCase();
                    if (!kycallowed.includes(ext)) {
                        alert("Invalid file type: " + name);
                        $(file).focus(); return false;
                    }
                }
            }

            return true;
        }
    });
</script>
<script>
    function setStep(step) {

        // hide all steps
        for (let i = 1; i <= 3; i++) {
            document.getElementById("step" + i).classList.remove("active");
            document.getElementById("s" + i).classList.remove("step-active");
            document.getElementById("s" + i).classList.add("step-pending");
        }

        // show current step
        document.getElementById("step" + step).classList.add("active");

        // highlight current indicator
        document.getElementById("s" + step).classList.add("step-active");
        document.getElementById("s" + step).classList.remove("step-pending");
    }


    function nextStep(step) {
        setStep(step + 1);
    }

    function prevStep(step) {
        setStep(step - 1);
    }
    var ispanverify = $("#ispanverify").val();
    var isbankverify = $("#isbankverify").val();
    var isaddrsverf = $("#isaddrsverf").val();
    var isidproofverf = $("#isidproofverf").val();
    //var Isformupload = $("#Isformupload").val();
    //var isformuploadvalue = $("#isformuploadvalue").val();
    debugger;
    // default open step 1
    if (ispanverify != "Y") {
        setStep(1);
    }
    else if (isbankverify != "Y") {
        setStep(2);
    }
    else if (isaddrsverf != "Y") {
        setStep(3);
    }
    else {
        if (isaddrsverf == "P") {
            setStep(3);
        }
        else if (isaddrsverf == "R") {
            setStep(3);
        }
        else if (isidproofverf == "") {
            setStep(3);
        }
        //else {
        //    if (Isformupload == "P")
        //    {
        //        setStep(4);
        //    }
        //    else if (Isformupload == "R")
        //    {
        //        setStep(4);
        //    }
        //    if (isformuploadvalue == "")
        //    {
        //        setStep(4);
        //    }
        //}

        if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "N") {
            setStep(4);
        }
        else if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "N") {
            setStep(4);
        }
        else if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "Y") {
            setStep(4);
        }
        else if (ispanverify == "Y" && isbankverify == "Y" && isaddrsverf == "Y") {
            setStep(4);
        }

    }



</script>
<script>

    /* ============================================================
       OTP TIMER CONFIG
    ============================================================ */

    var _otpTimer = null;


    /* ============================================================
       TIMER FORMAT HELPER
    ============================================================ */

    function formatTimer(s) {

        var m = Math.floor(s / 60);
        var sec = s % 60;

        return (m < 10 ? '0' : '') + m + ':' +
            (sec < 10 ? '0' : '') + sec;
    }


    /* ============================================================
       START OTP TIMER (5 MIN)
    ============================================================ */

    function startOtpTimer() {

        if (_otpTimer) clearInterval(_otpTimer);

        var seconds = 300;

        $('#aadharverifybtn')
            .prop('disabled', true)
            .text('Resend OTP (' + formatTimer(seconds) + ')');

        _otpTimer = setInterval(function () {

            seconds--;

            if ($('#isaadharverify').val() !== 'true') {

                $('#aadharverifybtn')
                    .text('Resend OTP (' + formatTimer(seconds) + ')');

            }

            if (seconds <= 0) {

                clearInterval(_otpTimer);
                _otpTimer = null;

                if ($('#isaadharverify').val() !== 'true') {

                    $('#otpsection').hide();

                    $('#aadharotp').val('');

                    $('#aadharverifybtn')
                        .prop('disabled', false)
                        .text('Resend OTP');

                }

            }

        }, 1000);

    }


    /* ============================================================
       SEND OTP
    ============================================================ */

    function AadharVerification() {

        if ($('#isaadharverify').val() === 'true') {

            $('#aadharverifybtn')
                .prop('disabled', true)
                .text('Verified');

            return;

        }

        var aadhar = $('#aadhar').val().trim();

        if (!aadhar) {

            alert('Please enter Aadhaar number.');
            return;

        }

        if (aadhar.length !== 12 || isNaN(aadhar)) {

            alert('Please enter valid 12 digit Aadhaar number.');
            return;

        }

        $('#aadharverifybtn').prop('disabled', true);

        $('#aadharwait').show();


        $.ajax({

            type: "POST",

            url: "/Account/AadharOtpVerify",

            data: { AadharNo: aadhar },


            success: function (data) {

                $('#aadharwait').hide();

                alert(data.Message);


                if (data.Status === true) {

                    $('#ReferenceIdHidden').val(data.ReferenceId);

                    $('#isaadharverify').val('otp_sent');

                    $('#otpsection').show();

                    startOtpTimer();

                }
                else {

                    $('#aadharverifybtn')
                        .prop('disabled', false)
                        .text('Send OTP');

                }

            },


            error: function () {

                $('#aadharwait').hide();

                alert("OTP sending failed.");

                $('#aadharverifybtn')
                    .prop('disabled', false)
                    .text('Send OTP');

            }

        });

    }


    /* ============================================================
       VERIFY OTP
    ============================================================ */

    function VerifyAadharOtp() {

        var otp = $('#aadharotp').val().trim();

        var referenceId = $('#ReferenceIdHidden').val();


        if (!otp) {

            alert('Enter OTP first');

            return;

        }


        $.ajax({

            type: "POST",

            url: "/Account/VerifyAadhaarOtp",

            data: {

                ReferenceId: referenceId,

                Otp: otp

            },


            success: function (res) {


                if (res.Status === true) {

                    $('#isaadharverify').val('true');


                    if (_otpTimer) {

                        clearInterval(_otpTimer);

                        _otpTimer = null;

                    }


                    $('#aadharverifybtn')

                        .prop('disabled', true)

                        .text('Verified');


                    /* ===============================
                       AUTO ADDRESS FILL
                    =============================== */

                    if (res.FullAddress)
                        $('#address').val(res.FullAddress);

                    if (res.Pincode)
                        $('#Pincode').val(res.Pincode);

                    if (res.State) {

                        var apiState = res.State.trim().toLowerCase();

                        $("#statecode option").each(function () {

                            var optionText = $(this).text().trim().toLowerCase();

                            if (optionText.includes(apiState) || apiState.includes(optionText)) {

                                $(this).prop("selected", true);

                                return false;

                            }
                        });
                    }

                    if (res.District)
                        $('#District').val(res.District);

                    if (res.City)
                        $('#City').val(res.City);


                    /* ===============================
                       LOCK ADDRESS FIELDS
                    =============================== */

                    $('#aadhar,#address,#Pincode,#District,#City')

                        .prop('readonly', true);


                    $('#statecode').prop('disabled', true);


                    /* ===============================
                       HIDE OTP BOX
                    =============================== */

                    $('#otpsection').hide();


                    alert('Aadhaar verified successfully');

                }

                else {

                    alert(res.Message || "Invalid OTP");

                    $('#aadharotp').val('').focus();

                }

            },


            error: function () {

                alert("OTP verification failed");

            }

        });

    }


    /* ============================================================
       PAGE LOAD STATE RESTORE
    ============================================================ */

    $(document).ready(function () {

        if ($('#isaadharverify').val() === 'true') {

            $('#aadharverifybtn')

                .prop('disabled', true)

                .text('Verified');


            $('#aadhar,#address,#Pincode,#District,#City')

                .prop('readonly', true);


            $('#statecode').prop('disabled', true);

        }

    });

</script>