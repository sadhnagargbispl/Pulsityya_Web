    <script>
        function setStep(step) {

            // Hide all steps
            for (let i = 1; i <= 4; i++) {

                let stepDiv = document.getElementById("step" + i);
                let stepIndicator = document.getElementById("s" + i);

                if (stepDiv) {
                    stepDiv.classList.remove("active");
                }

                if (stepIndicator) {
                    stepIndicator.classList.remove("step-active");
                    stepIndicator.classList.add("step-pending");
                }
            }

            // Show current step
            let currentStep = document.getElementById("step" + step);
            if (currentStep) {
                currentStep.classList.add("active");
            }

            // Highlight current indicator
            let currentIndicator = document.getElementById("s" + step);
            if (currentIndicator) {
                currentIndicator.classList.add("step-active");
                currentIndicator.classList.remove("step-pending");
            }
        }

        function nextStep(step) {
            setStep(step + 1);
        }

        function prevStep(step) {
            setStep(step - 1);
        }

        document.addEventListener("DOMContentLoaded", function () {
            setStep(1);
        });
    </script>
