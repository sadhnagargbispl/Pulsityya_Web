                if (!validateForm()) return;

                var IdType = $("#IdType").val();
                if (IdType == "0") {
                    alert("Please select id proof type");
                    return false;
                }
                var Actype = $("#Actype").val();
                if (Actype == "0") {
                    alert("Please select account type");
                    return false;
                }
                var Bank = $("#Bank").val();
                if (Bank == "0") {
                    alert("Please select bank");
                    return false;
                }
                var formData = new FormData();
                formData.append("Address", $("#address").val());
                formData.append("Pincode", $("#Pincode").val());
                formData.append("StateCode", $("#statecode").val());
                formData.append("District", $("#District").val());
                formData.append("City", $("#City").val());
                formData.append("IdType", $("#IdType").val());
                formData.append("Aadharno", $("#Aadharno").val());
                formData.append("Aadharfront", $("#Aadharfront")[0].files[0]);
                formData.append("Aadharback", $("#Aadharback")[0].files[0]);
                formData.append("Actype", $("#Actype").val());
                formData.append("Acno", $("#Acno").val());
                formData.append("Bank", $("#Bank").val());
                formData.append("Bankname", $("#Bank :selected").text());
                formData.append("BranchName", $("#BranchName").val());
                formData.append("IFSCCode", $("#IFSCCode").val());
                formData.append("Bankdoc", $("#Bankdoc")[0].files[0]);
                formData.append("PanNo", $("#PanNo").val());
                formData.append("Pandoc", $("#Pandoc")[0].files[0]);
                formData.append("kycdoc", $("#kycdoc")[0].files[0]);

                $.ajax({
                    url: '/Account/SaveKyc',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        debugger;
                        $("#kycbtn").prop("disabled", true).text("Saving...");
                    },
                    success: function (response) {
                        debugger;
                        if (response.success) {

                            location.reload();
                        }
                        alert("" + response.message);
                    },
                    error: function (xhr, status, error) {
                        debugger;
                        let errorMessage = "Something went wrong";

                        // Try to get meaningful message from server
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            // Sometimes server sends plain text or HTML
                            errorMessage = xhr.responseText.substring(0, 300); // prevent too long alert
                        } else if (xhr.status === 0) {
                            errorMessage = "Connection failed (server offline / blocked by CORS / timeout)";
                        } else if (xhr.status === 413) {
                            errorMessage = "File too large (413 Payload Too Large)";
                        } else if (xhr.status >= 400 && xhr.status < 500) {
                            errorMessage = `Client error (${xhr.status}): ${xhr.statusText}`;
                        } else if (xhr.status >= 500) {
                            errorMessage = `Server error (${xhr.status})`;
                        }

                        alert("Error: " + errorMessage);
                        /*alert("Error:" + error);*/
                    },
                    complete: function () {
                        $("#kycbtn").prop("disabled", false).text("Save KYC");
                    }
                });
            });

            function validateForm() {
                let required = [
                    "#address", "#Pincode", "#statecode", "#District", "#City",
                    "#Aadharno", "#Aadharfront", "#Aadharback", "#Actype", "#Acno",
                    "#Bank", "#BranchName", "#IFSCCode", "#Bankdoc", "#PanNo", "#Pandoc", "#IdType"
                ];

                for (let f of required) {
                    if ($(f).val() === "" || $(f).val() == null) {
                        alert("Please fill all mandatory fields!");
                        $(f).focus();
                        return false;
                    }
                }

                if (!/^\d{6}$/.test($("#Pincode").val())) {
                    alert("Invalid Pincode (6 digits only)");
                    $("#Pincode").focus(); return false;
                }

                if ($("#Aadharno").val().length > 16) {
                    alert("Max 16 digits character");
                    $("#Aadharno").focus(); return false;
                }

                //if (!/^\d{16}$/.test($("#Aadharno").val())) {
                //    alert("Max 16 digits character");
                //    $("#Aadharno").focus(); return false;
                //}

                //if (!/^[A-Z]{4}0[A-Z0-9]{6}$/i.test($("#IFSCCode").val())) {
                //    alert("Invalid IFSC Code format");
                //    $("#IFSCCode").focus(); return false;
                //}

                if (!/^\d{8,20}$/.test($("#Acno").val())) {
                    alert("Invalid Account Number");
                    $("#Acno").focus(); return false;
                }

                if (!/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/i.test($("#PanNo").val())) {
                    alert("Invalid PAN Number format");
                    $("#PanNo").focus(); return false;
                }

                let allowed = [".jpg", ".jpeg", ".png", ".pdf"];
                let files = ["#Aadharfront", "#Aadharback", "#Bankdoc", "#Pandoc"];
                let maxSizeimg = 2 * 1024 * 1024; // 2 MB
                for (let file of files) {
                    let input = $(file)[0];
                    let name = $(file).val();
                    if (name) {
                        let ext = name.substring(name.lastIndexOf('.')).toLowerCase();
                        if (!allowed.includes(ext)) {
                            alert("Invalid file type: " + name);
                            $(file).focus(); return false;
                        }

                        // Size check (2 MB)
                        let fileObj = input.files[0];
                        if (fileObj && fileObj.size > maxSizeimg) {
                            alert("File size must not exceed 2 MB.");
                            $(file).val("");   // clear selected file
                            $(file).focus();
                            return false;
                        }
                    }
                }

                let kycallowed = [".pdf"];
                let kycfiles = ["#kycdoc"];
                let maxSize = 5 * 1024 * 1024; // 5MB
                for (let file of kycfiles) {
                    let name = $(file).val();
                    let input = $(file)[0];
                    if (name) {
                        let ext = name.substring(name.lastIndexOf('.')).toLowerCase();
                        if (!kycallowed.includes(ext)) {
                            alert("Invalid file type: " + name);
                            $(file).focus(); return false;
                        }

                        // Size check
                        let fileObj = input.files[0];
                        if (fileObj && fileObj.size > maxSize) {
                            alert("The PDF file size must not exceed 5 MB.");
                            $(file).val("");   // clear selected file
                            $(file).focus();
                            return false;
                        }
                    }
                }

                return true;
            }
        });

        
    </script>

