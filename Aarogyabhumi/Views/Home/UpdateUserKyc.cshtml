                                                    <option value="SAVING ACCOUNT" selected>SAVING ACCOUNT</option>
                                                }
                                                if (Model.Userkycres.bankdetail.accounttype == "CURRENT ACCOUNT")
                                                {
                                                    <option value="CURRENT ACCOUNT" selected>CURRENT ACCOUNT</option>
                                                }
