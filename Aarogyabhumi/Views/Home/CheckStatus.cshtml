@model Shopinv.Models.M_Complaint
@{
    ViewBag.Title = "CheckStatus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script type="text/javascript">
    function CheckStatus() {
        $("#Apply").prop('disabled', true);
        var memberid = $("#memberComplaintID").val();
        var complaintid = $("#complaintid").val();
        if (memberid === "") {
            alert("Please enter Complaint ID");
            $("#Apply").prop('disabled', false);
            return false;
        }
        $.ajax({
            type: "POST",
            url: "/Home/CheckCheckStatus",
            data: { Complaintid: complaintid, memberid: memberid },
            success: function (data) {
                if (data.response === "OK") {
                    var rows = "";
                    $.each(data.list, function (i, item) {
                        rows += "<tr>";
                        rows += "<td>" + item.complaintid + "</td>";
                        rows += "<td>" + item.complaintdate + "</td>";
                        rows += "<td>" + item.complaint + "</td>";
                        rows += "<td><a class='btn btn-rounded' href='javascript:void(0)' onclick=\"ShowReply('" + item.complaintid + "')\">View Reply</a></td>";
                        rows += "</tr>";
                    });
                    $("#complaintTableBody").html(rows);
                    $("#complaintSection").show();
                }
                else {
                    alert(data.msg || "No record found");
                    $("#complaintTableBody").html("");
                    $("#complaintSection").hide();
                }
                $("#Apply").prop('disabled', false);
            },
            error: function () {
                alert("Server error");
                $("#Apply").prop('disabled', false);
            }
        });
    }
    // 🔍 Member auto check (typing delay)
    $(document).ready(function () {
        let typingTimer;
        const doneTypingInterval = 600;
        $("#memberComplaintID").on("input", function () {
            clearTimeout(typingTimer);
            let memberId = $(this).val().trim();
            if (memberId.length < 3) return;
           typingTimer = setTimeout(function () {
                callComplaintApi(memberId);
            }, doneTypingInterval);
        });
        function callComplaintApi(memberId) {
            $.ajax({
                type: "POST",
                url: "/Home/memberdatacheck",
                data: { memberid: memberId },
                success: function (res) {
                    if (res.response === "OK") {
                        console.log("Member Found");
                    }
                    else {
                        alert("Member not found");
                        $("#memberComplaintID").val('');
                    }
                }
            });
        }
    });
    function ShowReply(complaintid) {
        $.ajax({
            type: "POST",
            url: "/Home/GetComplaintReplyDetails",
            dataType: "json",
            data: { complaintid: complaintid },
            success: function (data) {
                $('#GrdOrderNo').html(data.tblOrder);
                var myModal = new bootstrap.Modal(document.getElementById('myModal'));
                myModal.show();
            },
            error: function (xhr, status, error) {
                alert("Reply load nahi ho paya");
            }
        });
    }
</script>

<!-- ================= FORM ================= -->

<div class="contact-area bg-light pt-5 pb-5">
    <div class="container">
        <div class="bg-white rounded-4 border shadow-sm p-4">

            <h4 class="mb-4">Check Query Status</h4>

            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Complaint ID</label>
                    <input type="text" class="form-control" id="memberComplaintID" style="height:37px;" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Complaint No</label>
                    <input type="text" class="form-control" id="complaintid" style="height:37px;" />
                </div>
            </div>

            <div class="mt-4">
                <button type="button" id="Apply" onclick="CheckStatus()" class="btn btn-dark w-100">
                    Check Status
                </button>
            </div>
            <section id="complaintSection" class="osahan-listingmy-account-main-page mt-3 mb-3" style="display:none;">
                <div class="container">
                    <div class="table-responsive bg-white">
                        <table class="table table-bordered text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Complaint ID</th>
                                    <th>Date</th>
                                    <th>Complaint</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="complaintTableBody">
                                <!-- AJAX rows -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<div class="modal modal-lg fade quick-view-product" id="myModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="title">Complaint Reply Detail</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="single-product-thumb" id="GrdOrderNo">
                    <div class="row">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

