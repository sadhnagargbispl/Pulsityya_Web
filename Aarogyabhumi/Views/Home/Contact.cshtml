                            <i class="fa fa-paper-plane me-1"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>*@



            <!-- Right Side: Company Info -->
            <div class="col-lg-12">
                <div class="contact-info bg-white rounded p-4 shadow mb-4">
                    <h3 class="mb-3 ">@Convert.ToString(Session["CompName"])</h3>
                    <hr>
                    <p><i class="fa fa-envelope  me-2"></i><strong>Email:</strong> @Convert.ToString(Session["CompMail"])</p>
                    <p><i class="fa fa-phone me-2"></i><strong>Phone:</strong> +91 @Convert.ToString(Session["ContactNo"])</p>
                    <p><i class="fa fa-map-marker-alt me-2"></i><strong>Address:</strong>  @Convert.ToString(Session["CompAdd"])</p>

                    <!-- Social Media Links -->
                    <div class="social-icons mt-3">
                        <a href="https://facebook.com" target="_blank" class="me-3 text-dark">
                            <i class="fab fa-facebook fa-lg"></i>
                        </a>
                        <a href="https://instagram.com" target="_blank" class="me-3 text-dark">
                            <i class="fab fa-instagram fa-lg"></i>
                        </a>
                        <a href="https://linkedin.com" target="_blank" class="me-3 text-dark">
                            <i class="fab fa-linkedin fa-lg"></i>
                        </a>
                        <a href="https://twitter.com" target="_blank" class="me-3 text-dark">
                            <i class="fab fa-twitter fa-lg"></i>
                        </a>
                        <a href="https://youtube.com" target="_blank" class="text-dark">
                            <i class="fab fa-youtube fa-lg"></i>
                        </a>
                    </div>

                    <!-- Google Map Embed -->
                    @*<div class="mt-4">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3561.123456789!2d75.7875!3d26.9124!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x123456789abcdef!2sTAT%20Kim%20Jewellers!5e0!3m2!1sen!2sin!4v1695555555555!5m2!1sen!2sin" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>*@

                </div>
            </div>

        </div>
    </div>
</div>



