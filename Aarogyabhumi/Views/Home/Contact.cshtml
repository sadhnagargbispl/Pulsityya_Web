
@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cName = Convert.ToString(Session["CompName"]);
    var cAdd = Convert.ToString(Session["CompAdd"]);
    var cCity = Convert.ToString(Session["CompCity"]);
    var cPhone = Convert.ToString(Session["ContactNo"]);
    var cMobile = Convert.ToString(Session["MobileNo"]);
    var cMail = Convert.ToString(Session["CompMail"]);
    var cHours = Convert.ToString(Session["CompWorkingHours"]);
    var cFacebook = Convert.ToString(Session["FacebookUrl"]);
    var cInstagram = Convert.ToString(Session["InstagramUrl"]);
    var cTwitter = Convert.ToString(Session["TwitterUrl"]);
    var cYoutube = Convert.ToString(Session["YoutubeUrl"]);
    var cLinkedIn = Convert.ToString(Session["LinkedInUrl"]);
    var showCity = !string.IsNullOrEmpty(cCity) && cAdd.IndexOf(cCity, StringComparison.OrdinalIgnoreCase) < 0;
    var showMobile = !string.IsNullOrEmpty(cMobile) && cMobile != cPhone;
    var hasSocial = !string.IsNullOrEmpty(cFacebook) || !string.IsNullOrEmpty(cInstagram) || !string.IsNullOrEmpty(cTwitter) || !string.IsNullOrEmpty(cYoutube) || !string.IsNullOrEmpty(cLinkedIn);
}

<div class="breadcrmb">
    <img src="@Url.Content("~/theme/img/page-banner.jpg")" alt="Contact Us">
    <div class="breadcrmb-content">
        <div class="container">
            <h1>Contact Us</h1>
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/Home/Index")">Home</a></li>
                <li><a class="active">Contact Us</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="content-row">
    <div class="container">

        @if (!string.IsNullOrEmpty(cName))
        {
            <h3 class="text-center" style="margin-bottom:25px;">@cName</h3>
        }

        <div class="row">

            @if (!string.IsNullOrEmpty(cAdd) || !string.IsNullOrEmpty(cCity))
            {
                <div class="col-md-3 col-sm-6">
                    <div class="cnt-card">
                        <div class="cnt-icon"><i class="fa fa-map-marker" aria-hidden="true"></i></div>
                        <h4>Address</h4>
                        <p>
                            @Html.Raw(Html.Encode(cAdd).Replace("\n", "<br />"))
                            @if (showCity)
                            {
                                <text><br />@cCity</text>
                            }
                        </p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(cPhone) || showMobile)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="cnt-card">
                        <div class="cnt-icon"><i class="fa fa-phone" aria-hidden="true"></i></div>
                        <h4>Phone</h4>
                        @if (!string.IsNullOrEmpty(cPhone))
                        {
                            <p><a href="tel:@cPhone">@cPhone</a></p>
                        }
                        @if (showMobile)
                        {
                            <p><a href="tel:@cMobile">@cMobile</a></p>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(cMail))
            {
                <div class="col-md-3 col-sm-6">
                    <div class="cnt-card">
                        <div class="cnt-icon"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                        <h4>Email</h4>
                        <p><a href="mailto:@cMail">@cMail</a></p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(cHours))
            {
                <div class="col-md-3 col-sm-6">
                    <div class="cnt-card">
                        <div class="cnt-icon"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
                        <h4>Working Hours</h4>
                        <p>@Html.Raw(Html.Encode(cHours).Replace("\n", "<br />"))</p>
                    </div>
                </div>
            }

        </div>

        <!-- Social Media Links -->
        @if (hasSocial)
        {
            <ul class="list-inline text-center">
                @if (!string.IsNullOrEmpty(cFacebook))
                {
                    <li><a href="@cFacebook" target="_blank" rel="noopener" title="Facebook"><i class="fa fa-facebook fa-lg" aria-hidden="true"></i></a></li>
                }
                @if (!string.IsNullOrEmpty(cInstagram))
                {
                    <li><a href="@cInstagram" target="_blank" rel="noopener" title="Instagram"><i class="fa fa-instagram fa-lg" aria-hidden="true"></i></a></li>
                }
                @if (!string.IsNullOrEmpty(cLinkedIn))
                {
                    <li><a href="@cLinkedIn" target="_blank" rel="noopener" title="LinkedIn"><i class="fa fa-linkedin fa-lg" aria-hidden="true"></i></a></li>
                }
                @if (!string.IsNullOrEmpty(cTwitter))
                {
                    <li><a href="@cTwitter" target="_blank" rel="noopener" title="Twitter"><i class="fa fa-twitter fa-lg" aria-hidden="true"></i></a></li>
                }
                @if (!string.IsNullOrEmpty(cYoutube))
                {
                    <li><a href="@cYoutube" target="_blank" rel="noopener" title="YouTube"><i class="fa fa-youtube-play fa-lg" aria-hidden="true"></i></a></li>
                }
            </ul>
        }

        <!-- Contact Form (disabled) -->
        @*<div class="col-lg-6 mb-4 mb-lg-0">
            <div class="contact-form bg-white shadow rounded p-4">
                <h4 class="mb-4"><i class="fa fa-paper-plane me-2"></i> Get in Touch</h4>
                <form action="contact-form-handler.php" method="post">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="name" class="form-control" placeholder="Enter your full name" required="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="Enter your email" required="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" class="form-control" placeholder="Enter your phone number" required="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea name="message" class="form-control" rows="4" placeholder="Write your message here..." required=""></textarea>
                    </div>
                    <button type="submit" class="btn btn-dark px-4">
                        <i class="fa fa-paper-plane me-1"></i> Send Message
                    </button>
                </form>
            </div>
        </div>*@

        <!-- Google Map: URL from Web.config (GoogleMapEmbedUrl), hidden when empty -->
        @{ var mapUrl = System.Configuration.ConfigurationManager.AppSettings["GoogleMapEmbedUrl"]; }
        @if (!string.IsNullOrEmpty(mapUrl))
        {
            <div style="margin-top:25px">
                <iframe src="@mapUrl" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        }

    </div>
</div>
