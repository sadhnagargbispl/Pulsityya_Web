@model Shopinv.Models.M_ShowFranchiselist

@{
    ViewBag.Title = "FranchiseList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    #franchiseTable {
        border-collapse: collapse !important;
        width: 100%;
    }

        #franchiseTable th,
        #franchiseTable td {
            border: 1px solid #dee2e6 !important; /* Bootstrap's light gray */
            padding: 8px;
        }

        #franchiseTable thead {
            background-color: #f8f9fa; /* Light gray background for header */
        }
</style>

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<section class="osahan-listingmy-account-main-page mt-3 mb-3">
    <div class="container-fluid">
        <!-- Filter dropdown -->
        <div class="row m-0">
            <div class="col-md-4 mb-3">
                <form method="get" asp-controller="Home" asp-action="FranchiseList">
                    <label>Franchise Type</label>
                    <select name="franchiseType" class="form-control" onchange="this.form.submit()">
                        <option value="">-- All --</option>
                        @foreach (var type in Model.FranchiseType)
                        {
                            <option value="@type.GroupId" @(Request["franchiseType"] == type.GroupId.ToString() ? "selected" : "")>
                                @type.GroupName
                            </option>
                        }
                    </select>
                </form>
            </div>
        </div>
        <br /><br />
        <!-- Table content -->
        <div class="row m-0">
            <div class="col-lg-12">
                <div class="row row-cols-xl-1 row-cols-lg-1 row-cols-md-1 row-cols-1 g-3 osahan-my-orders">
                    <div class="table-responsive bg-white">
                        <table id="franchiseTable" class="table table-bordered text-center mb-0 nowrap">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Party Name</th>
                                    <th scope="col">Party Code</th>
                                    <th scope="col">Franchise Type</th>
                                    <th scope="col">Address</th>
                                    <th scope="col">State</th>
                                    <th scope="col">City</th>
                                    <th scope="col">Pin Code</th>
                                    <th scope="col">Mobile No</th>
                                    <th scope="col">MCommission</th>
                                    <th scope="col">SponsorCommission</th>
                                    <th scope="col">DistrictCommission</th>
                                    <th scope="col">DepotCommission</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Franchiselist != null && Model.Franchiselist.Count > 0)
                                {
                                    foreach (var item in Model.Franchiselist)
                                    {
                                        <tr>
                                            <td>@item.PartyName</td>
                                            <td>@item.PartyCode</td>
                                            <td>@item.GroupName</td>
                                            <td>@item.Address1</td>
                                            <td>@item.StateName</td>
                                            <td>@item.CityName</td>
                                            <td>@item.PinCode</td>
                                            <td>@item.MobileNo</td>
                                            <td>@item.MCommission</td>
                                            <td>@item.SponsorCommission</td>
                                            <td>@item.DistrictCommission</td>
                                            <td>@item.DepotCommission</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7">No records found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
    $(document).ready(function () {
        $('#franchiseTable').DataTable({
            responsive: true,
            autoWidth: false,
            pageLength: 10
        });
    });
    
</script>
