@{
    ViewBag.Title = "Legal";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // document image / file URLs come from Web.config (appSettings Doc*Url); an empty key hides the tile
    var appCfg = System.Configuration.ConfigurationManager.AppSettings;
    var certificates = new[]
    {
        new { Url = appCfg["DocIncorporationUrl"], Name = "Certificate of Incorporation" },
        new { Url = appCfg["DocRegistrationUrl"], Name = "Registration Certificate" },
        new { Url = appCfg["DocFoodSafetyUrl"], Name = "Food Safety License" },
        new { Url = appCfg["DocTrademarkUrl"], Name = "Trademark Certificate" }
    };
    var documents = new[]
    {
        new { Url = appCfg["DocArticlesUrl"], Name = "e Articles of Association" },
        new { Url = appCfg["DocMemorandumUrl"], Name = "e Memorandum of Association" }
    };
}

<style>
    /* image preview modal (its styles lived in the old ~/assets theme) */
    #cert-modal {
        display: none;
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.8);
        padding: 50px 15px 20px;
        text-align: center;
    }
    #cert-modal.open {
        display: block;
    }
    #cert-modal .cert-modal-img {
        max-width: 100%;
        max-height: 100%;
        background: #fff;
    }
    #cert-modal .cert-close {
        position: absolute;
        top: 8px;
        right: 15px;
        background: none;
        border: 0;
        color: #fff;
        font-size: 36px;
        line-height: 1;
        cursor: pointer;
    }
</style>

<div class="breadcrmb">
    <img src="@Url.Content("~/theme/img/page-banner.jpg")" alt="Compliance Documents">
    <div class="breadcrmb-content">
        <div class="container">
            <h1>Compliance Documents</h1>
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/Home/Index")">Home</a></li>
                <li><a class="active">Compliance Documents</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Modal HTML -->
<div id="cert-modal" aria-hidden="true" role="dialog">
    <button class="cert-close" aria-label="Close">&times;</button>
    <img class="cert-modal-img" alt="Certificate preview">
</div>

<div class="content-row">
    <div class="container">
        <div class="txt-page">

            <h4 class="mb-3">Compliance Documents</h4>
            <hr>

            <div class="row">
                @foreach (var doc in certificates.Where(d => !string.IsNullOrEmpty(d.Url)))
                {
                    <div class="col-md-3 col-sm-6">
                        <a href="#" class="cert-zoom doc-tile" data-src="@doc.Url">
                            <img src="@doc.Url" alt="@doc.Name">
                        </a>
                        <span class="doc-cap">@doc.Name</span>
                    </div>
                }
            </div>

            <hr>

            <div class="row">
                @foreach (var doc in documents.Where(d => !string.IsNullOrEmpty(d.Url)))
                {
                    <div class="col-md-3 col-sm-6">
                        <a href="@doc.Url" target="_blank" class="doc-tile">
                            <img src="@doc.Url" alt="@doc.Name">
                        </a>
                        <span class="doc-cap">@doc.Name</span>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<script>
    (function () {
        var links = document.querySelectorAll('.cert-zoom');
        var modal = document.getElementById('cert-modal');
        var modalImg = modal.querySelector('.cert-modal-img');
        var closeBtn = modal.querySelector('.cert-close');

        function openModal(src, alt) {
            modalImg.src = src;
            modalImg.alt = alt || '';
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
            // focus for accessibility
            closeBtn.focus();
        }

        function closeModal() {
            modal.classList.remove('open');
            modal.setAttribute('aria-hidden', 'true');
            // remove src to free memory
            setTimeout(function () { modalImg.src = ''; }, 300);
        }

        links.forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var src = link.getAttribute('data-src') || link.querySelector('img')?.src;
                var alt = link.querySelector('img')?.alt || '';
                if (src) openModal(src, alt);
            });
        });

        // Close handlers
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function (e) {
            if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('open')) {
                closeModal();
            }
        });
    })();
</script>
