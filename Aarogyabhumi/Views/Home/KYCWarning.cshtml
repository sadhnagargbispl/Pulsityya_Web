@{
    ViewBag.Title = "KYC Update Required";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contents">
    <div class="content-row">
        <div class="container">
            <div class="login-bar">
                <div class="login-col" style="text-align:center">
                    <div class="done-icon" style="background:#ffe0da;color:#c0392b"><i class="fa fa-exclamation"></i></div>
                    <h3>KYC Update Required</h3>
                    <p>
                        To continue using our services, please complete or update your
                        <strong>Know Your Customer (KYC)</strong> details.
                    </p>
                    <a href="~/Account/UpdateUserKyc" class="btn btn-sub">Go to KYC Update</a>
                </div>
            </div>
        </div>
    </div>
</section>
