@model Shopinv.Models.M_Category
@{
    string imageUrl = System.Configuration.ConfigurationManager.AppSettings["ImageUrl"];
    if (imageUrl.EndsWith("/"))
    {
        imageUrl = imageUrl.Substring(0, imageUrl.LastIndexOf("/"));
    }
}
@{ int i = 1;}
@if (Model.ShowBanner != null && Model.ShowBanner.Count() > 0)
{
    <div class="slider-banner">
        <div id="carouselId" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner" role="listbox">
                @foreach (var item in Model.ShowBanner)
                {
                    if (i == 1)
                    {
                        <div class="carousel-item active"> <img src="https://d9franchise.bisplindia.in/Uploads/@item.ImagePath" class="w-100 d-block" alt="second slide" /> </div>
                    }
                    else
                    {
                        <div class="carousel-item"> <img src="https://d9franchise.bisplindia.in/Uploads/@item.ImagePath" class="w-100 d-block" alt="second slide" /> </div>
                    }
                    i = i + 1;
                }
                @*<div class="carousel-item active"> <img src="~/assets/images/slider/2.png" class="w-100 d-block" alt="Second slide" /> </div>
                    <div class="carousel-item"> <img src="~/assets/images/slider/3.png" class="w-100 d-block" alt="Second slide" /> </div>*@

            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>


}
