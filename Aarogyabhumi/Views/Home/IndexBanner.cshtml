@model Shopinv.Models.M_Category
@{
    string imageUrl = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["ImageUrl"]);
    if (imageUrl.EndsWith("/"))
    {
        imageUrl = imageUrl.Substring(0, imageUrl.LastIndexOf("/"));
    }
}
@*
    Demo slider (demo/inc/slider.asp). theme/js/layout.js initialises .slide-carousel.
    No static fallback: the demo hero-banner-0x.jpg images carry another brand's logo,
    so nothing is rendered when there are no banners in the DB.
*@
@if (Model != null && Model.ShowBanner != null && Model.ShowBanner.Count() > 0)
{
    <section class="slider">
        <div class="owl-carousel slide-carousel">
            @foreach (var item in Model.ShowBanner)
            {
                var src = imageUrl + "/" + (item.ImagePath ?? "").TrimStart('/');
                <div class="slide"><img src="@src" alt="@item.BannerName" /></div>
            }
        </div>
    </section>
}
