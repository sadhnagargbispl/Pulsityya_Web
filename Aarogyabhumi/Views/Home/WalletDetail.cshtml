@model Shopinv.Models.M_WalletDetail
@{
    ViewBag.Title = "Wallet Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrmb plain">
    <div class="breadcrmb-content">
        <div class="container">
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/")">Home</a></li>
                <li><a class="active">Wallet Detail</a></li>
            </ul>
        </div>
    </div>
</div>
<!--  -->
<div class="content-row">
    <div class="my-account">
        <div class="container">
            <div class="wallet-dtl">
                <div class="row">
                    <div class="col-lg-3 col-sm-4 col-xs-8">
                        <div class="form-group">
                            <select id="wallettype" class="form-control">
                                @if (Model.m_GetWallettypes != null)
                                {
                                    foreach (var item in Model.m_GetWallettypes)
                                    {
                                        <option value="@item.Actype">@item.WalletName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-sm-2 col-xs-4">
                        <a href="javascript:void(0);" onclick="GetWalletDetail()" class="btn btn-sub"><span>Search</span></a>
                    </div>
                </div>
            </div>
            <!-- balance + ledger : replaced by /Home/GetWalletDetail (WalletDetail_partail) -->
            <div id="Grdwallet">
                @Html.Partial("WalletDetail_partail", Model)
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        function GetWalletDetail() {
            var wallettype = $("#wallettype").val();
            $.ajax({
                type: "Post",
                url: '/Home/GetWalletDetail',
                dataType: "Json",
                data: { wallettype: wallettype },
                success: function (data) {
                    $('#Grdwallet').html(data.tblOrder);
                }
            });
        }
    </script>
}
