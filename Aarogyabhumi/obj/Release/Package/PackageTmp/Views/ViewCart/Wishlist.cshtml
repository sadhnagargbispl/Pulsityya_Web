@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "Wishlist";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">
    function SaveToWishlist(pcode) {
        var r = confirm("Are you sure?")
        if (r == true) {
            $.ajax({
                type: "POST",
                url: '/ProductDetail/SaveToWishlist',
                async: false,
                dataType: "Json",
                data: { ProductID: pcode },
                success: function (data) {
                    alert(data.msg);
                    window.location.reload();
                }
            });
        }
    }
</script>


@{ Html.RenderAction("OfferBanner", "Home");}




<div class="products-details-area bg-white ">
    <div class="container my-4">
        <div class="shop-details-content pl-0">

            <div class="card shadow-lg border-0 rounded-3 p-2">
                <div class="row g-0">
                    <div class="col-12 p-3">

                        <h5 class="fw-bold mb-3">Wishlist Details</h5>

                        <div class="table-responsive">
                            <table class="table table-bordered shadow-sm align-middle mb-0" id="cartTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Details</th>
                                        <th>Price</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <!-- Product Row 1 -->
                                    @if (Model.CartDetail != null && Model.CartDetail.Count() > 0)
                                    {
                                        foreach (var item in Model.CartDetail)
                                        {
                                            <tr>
                                                <td>
                                                    <img src="@item.imagePath"
                                                         alt="@item.ProdName"
                                                         class="img-fluid rounded"
                                                         style="max-width: 90px;">
                                                </td>
                                                <td>
                                                    <h6 class="fw-bold mb-1">@item.ProdName</h6>
                                                    <p class="mb-0">
                                                        @if (item.Stockqty != 0)
                                                        {
                                                            <span class="badge bg-success">In Stock</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Sold Out</span>
                                                        }
                                                        |
                                                        <span class="text-muted">SKU: @item.ProdId</span>
                                                    </p>
                                                    @*<small><b>Size:</b> 22 INC</small>*@
                                                </td>
                                                <td>
                                                    <span class="h6 text-success fw-bold">₹ @item.prodprice</span><br>
                                                    <del class="text-muted small">₹@item.MRP</del><br>
                                                    @*<span class="text-danger small">Save ₹</span>*@
                                                </td>
                                                <td>
                                                    <button class="btn btn-danger btn-sm btn-remove" onclick="SaveToWishlist(@item.ProdId)">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }



                                </tbody>
                            </table>
                        </div>

                    </div>



                </div>


            </div>


        </div>
    </div>
</div>
