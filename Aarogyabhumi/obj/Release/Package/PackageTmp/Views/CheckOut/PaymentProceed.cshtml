<section class="contents">
    <div class="breadcrmb">
        <img src="~/theme/img/page-banner.jpg" alt="Payment">
        <div class="breadcrmb-content">
            <div class="container">
                <h1>Payment</h1>
                <ul class="breadcrmb-loc">
                    <li><a href="~/Home/Index">Home</a></li>
                    <li><a href="~/ViewCart/ViewCart">Cart</a></li>
                    <li><a class="active">Payment</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="content-row">
        <div class="container">
            <div class="cart-row">
                <h5>Select Payment Method</h5>

                <div class="row">
                    <!-- payment method list -->
                    <div class="col-xs-12 col-sm-4">
                        <div class="pay-methods" id="v-pills-tab" role="tablist">
                            <button class="pay-method active" id="v-pills-my-address-tab" data-toggle="pill" data-target="#v-pills-my-address" type="button">
                                <i class="fa fa-money"></i> Shopping Wallet
                            </button>
                            <button class="pay-method" id="v-pills-my-order-tab" data-toggle="pill" data-target="#v-pills-my-order" type="button" role="tab">
                                <i class="fa fa-credit-card"></i> Payment Gateway
                            </button>
                        </div>
                    </div>

                    <!-- panes -->
                    <div class="col-xs-12 col-sm-8">
                        <div class="tab-content" id="v-pills-tabContent">

                            <div class="tab-pane fade in active" id="v-pills-my-address" role="tabpanel">
                                <div class="price-lst-smry">
                                    <ul>
                                        <li>
                                            <span class="lft">Shopping Wallet Fund</span>
                                            <span class="rght"><b id="spnShoppingFund">Rs. 0.00/-</b></span>
                                        </li>
                                        <li id="divrepurchase" style="display:none">
                                            <span class="lft">Repurchase Wallet Fund</span>
                                            <span class="rght"><b id="spnRepurchaseFund">Rs. 0.00/-</b></span>
                                        </li>
                                    </ul>

                                    <div class="form-group">
                                        <label>Total Amount</label>
                                        <input readonly type="text" id="Amount" class="form-control" placeholder="Amount" value="@Session["totalamount"]">
                                    </div>

                                    <button type="button" onclick="SaveProceed()" class="btn btn-sub btn-order" id="walletpaybtn">Pay Now</button>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="v-pills-my-order" role="tabpanel">
                                <div class="price-lst-smry">
                                    <div class="form-group">
                                        <label>Amount payable</label>
                                        <input type="text" name="pgamount" id="pgamount" readonly class="form-control" placeholder="Amount">
                                        <input type="hidden" id="pgorderid" />
                                    </div>
                                    <button type="button" id="pgpayBtn" class="btn btn-sub btn-order">Pay Now</button>
                                </div>
                            </div>

                            <!-- offline / cashfree pane - its tab trigger is disabled, kept for reference -->
                            <div class="tab-pane fade" id="v-pills-my-offlineorder" role="tabpanel">
                                <div class="price-lst-smry">
                                    <div class="form-group">
                                        <label>Total Amount</label>
                                        <input type="text" readonly value="@String.Format("{0:N2}", totalnetpay)" name="pgamount" class="form-control">
                                    </div>
                                    <button type="button" class="btn btn-sub btn-order" onclick="CashfreeInitiate()">
                                        <i class="fa fa-paper-plane"></i>&nbsp; Submit Payment
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <ul class="smry-nte">
                    <li>Your payment is processed over a secure connection.</li>
                    <li>Do not refresh or close this page while the payment is in progress.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    // Bootstrap 3's tab plugin moves .active onto the parent <li>; these triggers
    // are plain buttons, so highlight the selected method ourselves.
    $(document).on('click', '.pay-methods .pay-method', function () {
        $('.pay-methods .pay-method').removeClass('active');
        $(this).addClass('active');
    });
</script>
