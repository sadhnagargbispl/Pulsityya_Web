@model Shopinv.Models.M_Category
@*
    Product grid of the listing page (demo/product-list.asp .itm-lst).
    - Rendered inline by CategoryList.cshtml (initial list).
    - Returned as HTML by CategoryListController.HighToLowSrchProduct /
      LowToHighSrchProduct; CategoryList.cshtml injects it into #divFilterProduct.
    .range_price_item is read by theme/js/item_filter.js (price slider).
*@
@{
    var products = Model.SrchFilterProductList ?? Enumerable.Empty<Shopinv.Entity.E_Product>();
    var productCount = products.Count();
}
<div class="itm-lst" data-count="@productCount">
    <div class="row">
        @if (productCount > 0)
        {
            foreach (var item in products)
            {
                <div class="col-xs-6 col-sm-4 col-item" data-listing-price="@item.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-id="@item.ProdId">
                    <input type="hidden" class="range_price_item" value="@((int)Math.Floor(item.Price))" />
                    @Html.Partial("_ProductCard", item)
                </div>
            }
        }
        else
        {
            <div class="col-xs-12">
                <div class="no-product">
                    <p>
                        No products found
                        <span>We couldn't find any products here. Try another category or search term, or <a href="@Url.Action("CategoryList", "CategoryList")">view all products</a>.</span>
                    </p>
                </div>
            </div>
        }
    </div>
</div>
