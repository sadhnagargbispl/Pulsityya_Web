@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "CategoryList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">
    $(document).ready(function () {
        debugger;
        $('#sorting').change(function () {
            debugger;
            var Selected = $("#sorting").val();
            if (Selected == "LH") {
                LowToHigh();
            }
            else {
                HighToLow();
            }
        });
    });

    function HighToLow() {
        $.ajax({
            type: "POST",
            url: '/CategoryList/HighToLowSrchProduct',
            async: false,
            dataType: "html",
            data: {},
            success: function (data) {
                debugger;
                $("#divFilterProduct").html('');
                $("#divFilterProduct").html(data);
            }

        });
        return false;
    }

    function LowToHigh() {
        $.ajax({
            type: "POST",
            url: '/CategoryList/LowToHighSrchProduct',
            async: false,
            dataType: "html",
            data: {},
            success: function (data) {
                debugger;
                $("#divFilterProduct").html('');
                $("#divFilterProduct").html(data);
            }

        });
        return false;
    }
</script>
<div class="mini-banner bg-success py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">
            </div>
        </div>
    </div>
</div>
<!-- Shop Category Section Start -->
<div class="products-details-area bg-white ">
    <div class="container-fluid my-5">

        <div class="row my-0">
            <div class="d-lg-none d-flex justify-content-end mb-3"> <button class="btn btn-outline-dark" id="filterToggle"> <i class="fa fa-filter"></i> Filters </button> </div>

            <div class="col-lg-3 col-md-5 col-12 mb-3">
                <div class="booking-item-dates-change p-3 border-0 shadow sidebar-filters" id="SideBar">

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="m-3">
                            <h5 class="fw-6 mb-0">Filter</h5>
                        </div>
                        <button class="btn btn-sm btn-outline-dark mt-3 d-lg-none" style="height: 30px;" id="closeSidebar">
                            Close <i class="fa fa-times"></i>
                        </button>
                    </div>

                    @{ Html.RenderAction("GetCategorySideBar", "CategoryList");}
                </div>
            </div>


            <div class="col-lg-9 col-md-7 col-12" id="divFilterProduct">
                <div class="row g-0 mb-1">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="results">
                            @if (Model.ProductList != null && Model.ProductList.Count() > 0)
                            {
                                <p>Showing: @Model.ProductList.Count() Results</p>
                            }
                            else
                            {
                                <p>Showing: 0 Results</p>
                            }
                        </div>
                        <div class="shortby">
                            <label for="sorting" class="me-2">Sort by:</label>
                            <select id="sorting" class="form-select form-select-sm d-inline-block w-auto">
                                <option value="" selected>Default</option>
                                <option value="LH">Price: Low to High</option>
                                <option value="HL">Price: High to Low</option>
                            </select>
                        </div>
                    </div>

                    <hr>

                    @foreach (var product in Model.ProductList)
                    {
                        <div class="col-lg-3 col-sm-6 col-6 aos-init aos-animate" data-aos="fade-up" data-aos-duration="2000">
                            <div class="item">
                                <input type="hidden" id="hdnprodname" value="@product.ProductName" />
                                <input type="hidden" id="hdnimage" value="@product.ImagePath" />
                                <input type="hidden" id="hdnprodid" value="@product.ProdId" />
                                <input type="hidden" id="hdnBunchQty" value="@product.BunchQty" />
                                <input type="hidden" id="hdnBv" value="@product.BV" />
                                <input type="hidden" id="hdnMRP" value="@product.MRP" />
                                <input type="hidden" id="hdnprice" value="@product.Price" />
                                <input type="hidden" id="hdnPV" value="@product.PV" />
                                <input type="hidden" id="hdnWeight" value="@product.Weight" />
                                <input type="hidden" id="hdnGst" value="@product.Gst" />
                                <input type="hidden" id="hdnStcok" value="@product.StockQTY" />
                                <div class="card border-1 shadow-sm pb-0 p-1 m-1">
                                    <div class="shop-image text-center">
                                        <a href="~/ProductDetail/ProductDetail?ProdId=@product.ProdId"> <img src="@product.ImagePath" alt="@product.ProductName" class="img-fluid rounded"></a>
                                    </div>
                                    <div class="content text-center mt-3">
                                        <h6 class="fw-bold">@product.ProductName </h6>
                                        <div class="price mb-2">
                                            <span class="text-muted text-decoration-line-through me-2">₹@product.MRP</span>
                                            <span class="fw-bold text-success">₹@product.Price</span>
                                        </div>

                                        <div class="rating mt-0 pb-2" style="font-size: 0.5rem;">
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star"></span>
                                            <span class="fa fa-star"></span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }


                    <!-- Product Info -->
                </div>
                <!-- Product Row -->
            </div>
        </div>
    </div>
</div>



<!-- Shop Category Section Start -->

<script>
    const sidebar = document.getElementById("SideBar");
    document.getElementById("filterToggle").addEventListener("click", function () {
        sidebar.classList.add("active");
    });
    document.getElementById("closeSidebar").addEventListener("click", function () {
        sidebar.classList.remove("active");
    });
</script>