@model Shopinv.Models.M_Category
@using Shopinv.Entity;
@*
    Category list of the listing sidebar (demo/product-list.asp .itm-ct-lst).
    Rendered by CategoryListController.GetCategorySideBar via Html.RenderAction
    inside the .mb-fltr-col drawer of CategoryList.cshtml.
*@
@{
    var Category = Session["DDLCategory"] as IEnumerable<E_Category>;
    var currentCat = (Request.QueryString["CatName"] ?? "").Trim();
}
<p class="ct-head">Browse Categories</p>
<div class="itm-ct-lst">
    <ul>
        <li><a href="@Url.Action("CategoryList", "CategoryList")" class="@(string.IsNullOrEmpty(currentCat) ? "active" : null)">All Products</a></li>
        @if (Category != null)
        {
            foreach (var Cat in Category)
            {
                var isActive = !string.IsNullOrEmpty(currentCat)
                               && string.Equals(currentCat, Convert.ToString(Cat.CatName).Trim(), StringComparison.OrdinalIgnoreCase);
                <li><a href="@Url.Action("CategoryList", "CategoryList", new { CatName = Cat.CatName })" class="@(isActive ? "active" : null)">@Cat.CatName</a></li>
            }
        }
    </ul>
</div>
