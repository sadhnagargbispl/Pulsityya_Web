@using Shopinv.Entity
@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "CheckOrder";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="offcanvas offcanvas-bottom border-0 h-100 show" tabindex="-1" id="orderconfirm">
    <div class="offcanvas-body d-flex align-items-center justify-content-center">
        <div class="text-center w-100 px-3">
            <!-- Success Image -->
            <img src="img/resources/successfull.png" alt="" class="img-fluid w-25 mb-3" style="max-width: 100px;">

            <h5 class="fw-bold pt-2 mb-1 lh-base">Your Order Is Received! Delivery Soon</h5>
            <p class="small">"Your order has been successfully received! We’re preparing it for delivery and will ship soon."</p>
            <hr>

            <div class="container my-4">
                <div class="row">
                    <h4 class="mb-3 fw-bold text-center">My Orders</h4>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Product Name</th>
                                    <th>MRP</th>
                                    <th>Price</th>
                                    <th>BV</th>
                                    <th>Utr No</th>
                                    <th>Status</th>
                                    <th>Order Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderNoDetail)
                                {
                                    <tr>
                                        <td>
                                            <a href="javascript:void(0);">
                                                <img src="@item.ImagePath" alt="Product" width="60">
                                            </a>
                                        </td>
                                        <td>@item.ProductName</td>
                                        <td><del class="text-danger"><i class="fa fa-inr"></i> @item.MRP</del></td>
                                        <td class="text-success"><i class="fa fa-inr"></i> @item.Price</td>
                                        <td class="text-primary">@item.BV</td>
                                        <td>#@item.Transid</td>
                                        <td><span class="badge bg-success">Pending</span></td>
                                        <td>@item.orderdate</td>
                                    </tr>
                                }
                                <!-- Repeat <tr> for other orders -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
                <a href="~/Home/Myorders" class="btn fw-bold py-2 px-4 btn-danger rounded-pill btn-sm">View Order</a>
                <a href="~/Home/index" class="btn fw-bold py-2 px-4 btn-danger-confirm rounded-pill btn-sm">Continue Shopping</a>
            </div>
        </div>
    </div>
</div>

