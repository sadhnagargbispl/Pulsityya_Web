@model Shopinv.Models.M_Changepassword
@{
    ViewBag.Title = "Change Login Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (ViewBag.passerr != null)
{
    if (ViewBag.passerr == "Change")
    {
        <script type="text/javascript">
            alert('Password changed successfully.');
            window.location.href = "/Account/LogOff";
        </script>
    }
    else
    {
        <script type="text/javascript">
            alert('@ViewBag.passerr');
        </script>
    }
}

<section class="contents">
    <div class="content-row">
        <div class="container">
            <div class="login-bar">
                <div class="login-col">
                    <h3>Change Login Password</h3>
                    <p>Choose a strong password you have not used before.</p>

                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "registerForm" }))
                    {
                        <div class="form-group">
                            <label>Old Password</label>
                            @Html.TextBoxFor(m => m.passwd, new { @id = "passwd", @placeholder = "Enter old password", @class = "form-control", @required = "required" })
                            <span id="spid" class="text-success"></span>
                        </div>

                        <div class="form-group">
                            <label>New Password</label>
                            @Html.TextBoxFor(m => m.npasswd, new { @id = "name", @placeholder = "Enter new password", @class = "form-control", @required = "required" })
                        </div>

                        <input type="submit" id="signupbtn" value="Change Password" class="btn btn-sub" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>
