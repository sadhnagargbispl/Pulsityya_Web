    @model Shopinv.Models.M_Complaint
    @{
        ViewBag.Title = "TicketList";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <!-- Mini Banner (Green Offer Bar) -->
    <div class="mini-banner bg-success py-3">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 text-center">

                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function ShowReply(complaintid) {
            $.ajax({
                type: "Post",
                url: '/Account/GetComplaintReplyDetails',
                dataType: "Json",
                data: { complaintid: complaintid },
                success: function (data) {
                    $('#GrdOrderNo').html(data.tblOrder);
                    $('#myModal').modal('show');
                }
            });
        }
    </script>


    <section class="osahan-listingmy-account-main-page mt-3 mb-3">
        <div class="container">
            <div class="row m-0">
                <div class="col-lg-12">
                    <div class="row row-cols-xl-1 row-cols-lg-1 row-cols-md-1 row-cols-1 g-3 osahan-my-orders">
                        <div class="table-responsive bg-white">
                            <table class="table table-bordered text-center mb-0 nowrap">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Complaint No</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Complaint</th>
                                        <th scope="col">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.complaintdetail != null && Model.complaintdetail.Count > 0)
                                    {
                                        foreach (var item in Model.complaintdetail)
                                        {
                                            <tr>
                                                <td>@item.complaintid</td>
                                                <td>@item.complaintdate</td>
                                                <td>@item.complaint</td>
                                                <td>
                                                    <a class="btn btn-rounded" href="javascript:void(0)" onclick="ShowReply('@item.complaintid')">View Reply</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="modal modal-lg fade quick-view-product" id="myModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="title">Complaint Reply Detail</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="single-product-thumb" id="GrdOrderNo">
                        <div class="row">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

