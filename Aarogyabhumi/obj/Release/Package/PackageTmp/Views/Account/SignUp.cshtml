@model Shopinv.Models.RegisterUser
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Company details come from m_companymaster (put in Session by CompanyDetail.GetCompanydetail()).
    string compName = Convert.ToString(Session["CompName"]);
    string compTitle = Convert.ToString(Session["CompTitle"]);
    if (string.IsNullOrWhiteSpace(compTitle)) { compTitle = compName; }
    if (string.IsNullOrWhiteSpace(compName)) { compName = compTitle; }
    if (string.IsNullOrWhiteSpace(compTitle)) { compTitle = "Company"; compName = "Company"; }
    string compAdd = Convert.ToString(Session["CompAdd"]);
    string compCity = Convert.ToString(Session["CompCity"]);
    string compAddress = (compAdd ?? "").Trim();
    if (!string.IsNullOrWhiteSpace(compCity))
    {
        compAddress = compAddress.Length > 0 ? compAddress + ", " + compCity.Trim() : compCity.Trim();
    }
    string compMail = Convert.ToString(Session["CompMail"]);
    string compContact = Convert.ToString(Session["ContactNo"]);
    string compWeb = Convert.ToString(Session["WebSite"]);
    if (string.IsNullOrWhiteSpace(compWeb)) { compWeb = Request.Url.Host; }
}
@{ Html.RenderAction("OfferBanner", "Home");}

@section styles {
    <style>
        .rgstr-col .rg-req {
            color: #c0392b;
        }

        .rgstr-col .rg-box {
            background: #f7faf8;
            border: 1px solid #e6ece8;
            border-radius: 5px;
            padding: 15px 15px 0;
            margin-bottom: 20px;
        }

        .rgstr-col .rg-box-title {
            color: #176a3a;
            font-weight: 700;
            margin-bottom: 8px !important;
        }

            .rgstr-col .rg-box-title .fa {
                margin-right: 6px;
            }

        .login-bar .rgstr-col p.rg-note {
            color: #888;
            font-size: .9em;
            margin: 0 0 15px !important;
        }

        .rgstr-col .rg-radio-line {
            padding-top: 9px;
        }

        .rgstr-col #spid.text-success {
            display: block;
            font-size: .85em;
            font-weight: 600;
            margin-top: 4px;
        }

        /* Aadhaar upload */
        .rgstr-col .rg-upload-box {
            background: #fff;
            border: 1px dashed #b9d3c1;
            border-radius: 5px;
            padding: 12px;
            text-align: center;
        }

            .rgstr-col .rg-upload-box > .fa {
                display: block;
                font-size: 26px;
                color: #17944b;
                margin-bottom: 6px;
            }

            .rgstr-col .rg-upload-box .form-control {
                height: auto;
                padding: 4px 0;
            }

        .rgstr-col .rg-upload-text {
            display: block;
            color: #999;
            font-size: .85em;
        }

        .rg-preview-wrap {
            margin-top: 10px;
            padding: 10px;
            background: #fff;
            border: 1px solid #d6ecdd;
            border-radius: 5px;
        }

        .rg-preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

            .rg-preview-header span {
                color: #176a3a;
                font-weight: 600;
                font-size: 13px;
            }

                .rg-preview-header span i {
                    margin-right: 5px;
                }

        .rg-preview-remove {
            background: #c0392b;
            color: #fff;
            border: 0;
            padding: 3px 10px;
            border-radius: 3px;
            font-size: 11px;
            cursor: pointer;
        }

            .rg-preview-remove i {
                margin-right: 3px;
            }

        .rg-preview-img {
            display: block;
            width: 100%;
            height: 160px;
            object-fit: contain;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 4px;
        }

        .rg-preview-name {
            display: block;
            margin-top: 6px;
            text-align: center;
            color: #777;
            font-size: 12px;
            word-break: break-all;
        }

        .rgstr-col .rg-verify {
            text-align: center;
            padding-bottom: 15px;
        }

            .rgstr-col .rg-verify .btn {
                min-width: 170px;
            }

        .rgstr-col #aadharSection #panwait {
            display: block;
            font-weight: 700;
            margin-top: 8px;
        }

        /* terms */
        .rgstr-col .rg-terms {
            margin: 0 0 20px !important;
        }

            .rgstr-col .rg-terms input[type=checkbox] {
                vertical-align: -2px;
            }

            .rgstr-col .rg-terms label {
                cursor: pointer;
                display: inline;
            }

            .rgstr-col .rg-terms a {
                color: #17944b;
                font-weight: 700;
            }

        .rgstr-col .btn-sub[disabled] {
            opacity: .6;
            cursor: not-allowed;
        }

        /* e-contract / consumer T&C modals */
        @@media (min-width: 768px) {
            .rg-terms-modal .modal-dialog {
                max-width: 800px;
