            }
        }

        .rg-terms-modal .modal-dialog h4 {
            padding-right: 30px !important;
        }

        .rg-terms-modal .txt-page.rg-terms-body {
            border: 0;
            border-radius: 0;
            padding: 0 8px 0 0;
            max-height: 60vh;
            overflow-y: auto;
            font-size: 13.5px;
            line-height: 1.7;
        }

        .rg-terms-modal .rg-terms-foot {
            border-top: 1px solid #eee;
            margin-top: 15px;
            padding-top: 15px;
        }
