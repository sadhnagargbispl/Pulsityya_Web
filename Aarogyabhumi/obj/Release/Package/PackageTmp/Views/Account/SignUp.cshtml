<script>
    // =====================================================================
    // IMAGE COMPRESSION (NAYA) - IDs / logic me koi change nahi.
    // Yeh capture-phase listener pehle chalta hai, file ko compress karke
    // wapas same input me daal deta hai, phir aapke existing change handlers
    // (preview + OCR + submit) usi compressed file par chalte hain.
    // Isliye "compress hokar hi save" hota hai.
    // =====================================================================
    function compressImageFile(file, maxWidth, quality) {
        return new Promise(function (resolve) {

            // Sirf images compress karni hain
            if (!file || !file.type || file.type.indexOf("image/") !== 0) {
                resolve(file);
                return;
            }

            var reader = new FileReader();

            reader.onload = function (e) {

                var img = new Image();

                img.onload = function () {

                    var w = img.width;
                    var h = img.height;

                    // Bade image ko maxWidth tak resize (aspect ratio same)
                    if (w > maxWidth) {
                        h = Math.round(h * maxWidth / w);
                        w = maxWidth;
                    }

                    var canvas = document.createElement("canvas");
                    canvas.width = w;
                    canvas.height = h;

                    var ctx = canvas.getContext("2d");

                    // White background (PNG transparency ko safe banata hai)
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(0, 0, w, h);
                    ctx.drawImage(img, 0, 0, w, h);

                    canvas.toBlob(function (blob) {

                        if (!blob) {
                            resolve(file);
                            return;
                        }

                        // Agar compressed file original se choti hai tabhi use karo
                        if (blob.size >= file.size) {
                            resolve(file);
                            return;
                        }

                        var newName = (file.name || "image").replace(/\.[^.]+$/, "") + ".jpg";

                        var newFile = new File([blob], newName, {
                            type: "image/jpeg",
                            lastModified: Date.now()
                        });

                        resolve(newFile);

                    }, "image/jpeg", quality);
                };

                img.onerror = function () { resolve(file); };
                img.src = e.target.result;
            };

            reader.onerror = function () { resolve(file); };
            reader.readAsDataURL(file);
        });
    }

    function bindImageCompression(inputId) {

        var input = document.getElementById(inputId);
        if (!input) return;

        input.addEventListener("change", function (e) {

            var file = input.files && input.files[0];
            if (!file) return;

            // Re-dispatched (already compressed) event -> existing handlers ko jaane do
            if (input.dataset.vcCompressed === "1") {
                input.dataset.vcCompressed = "0";
                return;
            }

            // Original raw event -> existing jQuery handlers rok do, pehle compress
            e.stopImmediatePropagation();

            compressImageFile(file, 1280, 0.7).then(function (newFile) {

                try {
                    var dt = new DataTransfer();
                    dt.items.add(newFile);
                    input.files = dt.files;
                } catch (ex) {
                    // Purane browser fallback: original file hi rahega
                }

                input.dataset.vcCompressed = "1";

                // Ab change dobara fire karo taaki preview + OCR compressed file par chale
                input.dispatchEvent(new Event("change", { bubbles: true }));
            });

        }, true); // <-- capture phase
    }

    $(document).ready(function () {
        bindImageCompression("FrontImage");
        bindImageCompression("BackImage");
    });
    // =====================================================================

    var isOCRProcessing = false;

    $(document).ready(function () {

        // Register Button disabled on page load
        $("#signupbtn").prop("disabled", true);

        $("#panwait").hide();

    });

    function AadharVerifyAadhar() {

        if (isOCRProcessing)
            return;

        var frontFile = $("#FrontImage")[0].files[0];
        var backFile = $("#BackImage")[0].files[0];

        if (!frontFile) {
            alert("Please upload Front Aadhaar Image.");
            return;
        }

        if (!backFile) {
            alert("Please upload Back Aadhaar Image.");
            return;
        }

        isOCRProcessing = true;

        // Keep Register button disabled while OCR is running
        $("#signupbtn").prop("disabled", true);

        // Verify Button
        $("#btnVerifyAadhar")
            .prop("disabled", true)
            .removeClass("btn-dark btn-success")
            .addClass("btn-warning")
            .html('<i class="fa fa-spinner fa-spin"></i> Please Wait...');

        // Waiting Message
        $("#panwait")
            .removeClass("text-success text-danger")
            .addClass("text-primary")
            .html('<i class="fa fa-spinner fa-spin"></i> Aadhaar Verification is in progress...')
            .show();

        var formData = new FormData();
        formData.append("FrontImage", frontFile);
        formData.append("BackImage", backFile);

        $.ajax({

            url: "/Account/AadharOCR",
            type: "POST",
            data: formData,
            contentType: false,
            processData: false,

            success: function (response) {

                if (!response || response.code != 200) {

                    alert(response.message || "OCR Failed");

                    // OCR fail hone par bhi user manual bhar sakta hai -> enable check chala do
                    checkRegisterEnable();

                    $("#btnVerifyAadhar")
                        .prop("disabled", false)
                        .removeClass("btn-warning btn-success")
                        .addClass("btn-dark")
                        .html("Verify");

                    $("#panwait")
                        .removeClass("text-primary text-success")
                        .addClass("text-danger")
                        .html("❌ Aadhaar Verification Failed");

                    return;
                }

                var front = response.data.front || {};
                var back = response.data.back || {};
                if (front.name) {
                    $("#name").val(front.name).prop("readonly", true);
                }

                //if (front.name)
                //    $("#name").val(front.name);

                if (front.dob)
                    $("#dob").val(formatDob(front.dob));

                if (front.mobile)
                    $("#mobl").val(front.mobile);

                var aadhaarNo = front.aadhaarNumber || front.aadharNumber || front.aadharno;

                if (aadhaarNo)
                    $("#aadharno").val(aadhaarNo).prop("readonly", true);

                var address = back.address || back.Address || back.fullAddress || back.completeAddress;

                if (address)
                    $("#Address").val(address).prop("readonly", true);

                if (front.email)
                    $("#email").val(front.email);

                if (front.gender) {

                    if (front.gender.toUpperCase() == "MALE")
                        $("#Male").prop("checked", true);

                    if (front.gender.toUpperCase() == "FEMALE")
                        $("#Female").prop("checked", true);
                }

                if (back.state) {

                    $("#ddlStateName option").each(function () {

                        if ($(this).text().trim().toLowerCase() ==
                            back.state.trim().toLowerCase()) {

                            $(this).prop("selected", true);
                            return false;
                        }

                    });

                    $("#ddlStateName").trigger("change");
                }

                if (back.pinCode)
                    $("#txtPinCode").val(back.pinCode);

                if (back.city)
                    $("#txtCity").val(back.city);

                if (back.district)
                    $("#txtDistrict").val(back.district);

                // Aadhaar Verified
                $("#btnVerifyAadhar")
                    .removeClass("btn-warning")
                    .addClass("btn-success")
                    .html('<i class="fa fa-check"></i> Verified')
                    .prop("disabled", true);

                // OCR se fields bhar gaye -> enable check chala do
                checkRegisterEnable();

                $("#panwait")
                    .removeClass("text-primary text-danger")
                    .addClass("text-success")
                    .html("✔ Aadhaar Verified Successfully");

            },

            error: function () {

                // Error par bhi user manual bhar sakta hai -> enable check chala do
                checkRegisterEnable();

                $("#btnVerifyAadhar")
                    .prop("disabled", false)
                    .removeClass("btn-warning btn-success")
                    .addClass("btn-dark")
                    .html("Verify");

                $("#panwait")
                    .removeClass("text-primary text-success")
                    .addClass("text-danger")
                    .html("❌ OCR API Error");
            },

            complete: function () {

                isOCRProcessing = false;

            }
        });
    }

    // Called by the Aadhaar image change handlers below but never defined anywhere in the
    // project; kept as a no-op so those handlers do not throw. OCR runs from the Verify button.
    function triggerOCRIfBothUploaded() { }

    function formatDob(dob) {

        if (!dob)
            return "";

        if (dob.indexOf("/") > -1) {

            var p = dob.split("/");

            if (p.length == 3)
                return p[2] + "-" + p[1].padStart(2, '0') + "-" + p[0].padStart(2, '0');
        }

        return dob;
    }


    $(document).ready(function () {

        // Front Image Preview
        $("#FrontImage").change(function () {

            if (this.files && this.files[0]) {

                var reader = new FileReader();

                reader.onload = function (e) {
                    $("#frontPreview").attr("src", e.target.result);
                    $("#frontFileName").text($("#FrontImage")[0].files[0].name);
                    $("#frontPreviewWrap").removeClass("d-none");
                };

                reader.readAsDataURL(this.files[0]);
            }

            triggerOCRIfBothUploaded();
        });

        // Back Image Preview
        $("#BackImage").change(function () {

            if (this.files && this.files[0]) {

                var reader = new FileReader();

                reader.onload = function (e) {
                    $("#backPreview").attr("src", e.target.result);
                    $("#backFileName").text($("#BackImage")[0].files[0].name);
                    $("#backPreviewWrap").removeClass("d-none");
                };

                reader.readAsDataURL(this.files[0]);
            }

            triggerOCRIfBothUploaded();
        });

    });
    $(document).on("click", "#frontRemoveBtn", function () {

        $("#FrontImage").val("");
        $("#frontPreview").attr("src", "");
        $("#frontFileName").text("");
        $("#frontPreviewWrap").addClass("d-none");

    });

    $(document).on("click", "#backRemoveBtn", function () {

        $("#BackImage").val("");
        $("#backPreview").attr("src", "");
        $("#backFileName").text("");
        $("#backPreviewWrap").addClass("d-none");

    });
    $(document).ready(function () {

        toggleAadharSection();

        $("input[name='userType']").change(function () {
            toggleAadharSection();
        });

    });

    function toggleAadharSection() {

        var userType = $("input[name='userType']:checked").val();

        if (userType == "D") {

            $("#aadharSection").show();

            // Direct Seller -> Aadhaar images ab OPTIONAL (image ho ya na ho process na ruke)
            $("#FrontImage, #BackImage").prop("required", false);

            // Direct Seller -> Aadharno & Address visible + required
            $("#aadharnodiv, #addressdiv").show();
            $("#aadharno, #Address").prop("required", true);

        } else {

            $("#aadharSection").hide();

            // Customer -> required hata do, varna hidden required field submit block kare
            $("#FrontImage, #BackImage").prop("required", false);

            // Customer -> Aadharno & Address hide + required hata do
            $("#aadharnodiv, #addressdiv").hide();
            $("#aadharno, #Address").prop("required", false);

            // Clear uploaded files
            $("#FrontImage").val("");
            $("#BackImage").val("");

            // Hide preview
            $("#frontPreviewWrap").addClass("d-none");
            $("#backPreviewWrap").addClass("d-none");

            // Clear preview image
            $("#frontPreview").attr("src", "");
            $("#backPreview").attr("src", "");

            $("#frontFileName").text("");
            $("#backFileName").text("");
        }

        // Section toggle hone par button state dobara check karo
        checkRegisterEnable();
    }

    // =====================================================================
    // REGISTER BUTTON ENABLE LOGIC
    // Direct Seller ke liye: image upload karke bhi, ya manual details
    // (Name, Aadhaar No, Email, Mobile, Address, Sponsor ID) bhar ke bhi
    // register kar sakta hai. Image zaroori NAHI -> OCR ke bina bhi enable.
    // Customer ke liye: hamesha enabled.
    // =====================================================================
    function checkRegisterEnable() {

        var userType = $("input[name='userType']:checked").val();

        // Customer -> hamesha enabled (image/aadhaar ki zaroorat nahi)
        if (userType == "P") {
            $("#signupbtn").prop("disabled", false);
            return;
        }

        // Direct Seller -> yeh sab manually ya OCR se bhare hone chahiye
        var name = $.trim($("#name").val());
        var aadharno = $.trim($("#aadharno").val());
        var email = $.trim($("#email").val());
        var mobl = $.trim($("#mobl").val());
        var address = $.trim($("#Address").val());
        var referralid = $.trim($("#referralid").val());

        if (name !== "" && aadharno !== "" && email !== "" &&
            mobl !== "" && address !== "" && referralid !== "") {
            $("#signupbtn").prop("disabled", false);   // image ho ya na ho, enable
        } else {
            $("#signupbtn").prop("disabled", true);
        }
    }

    $(document).ready(function () {

        // In fields me kuch bhi type/change hone par dobara check karo
        $(document).on("input change",
            "#name, #aadharno, #email, #mobl, #Address, #referralid",
            checkRegisterEnable);

        // Direct/Customer switch par bhi check
        $(document).on("change", "input[name='userType']", checkRegisterEnable);

        // Page load par ek baar
        checkRegisterEnable();
    });
</script>
<script type="text/javascript">
    var message = '@ViewBag.msg';
    if (message) {
        alert(message);
    }

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode == 46) {
            return true;
        }
        else if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
    function validateEmail(email) {
        var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        return emailRegex.test(email);
    }
    function GetSponsor() {

        var referralid = $("#referralid").val();
        if (referralid != "" || referralid != null) {
            $.ajax({
                type: "GET",
                url: "/Account/GetSponsorid",
                async: true,
                data: { sponsor: referralid },
                success: function (data) {
                    if (data.msg != "") {
                        $("#spid").text(data.msg)
                            .toggleClass("text-danger", data.err == "1")
                            .toggleClass("text-success", data.err != "1");
                    }
                },
                failure: function (response) {
                    console.log(response.responseText);
                },
                error: function (response) {
                    console.log(response.responseText);
                }
            });
        }
    }

    $(document).ready(function () {

        $("#signupbtn").prop("disabled", true);
        $('#fortype').val($('input[name="userType"]:checked').val());

        // Update value when radio changes
        $('input[name="userType"]').change(function () {
            if ($(this).val() == "P") {
                $("#ptc").show();
                $("#dtc").hide();
                $("#directSellerdiv").hide();
                $("#directSellerdiv :input").prop("disabled", true);
                $("#pandiv").hide();
                $("#pandiv :input").prop("disabled", true);
                $("#signupbtn").prop("disabled", false);
            }
            if ($(this).val() == "D") {
                $("#ptc").hide();
                $("#dtc").show();
                $("#directSellerdiv").show();
                $("#directSellerdiv :input").prop("disabled", false);
                $("#pandiv").hide();
                $("#pandiv :input").prop("disabled", false);
                $("#signupbtn").prop("disabled", true);
            }

            $('#fortype').val($(this).val());

            // Radio switch ke baad enable state dobara evaluate karo
            checkRegisterEnable();
        });

        $('#referralid').on('focusout', function () {
            GetSponsor();
        });

        // Page heading follows the selected registration type
        function setRegHeading() {
            $("#rgHeading").text($('input[name="userType"]:checked').val() == "P" ? "Register as a Customer" : "Become a Direct Seller");
        }
        setRegHeading();
        $('input[name="userType"]').on('change', setRegHeading);

        $('#panno').on('keypress', function (e) {
            var value = $(this).val();
            var charCode = (e.which) ? e.which : e.keyCode;

            // Allow only 10 characters
            if (value.length >= 10) {
                e.preventDefault();
                return false;
            }

            // First 5 characters should be alphabets (A-Z)
            if (value.length < 5) {
                if ((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122)) {
                    return true;
                } else {
                    e.preventDefault();
                    return false;
                }
            }

            // Next 4 characters should be digits (0-9)
            if (value.length >= 5 && value.length < 9) {
                if (charCode >= 48 && charCode <= 57) {
                    return true;
                } else {
                    e.preventDefault();
                    return false;
                }
            }

            // Last character should be an alphabet (A-Z)
            if (value.length == 9) {
                if ((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122)) {
                    return true;
                } else {
                    e.preventDefault();
                    return false;
                }
            }
        });

        // =================================================================
        // FORM SUBMIT -> AJAX (page reload NAHI hoga)
        // Validation fail hone par file inputs / preview / Verified state /
        // baaki text boxes / enabled button - sab intact rahenge.
        // Button type="submit" rehne se native required validation pehle chalti hai.
        // =================================================================
        $('#registerForm').on('submit', function (e) {
            e.preventDefault();

            var email = $("#email").val();
            if (email != "" && validateEmail(email) == false) {
                alert("Please enter valid email");
                return false;
            }

            var btn = $('#signupbtn');
            var originalText = btn.html();

            btn.prop("disabled", true)
               .html('<i class="fa fa-spinner fa-spin"></i> Please Wait...');

            // Poora form (compressed files sahit) FormData me
            var formData = new FormData(this);

            $.ajax({
                url: '/Account/SignUp',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res && res.success) {
                        window.location.href = "/Account/ResiterUserdetail?idno="
                            + res.idno + "&passw=" + res.password;
                    } else {
                        // Sirf alert. Page reload nahi hua -> kuch lose nahi hoga.
                        alert((res && res.msg) ? res.msg : "Something went wrong");
                        btn.prop("disabled", false).html(originalText);
                    }
                },
                error: function () {
                    alert("Server error. Please try again.");
                    btn.prop("disabled", false).html(originalText);
                }
            });
        });

    });
</script>

