@using PagedList
@using PagedList.Mvc
@using Shopinv.Entity
@model Shopinv.Models.M_DelistedDirectSeller
@{
    ViewBag.Title = "RegisterOfDs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //var idno = Session["IDNO"];
}


<!-- Mini Banner Section -->
<div class="mini-banner bg-success py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">
            </div>
        </div>
    </div>
</div>



<!-- Features Area -->
<div class="contact-area bg-light pt-5 pb-5">
    <div class="container">
        <div class="row align-items-start">

            <div class="col-lg-12">



                <div class="bg-white rounded-4 border shadow-sm overflow-hidden p-3">
                    <div class="p-3">

                        <div class="mb-4">
                            <h4 class="fw-bold">Register of Direct Seller</h4>
                        </div>


                        <div class="table-responsive">

                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sr. No.</th>
                                        <th>ID No.</th>
                                        <th>Name</th>
                                        <th>City</th>
                                        <th>State</th>
                                        <th>Date of Joining</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.DirectsellerReport != null && Model.DirectsellerReport.Any())
                                    {
                                        int sr = (((IPagedList)Model.DirectsellerReport).PageNumber - 1)
                                                 * ((IPagedList)Model.DirectsellerReport).PageSize;

                                        foreach (var item in Model.DirectsellerReport)
                                        {
                                            sr++;
                                            <tr>
                                                <td>@sr</td>
                                                <td>@item.MemberID</td>
                                                <td>@item.Name</td>
                                                <td>@item.City</td>
                                                <td>@item.State</td>
                                                <td>@item.DateofJoining</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-danger fw-bold">
                                                No Record Found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <style>
                                .pagination li a {
                                    class: page-link;
                                }

                                /* Actual working CSS */
                                .pagination > li > a,
                                .pagination > li > span {
                                    padding: 0.5rem 0.75rem;
                                    color: #198754;
                                    border: 1px solid #dee2e6;
                                }

                                .pagination > .active > a {
                                    background-color: #198754;
                                    border-color: #198754;
                                    color: #fff;
                                }
                            </style>
                            @if (Model.DirectsellerReport != null && Model.DirectsellerReport.Any())
                            {
                                <div class="mt-4 d-flex justify-content-center">
                                    @Html.PagedListPager(
                                        (IPagedList)Model.DirectsellerReport,
                                        page => Url.Action("RegisterOfDs", new { page }),
                                        new PagedListRenderOptions
                                        {
                                            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                                            DisplayLinkToLastPage = PagedListDisplayMode.Always,
                                            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                                            DisplayLinkToNextPage = PagedListDisplayMode.Always,

                                            MaximumPageNumbersToDisplay = 5,

                                            UlElementClasses = new[] { "pagination", "justify-content-center" },
                                            LiElementClasses = new[] { "page-item" }
                                        }
                                    )
                                </div>
                            }



                        </div>

                    </div>
                </div>



            </div>

        </div>
    </div>
</div>
