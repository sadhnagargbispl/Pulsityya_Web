@model Shopinv.Models.M_Complaint
@{
    ViewBag.Title = "GrievanceRedressalMechanism";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode == 46) {
            return true;
        }
        else if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
    function validateEmail(email) {
        var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        return emailRegex.test(email);
    }

    function SaveCompaint() {
        $("#Apply").prop('disabled', true);
        var memberid = $("#memberComplaintID").val();
        if (memberid == "") {
            alert("Please enter Complaint ID");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var Name = $("#Name").val();
        if (Name == "") {
            alert("Please enter name");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var mobileno = $("#mobileno").val();
        if (mobileno == "") {
            alert("Please enter mobileno");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var email = $("#email").val();
        if (email == "") {
            alert("Please enter email");
            $("#Apply").prop('disabled', false);
            return false;
        }
        if (email != "" && validateEmail(email) == false) {
            alert("Please enter valid email");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var complaintid = $("#complaintid").val();
        var subject = $("#subject").val();
        if (subject == "") {
            alert("Please enter subject");
            $("#Apply").prop('disabled', false);
            return false;
        }
        var description = $("#description").val();
        if (description == "") {
            alert("Please enter description");
            $("#Apply").prop('disabled', false);
            return false;
        }
        $.ajax({
            type: "Post",
            url: "/Home/SaveCompaint",
            async: true,
            data: {
                Complaintid: complaintid, Subject: subject, Email: email,
                Name: Name, Mobileno: mobileno, Description: description, memberid: memberid
            },
            success: function (data) {
                debugger;
                if (data.msg != "") {
                    alert(data.msg);
                }
                if (data.status == "OK") {
                    $("#subject").val('');
                    $("#email").val('');
                    $("#memberComplaintID").val('');
                    $("#Name").val('');
                    $("#mobileno").val('');
                    $("#description").val('');
                }
                $("#Apply").prop('disabled', false);
            },
            failure: function (response) {
                console.log(response.responseText);
                $("#Apply").prop('disabled', false);
            },
            error: function (response) {
                console.log(response.responseText);
                $("#Apply").prop('disabled', false);
            }
        });
    }

</script>
<script>
    $(document).ready(function () {

        let typingTimer;
        const doneTypingInterval = 600;

        $("#memberComplaintID").on("input", function () {

            clearTimeout(typingTimer);

            let memberId = $(this).val().trim();
            if (memberId.length < 3) return;

            typingTimer = setTimeout(function () {
                callComplaintApi(memberId);
            }, doneTypingInterval);
        });

        function callComplaintApi(memberId) {
            $.ajax({
                type: "POST",
                url: "/Home/memberdatacheck",
                data: { memberid: memberId },

                success: function (res) {
                    if (res.response === "OK") {
                        $("#Name").val(res.name);
                        $("#mobileno").val(res.mobile);
                        $("#email").val(res.email);
                    }
                    else {
                        alert("Member not found");
                        $("#email").val('');
                        $("#memberComplaintID").val('');
                        $("#Name").val('');
                        $("#mobileno").val('');
                    }
                },

                error: function (err) {
                    console.log(err);
                }
            });
        }
    });
</script>



<div class="breadcrmb">
    <img src="@Url.Content("~/theme/img/page-banner.jpg")" alt="Grievance Redressal Mechanism">
    <div class="breadcrmb-content">
        <div class="container">
            <h1>Grievance Redressal Mechanism</h1>
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/Home/Index")">Home</a></li>
                <li><a class="active">Grievance Redressal Mechanism</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="content-row">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="txt-page">
                    <div class="row mb-4">
                        <div class="col-sm-6"> <h4 class="mb-3 pull-left"> Raise Complaint </h4> </div>
                        <div class="col-sm-6"> <a href="/Home/CheckStatus" class="btn btn-success pull-right"> Check Status </a> </div>
                    </div>
                    <div class="p-3">

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Complaint ID</label>
                                    <input type="text"
                                           class="form-control"
                                           id="memberComplaintID"
                                           style="height:37px;"
                                           required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Name</label>
                                    <input type="text" class="form-control" style="height:37px;" id="Name" readonly required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Mobileno</label>
                                    <input type="text" class="form-control" style="height:37px;" onkeypress="return isNumberKey(event);" readonly id="mobileno" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" style="height:37px;" id="email" readonly required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Complaint Type</label>
                                    <select class="form-select" id="complaintid">
                                        @if (Model?.complainttype != null && Model.complainttype.Any())
                                        {
                                            foreach (var item in Model.complainttype)
                                            {
                                                <option value="@item.complaintid">@item.complaintname</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="">No Complaint Type Found</option>
                                        }

                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label class="form-label">Subject</label>
                                    <input type="text" class="form-control" style="height:37px;" id="subject" required />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="mb-4">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" id="description" required></textarea>
                                </div>
                            </div>

                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid">
                            <button type="submit" id="Apply" onclick="SaveCompaint()" class="btn btn-dark w-100 mb-2">Submit Complaint</button>

                        </div>



                    </div>
                </div>



            </div>

        </div>
    </div>
</div>
