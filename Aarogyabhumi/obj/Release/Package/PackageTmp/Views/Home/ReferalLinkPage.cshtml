@model Shopinv.Models.M_Referral
@{
    ViewBag.Title = "ReferalLinkPage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    function Copyref() {
        // Get textbox value
        var text = $("#myText").val();

        // Create a temporary input to copy from
        var tempInput = $("<input>");
        $("body").append(tempInput);
        tempInput.val(text).select();

        // Execute copy command
        document.execCommand("copy");

        // Remove temporary input
        tempInput.remove();
        alert("Left Referral Link Copied.");
    }
    function Copyrightref() {
        // Get textbox value
        var text = $("#myTextright").val();

        // Create a temporary input to copy from
        var tempInput = $("<input>");
        $("body").append(tempInput);
        tempInput.val(text).select();

        // Execute copy command
        document.execCommand("copy");

        // Remove temporary input
        tempInput.remove();
        alert("Right Referral Link Copied.");
    }
</script>

<section class="pt-4 pb-4">
    <div class="container">
        <div class="row justify-content-center align-items-center g-5">
            <div class="col-lg-7 col-sm-10 col-12">
                <div class="bg-white rounded-4 border shadow-sm overflow-hidden p-3">
                    <div class="p-3">
                        <div class="mb-lg-9 mb-4">
                            <h4 class="mb-2 fw-bold">My Referral Link</h4>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Left Referral Link</label>
                            <input type="text" id="myText" value="@Model.urlLeft" class="form-control" readonly="readonly" />
                        </div>
                        <div class="d-grid">
                            <button type="submit" id="signupbtn" onclick="Copyref()" class="btn btn-dark w-100 mb-2">Copy Left</button>
                        </div>
                        <div class="mb-4 mt-2">
                            <label class="form-label">Right Referral Link</label>
                            <input type="text" id="myTextright" value="@Model.urlright" class="form-control" readonly="readonly" />
                        </div>
                        <div class="d-grid">
                            <button type="submit" id="signupbtn" onclick="Copyrightref()" class="btn btn-dark w-100 mb-2">Copy Right</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

