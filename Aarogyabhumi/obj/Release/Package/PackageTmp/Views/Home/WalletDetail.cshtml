@model Shopinv.Models.M_WalletDetail
@{
    ViewBag.Title = "WalletDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">
    function GetWalletDetail() {
        var wallettype = $("#wallettype").val();
        $.ajax({
            type: "Post",
            url: '/Home/GetWalletDetail',
            dataType: "Json",
            data: { wallettype: wallettype },
            success: function (data) {
                $('#Grdwallet').html(data.tblOrder);
            }
        });
    }
</script>
<section class="osahan-listingmy-account-main-page mt-3 mb-3">
    <div class="container">
        <div class="row m-0">
            <div class="col-lg-4 col-8">
                <select id="wallettype" class="form-select">
                    @foreach (var item in Model.m_GetWallettypes)
                    {
                        <option value="@item.Actype">@item.WalletName</option>
                    }
                </select>
            </div>
            <div class="col-lg-4 col-4">
                <a href="javascript:void(0);" onclick="GetWalletDetail()" class="btn btn-dark  mb-2">
                    <span>Seacrh</span>
                </a>
            </div>
        </div>
        <div id="Grdwallet">
            <div class="row m-0">
                <div class="col-lg-5 py-2">
                    <div class="table-responsive bg-white">
                        <table class="table">
                            <tbody>
                                @foreach (var item in Model.walletUseDetail)
                                {
                                    <tr>
                                        <td>Credit</td>
                                        <td>:</td>
                                        <td>@item.Credit</td>
                                    </tr>
                                    <tr>
                                        <td>Debit</td>
                                        <td>:</td>
                                        <td>@item.Debit</td>
                                    </tr>
                                    <tr>
                                        <td>Balance</td>
                                        <td>:</td>
                                        <td>@item.Balance</td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
            <div class="row m-0">
                <div class="col-lg-12">
                    <div class="row row-cols-xl-1 row-cols-lg-1 row-cols-md-1 row-cols-1 g-3 osahan-my-orders">
                        <div class="table-responsive bg-white">
                            <table class="table table-bordered text-center mb-0 nowrap">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">SNo</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Voucher No.</th>
                                        <th scope="col">Remark</th>
                                        <th scope="col">Deposit</th>
                                        <th scope="col">Used</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.allWalletDetails != null && Model.allWalletDetails.Count() > 0)
                                    {
                                        foreach (var item in Model.allWalletDetails)
                                        {
                                            <tr class="">
                                                <td>@item.SNo </td>
                                                <td> @item.Date</td>
                                                <td>@item.VoucherNo</td>
                                                <td>@item.Remark</td>
                                                <td>@item.Deposit</td>
                                                <td>@item.used</td>
                                            </tr>

                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6">
                                                No Record Found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
    </div>
</section>


