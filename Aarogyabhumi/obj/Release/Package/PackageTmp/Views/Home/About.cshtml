@{
    ViewBag.Title = "About";
}
<div class="mini-banner bg-success py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">

            </div>
        </div>
    </div>
</div>
<div class="contact-area bg-light pt-5 pb-5">
    <div class="container">
        <div class="row align-items-start">

            <div class="col-lg-12">
                <div class="contact-info bg-white rounded p-4  mb-4">

                    <h4 class="mb-3 ">About us </h4>
                    <hr>
                    <p>We are a professionally managed organization backed by 17 years of rich industry experience in leadership and operations. For the past 4 years, we have been successfully operating as a registered company with a strong focus on legal, ethical, and transparent business practices.</p>
                    <p>Our goal is not just to sell products, but to build long-term trust, customer satisfaction, and sustainable income opportunities for our partners and customers.</p>
                    <p>
                        We are committed to:
                        <ul>
                            <li>Delivering high-quality, value-for-money products</li>
                            <li>Providing transparent and ethical business opportunities</li>
                            <li>Offering strong after-sales service and support</li>
                        </ul>
                    </p>
                    <p>With a vision to support Make in India, Digital India, and Atmanirbhar Bharat, we aim to empower thousands of individuals through entrepreneurship and skill-based income generation.</p>
                    <p>We believe in Experience, Ethics & Excellence.</p>
                    <br />
                    <p>@Convert.ToString(Session["CompName"])</p>
                    <p>@Convert.ToString(Session["CompAdd"])</p>
                </div>
            </div>

        </div>
    </div>
</div>