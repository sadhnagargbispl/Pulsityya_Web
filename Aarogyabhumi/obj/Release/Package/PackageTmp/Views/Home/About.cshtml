@{
    ViewBag.Title = "About us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contents">
    <div class="breadcrmb">
        <img src="~/theme/img/page-banner.jpg" alt="About us">
        <div class="breadcrmb-content">
            <div class="container">
                <h1>About us</h1>
                <ul class="breadcrmb-loc">
                    <li><a href="~/Home/Index">Home</a></li>
                    <li><a class="active">About us</a></li>
                </ul>
            </div>
        </div>
    </div>
    <!--  -->
    <div class="content-row">
        <div class="page-abt">
            <div class="sec-1st">
                <div class="container">
                    <h1 class="first-head">Welcome to Pulastya <span class="brdr"></span><span>A Better Tomorrow Together !</span></h1>
                    <p>
                        Registered under the Companies Act, 2013, the company is committed to building a transparent, ethical and
                        sustainable direct-selling ecosystem where quality products and meaningful business opportunities come together.
                        At Pulastya Globals India, we believe that a healthier lifestyle begins with informed choices and access to reliable
                        products. Our focus is on offering carefully developed health and wellness solutions while continuously working
                        towards improving product quality, customer experience and distributor support.
                    </p>
                    <p>
                        With a people-first approach, we aim to build long-term relationships with our customers and business associates
                        through trust, transparency, integrity and responsible business practices.
                    </p>
                    <p>
                        Our vision is to grow as a respected name in the direct-selling industry by creating value for customers, empowering
                        our business associates and contributing positively to the communities we serve.
                    </p>
                </div>
            </div>
            <div class="container">
                <div class="sec-2nd">
                    <div class="sec-inf">
                        <h2 class="first-head">Our Vision<span class="brdr"></span></h2>
                        <p>
                            Transparent business plant and world class products. Pulastya Globals Family is aiming to reach every house hold
                            create entrepreneur propagating health and wellness rapidly.
                        </p>
                    </div>
                    <div class="sec-inf">
                        <h2 class="first-head">Our Mission<span class="brdr"></span></h2>
                        <p>
                            We inspire for healthy living by promoting natural well-being and enable people to discover their business
                            potential. Our Topmost goal is to engage people for spreading education of preventive healthcare and lifestyle
                            thence to achieve their own corporal, mental and financial health.
                        </p>
                        <p>
                            We value high quality of research and develop products that are essential for day to day living. Our in-house team
                            of research and development follows the ideology of developing the products close to biological rhythm and nature.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
