@model Shopinv.Models.M_Profile
@{
    ViewBag.Title = "MemberProfile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .profile-header {
        /*background: linear-gradient(135deg,#0d6efd,#6610f2);*/
        color: #fff;
        border-radius: 1rem;
    }

    .info-label {
        font-size: .75rem;
        color: #6c757d;
        text-transform: uppercase
    }

    .info-value {
        font-weight: 600
    }
</style>
<div class="mini-banner bg-success py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 text-center">
            </div>
        </div>
    </div>
</div>
<div class="container py-4">

    <!-- Header -->
    <div class="profile-header p-4 mb-3 shadow-sm bg-success">
        <div class="row align-items-center">
            <div class="col-12 col-md-8">
                <h4 class="mb-1 text-white">@Model.profileres.name</h4>
                <div class="small">Member ID : <strong>@Model.profileres.idno</strong></div>
            </div>
            <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
                <span class="badge bg-success fs-6">ACTIVE</span>
            </div>
        </div>
    </div>

    <!-- Info Blocks -->
    <div class="row g-3">

        <div class="col-md-6">
            <div class="card h-100 rounded-4 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Personal Information</h6>

                    <div class="mb-2">
                        <div class="info-label">Relation</div>
                        <div class="info-value">@Model.profileres.relation</div>
                    </div>

                    <div class="mb-2">
                        <div class="info-label">Date of Birth</div>
                        <div class="info-value">@Model.profileres.dob</div>
                    </div>

                    <div class="mb-2">
                        <div class="info-label">Position</div>
                        <div class="info-value">@Model.profileres.position</div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 rounded-4 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Contact Details</h6>

                    <div class="mb-2">
                        <div class="info-label">Mobile</div>
                        <div class="info-value">@Model.profileres.mobile</div>
                    </div>

                    <div class="mb-2">
                        <div class="info-label">Phone</div>
                        <div class="info-value">@Model.profileres.phoneno</div>
                    </div>

                    <div class="mb-2">
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.profileres.email</div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 rounded-4 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Nominee Details</h6>

                    <div class="mb-2">
                        <div class="info-label">Nominee Name</div>
                        <div class="info-value">@Model.profileres.nominee</div>
                    </div>

                    <div class="mb-2">
                        <div class="info-label">Nominee Relation</div>
                        <div class="info-value">@Model.profileres.nomineerelation</div>
                    </div>

                    <div class="mb-2">
                        <div class="info-label">Prefix</div>
                        <div class="info-value">@Model.profileres.nomprefix</div>
                    </div>

                </div>
            </div>
        </div>

        @*<div class="col-md-6">
            <div class="card h-100 rounded-4 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Membership Timeline</h6>

                    <div class="mb-3">
                        <div class="info-label">Date of Joining</div>
                        <div class="info-value">@Model.profileres.dateofjoining</div>
                    </div>

                    <div>
                        <div class="info-label">Activation Date</div>
                        <div class="info-value">@Model.profileres.dateofactivation</div>
                    </div>

                </div>
            </div>
        </div>*@

    </div>

</div>


