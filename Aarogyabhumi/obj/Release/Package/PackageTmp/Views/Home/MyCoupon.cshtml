@using Shopinv.Entity
@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "MyCoupon";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var idno = Session["IDNO"];
}
<script type="text/javascript">
    function Copycoupon(coupon) {
        debugger;
        navigator.clipboard.writeText(coupon);
        alert(coupon +' coupon code copied')
    }
</script>



<section class="osahan-listingmy-account-main-page mt-3 mb-3">
    <div class="container">
        <div class="row m-0">
            <div class="col-lg-12">
                <div class="row row-cols-xl-1 row-cols-lg-1 row-cols-md-1 row-cols-1 g-3 osahan-my-orders">
                    <div class="table-responsive bg-white">
                        <table class="table table-bordered text-center mb-0 nowrap">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Coupon Code</th>
                                    <th scope="col">Amount</th>
                                    <th scope="col">Use Date</th>
                                    <th scope="col">Use In Order No.</th>
                                    
                                    <th scope="col">Issue Date</th>
                                    <th scope="col">Use Status</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model.GetCouponDetailNew)
                                {

                                    <tr class="">

                                        <td>
                                            <span id="sample">@item.CouponNo </span> &nbsp;
                                            <span>
                                                <a id="@item.CouponNo"
                                                   href="javascript:void(0);" onclick="Copycoupon(@item.CouponNo)" ><i class="fa fa-copy" aria-hidden="true"></i> </a>
                                            </span>
                                        </td>
                                        <td>@item.Amount </td>
                                        <td>@item.Useddate </td>
                                        <td>@item.Usedorderno </td>
                                       
                                        <td>@item.IssueDate </td>
                                        <td>@item.Status </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


