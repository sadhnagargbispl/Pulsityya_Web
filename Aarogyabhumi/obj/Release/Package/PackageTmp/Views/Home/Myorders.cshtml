@using Shopinv.Entity
@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var idno = Session["IDNO"];
    var showSV = Convert.ToString(Session["MemMode"]) == "D";
    var orderRows = 0;
}

<div class="breadcrmb plain">
    <div class="breadcrmb-content">
        <div class="container">
            <ul class="breadcrmb-loc">
                <li><a href="@Url.Content("~/")">Home</a></li>
                <li><a class="active">Orders</a></li>
            </ul>
        </div>
    </div>
</div>
<!--  -->
<div class="content-row">
    <div class="my-account">
        <div class="container">
            <div class="table-responsive">
                <table class="table mytable ordrtable">
                    <thead>
                        <tr>
                            <th>Order No</th>
                            <th>Order Date</th>
                            <th>Order Amount</th>
                            <th>Courier Charge</th>
                            <th>By Wallet</th>
                            <th>By Online</th>
                            @if (showSV)
                            {
                                <th>Paid SV</th>
                            }
                            <th>Dispatch Status</th>
                            <th>Remark</th>
                            <th>Pay Mode</th>
                            <th>Courier Name</th>
                            <th>Docket No</th>
                            <th>Docket Date</th>
                            <th>Track</th>
                            <th>Download Bill</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderReport != null)
                        {
                            foreach (var item in Model.OrderReport)
                            {
                                if (!string.IsNullOrEmpty(item.Orderno))
                                {
                                    orderRows++;
                                    <tr>
                                        <td>
                                            <a class="view" href="javascript:void(0)" onclick="ShowGrdOrderNo(this,'@item.Orderno','@item.status','@idno')">@item.Orderno</a>
                                        </td>
                                        <td>@item.orderdate</td>
                                        <td>@(item.OrderAmount + item.CourierCharge)</td>
                                        <td>@item.CourierCharge</td>
                                        <td>@item.Pinwallet</td>
                                        <td>@item.Chamt</td>
                                        @if (showSV)
                                        {
                                            <td>@item.BV</td>
                                        }
                                        <td>@item.status</td>
                                        <td></td>
                                        <td>@item.Mode</td>
                                        <td>
                                            @if (item.CourierName != "-- SELECT --")
                                            {
                                                @item.CourierName
                                            }
                                        </td>
                                        <td>@item.DocketNo</td>
                                        <td>
                                            @if (item.DocketDate != "01-Jan-1900")
                                            {
                                                @item.DocketDate
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Website) && item.Website != "#")
                                            {
                                                <a class="view" href="@item.Website" target="_blank"><i class="fa fa-truck"></i> Track</a>
                                            }
                                        </td>
                                        <td>
                                            @if (item.status == "Dispatched" || item.status == "Partial Dispatched")
                                            {
                                                <a class="view" href="javascript:void(0)" onclick="showbillno('@item.InvBillno','@idno','@item.status')"><i class="fa fa-download"></i> Download Bill</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        @if (orderRows == 0)
                        {
                            <tr>
                                <td colspan="@(showSV ? 15 : 14)" class="no-record">No Record Found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!--modal box : order detail (filled by /Home/SrchOrderDetail or /Home/Showofflineorderdetail)-->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="max-width: 700px;">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
            <div id="GrdOrderNo">
                @if (Model.OrderNoDetail != null && Model.OrderNoDetail.Count() > 0)
                {
                    @Html.Partial("OrderDetail", Model)
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        function showbillno(OrderId, idno, status) {
            if (status == 'Dispatched' || status == 'Partial Dispatched') {
                var url = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["InvoiceUrl"])))' + "?Pm=" + window.btoa(OrderId) + "&id=" + idno;
                window.open(url, "_blank");
            }
        }

        function ShowGrdOrderNo(obj, OrderId, status, idno) {
            var row = jQuery(obj).parents('tr:first');
            $.ajax({
                type: "Post",
                url: '/Home/SrchOrderDetail',
                dataType: "Json",
                data: { OrderId: OrderId },
                success: function (data) {
                    $('#GrdOrderNo').html(data.tblOrder);
                    $('#myModal').modal('show');
                }
            });
        }

        function Showofflineorderdetail(OrderId) {
            $.ajax({
                type: "Post",
                url: '/Home/Showofflineorderdetail',
                dataType: "Json",
                data: { OrderId: OrderId },
                success: function (data) {
                    $('#GrdOrderNo').html(data.tblOrder);
                    $('#myModal').modal('show');
                }
            });
        }
    </script>
}
