@model Shopinv.Models.M_Category
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Start Banner Area-->
@{ Html.RenderAction("IndexBanner", "Home");}
<!-- End Banner Area-->
 <!-- Start Banner Area-->
<!-- End Banner Area-->
<div class="container">

    <div class="row ">


        @if (Model.SpecialProductList != null && Model.SpecialProductList.Count() > 0)
        {
            <!-- Products Section Area -->
            <div class="best-selling-area pt-4 pb-3 bg-white" data-aos="fade-up" data-aos-duration="2000">
                <div class="container">
                    <div class="top-title-and-content">
                        <div class="row align-items-center" data-aos="fade-up" data-aos-duration="2200">
                            <div class="col-lg-6 col-sm-6 col-8">
                                <div class="title">
                                    <h2><span> POPULAR PRODUCTS </span> </h2>
                                </div>
                            </div>
                            <div class="col-lg-6 col-sm-6 col-4">
                                <div class="right-content">
                                    <a href="~/CategoryList/CategoryList" class="default-btn"><i class="fa fa-eye" aria-hidden="true"></i> View More </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="owl-carousel owl-theme">
                        @foreach (var item in Model.SpecialProductList)
                        {
                            <!-- Product Card 1 -->
                            <div class="item">
                                <div class="card border-1 shadow-sm pb-0 p-1 m-1">
                                    <div class="shop-image text-center">
                                        <a href="~/ProductDetail/ProductDetail?ProdId=@item.ProdId">
                                            <center>  <img src="@item.ImagePath" alt="@item.ProductName" class="img-fluid rounded"></center>
                                        </a>
                                    </div>
                                    <div class="content text-center mt-3">
                                        <h6 class="fw-bold">@item.ProductName</h6>
                                        <div class="price mb-2">
                                            <span class="text-muted text-decoration-line-through me-2">@item.MRP</span>
                                            <span class="fw-bold text-success">@item.Price</span>
                                        </div>

                                        <div class="rating mt-0 pb-2" style="font-size: 0.5rem;">
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star"></span>
                                            <span class="fa fa-star"></span>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        }

                    </div>

                </div>
            </div>
        }
    </div>

</div>

<!-- ABout Section Area -->

@if (Model.TopSellerProduct != null && Model.TopSellerProduct.Count() > 0)
{
    <div class="products-details-area bg-light pt-5 pb-5">
        <div class="container">
            <div class="shop-details-content pl-0">
                <div class="row align-items-center">

                    <div class="col-lg-12 aos-init aos-animate" data-aos="fade-up" data-aos-duration="2200">
                        <div class="products-details-content">
                            <div class="top-content">


                                <div class="row g-3">

                                    @foreach (var item in Model.TopSellerProduct)
                                    {
                                        <div class="col-lg-3 col-sm-6 col-6 aos-init aos-animate" data-aos="fade-up" data-aos-duration="2000">
                                            <div class="item">
                                                <div class="card border-1 shadow-sm pb-0 p-1 m-1">
                                                    <div class="shop-image text-center">
                                                        <a href="~/ProductDetail/ProductDetail?ProdId=@item.ProdId"> <img src="@item.ImagePath" alt="@item.ProductName" class="img-fluid rounded"></a>
                                                    </div>
                                                    <div class="content text-center mt-3">
                                                        <h6 class="fw-bold">@item.ProductName </h6>
                                                        <div class="price mb-2">
                                                            <span class="text-muted text-decoration-line-through me-2">₹@item.MRP</span>
                                                            <span class="fw-bold text-success">₹@item.Price</span>
                                                        </div>

                                                        <div class="rating mt-0 pb-2" style="font-size: 0.5rem;">
                                                            <span class="fa fa-star checked"></span>
                                                            <span class="fa fa-star checked"></span>
                                                            <span class="fa fa-star checked"></span>
                                                            <span class="fa fa-star"></span>
                                                            <span class="fa fa-star"></span>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}


<div class="bg-white">
    <!-- Features Area -->
    <div class="contact-area pt-5 pb-0">
        <div class="container">
            <div class="row align-items-start">
                <div class="col-lg-5"> <img src="~/assets/images/home_img.jpg" class="img-thumbnail" alt=""> </div>

                <div class="col-lg-7">
                    <div class="contact bg-white rounded p-4  mb-4">




                        <h4 class="mb-3 "> Every Deal for Smart Savings & Top-Quality Shopping </h4>
                        <hr>
                        <p class="text-darks">
                            Welcome to @Convert.ToString(Session["CompTitle"])  — a platform where quality and savings come
                            together. Our mission is to provide you with the best value in every purchase. Whether
                            you shop online or choose gift vouchers for yourself or your loved ones, Welcome to DV9
                            ensures a smart shopping experience designed for modern lifestyles.
                        </p>
                        <p class="text-darks">
                            Entertainment today is more enjoyable at home. You can relax on your
                            couch, watch your favorite movie, and order delicious snacks online — all at a great
                            price. With our exclusive savings and gift vouchers, you can make every movie night fun
                            and budget-friendly. Planning to go out? Use entertainment and cinema vouchers for a
                            seamless, smart, and pocket-friendly outing.
                        </p>

                        <hr>


                        <h5 class="mb-3 ">@Convert.ToString(Session["CompTitle"])  </h5>
                        <ul>
                            <li> Premium quality products</li>
                            <li> Best prices & exclusive offers</li>
                            <li> Instant digital gift vouchers</li>
                            <li> Trusted service and on-time delivery</li>
                        </ul>


                    </div>
                </div>



            </div>
        </div>
    </div>



</div>


<div class="bg-light">



    <div class="container py-4">
        <div class="row g-3">

            <!-- Products Section Area -->
            <div class="best-selling-area pt-4 pb-3" data-aos="fade-up" data-aos-duration="2000">
                <div class="container">
                    <div class="top-title-and-content">
                        <div class="row align-items-center" data-aos="fade-up" data-aos-duration="2200">
                            <div class="col-lg-6 col-sm-6 col-8">
                                <div class="title">
                                    <h2><span> TOP SELLER </span> </h2>
                                </div>
                            </div>
                            <div class="col-lg-6 col-sm-6 col-4">
                                <div class="right-content">
                                    <a href="~/CategoryList/CategoryList" class="default-btn"><i class="fa fa-eye" aria-hidden="true"></i> View More </a>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="owl-carousel owl-theme">
                        @foreach (var item in Model.TopSellerProduct)
                        {
                            <!-- Product Card 1 -->
                            <div class="item">

                                <div class="card border-1 shadow-sm pb-0 p-1 m-1">
                                    <div class="shop-image text-center">
                                        <a href="~/ProductDetail/ProductDetail?ProdId=@item.ProdId">
                                            <center>
                                                <img src="@item.ImagePath"
                                                     alt="@item.ProductName" class="img-fluid rounded">
                                            </center>
                                        </a>
                                    </div>
                                    <div class="content text-center mt-3">
                                        <h6 class="fw-bold">@item.ProductName</h6>
                                        <div class="price mb-2">
                                            <span class="text-muted text-decoration-line-through me-2">₹@item.MRP</span>
                                            <span class="fw-bold text-success">₹@item.Price</span>
                                        </div>

                                        <div class="rating mt-0 pb-2" style="font-size: 0.5rem;">
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star"></span>
                                            <span class="fa fa-star"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>


</div>


<!-- Modal -->
<div class="modal fade" id="onloadModal" tabindex="1" aria-labelledby="onloadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="onloadModalLabel">Welcome!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <p><strong>@Convert.ToString(Session["CompTitle"]) India Consultancy Private Limited</strong>  (“कंपनी”) यह स्पष्ट करती है कि कंपनी में भर्ती (Recruitment) की प्रक्रिया केवल कंपनी के प्रधान कार्यालय (Head Office) के माध्यम से संचालित की जाती है।</p>
                <p>कंपनी ने किसी भी व्यक्ति, एजेंट, प्रतिनिधि, फ्रेंचाइज़ी, कंसल्टेंट या किसी भी तृतीय पक्ष को भर्ती, नियुक्ति अथवा रोजगार के लिए अधिकृत नहीं किया है।</p>
                <p>कंपनी में किसी भी प्रकार का पंजीकरण शुल्क, प्रोसेसिंग शुल्क, जॉइनिंग फीस, सिक्योरिटी डिपॉजिट या अन्य कोई भी शुल्क नहीं लिया जाता। यहाँ पर उत्पाद बिक्री के बाद ही आय प्राप्त होती है|</p>
                <p>यदि कोई व्यक्ति या संस्था कंपनी के नाम का दुरुपयोग करते हुए नौकरी दिलाने के नाम पर किसी भी प्रकार की धनराशि की मांग करती है, तो वह पूर्णतः अनधिकृत एवं अवैध है। ऐसे किसी भी अनधिकृत व्यक्ति द्वारा किए गए लेन-देन, वादे या समझौते के लिए कंपनी किसी भी प्रकार से उत्तरदायी नहीं होगी।</p>
                <p>कंपनी आम जनता से अनुरोध करती है कि वे ऐसे फर्जी भर्ती प्रस्तावों, भ्रामक सूचनाओं एवं धोखाधड़ीपूर्ण लेन-देन से सावधान रहें तथा ऐसी किसी भी घटना की सूचना तुरंत कंपनी को दें।</p>
                <p>
                    कंपनी उपभोक्ता मामलों के विभाग, भारत सरकार द्वारा अधिसूचित
                    डायरेक्ट सेलिंग (Regulation) Rules, 2021 तथा
                    ई-कॉमर्स (Consumer Protection) Rules, 2020
                    का पूर्ण अनुपालन सुनिश्चित करने के लिए प्रतिबद्ध है और अपने सभी व्यावसायिक कार्य लागू कानूनों एवं नियमों के अनुसार संचालित करती है।
                </p>
                <p>इस वेबसाइट पर उपलब्ध समस्त जानकारी केवल सामान्य सूचना के उद्देश्य से प्रदान की गई है। कंपनी बिना पूर्व सूचना के किसी भी समय सामग्री में परिवर्तन करने का अधिकार सुरक्षित रखती है।</p>
                <p>
                    © @Convert.ToString(Session["CompTitle"]) India Consultancy Private Limited. All rights reserved.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        $(".owl-carousel").owlCarousel({
            loop: false,
            margin: 15,
            nav: true,
            dots: false,
            autoplay: false,
            autoplayTimeout: 3000,
            autoplayHoverPause: true,
            navText: [
                '<i class="fa fa-chevron-left"></i>',
                '<i class="fa fa-chevron-right"></i>'
            ],
            responsive: {
                0: { items: 1 },
                576: { items: 2 },
                768: { items: 3 },
                992: { items: 4 },
                1200: { items: 5 }
            }

        });
    });</script>

