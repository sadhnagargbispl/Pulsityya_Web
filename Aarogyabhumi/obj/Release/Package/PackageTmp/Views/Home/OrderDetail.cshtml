
<div class="axil-product-cart-area">
    <div class="product-table-heading">
        <h4 class="title">OrderDetail: <span id="lblOrder"></span></h4>
    </div>
    <div class="table-responsive text-nowrap carttable">
        @if (Model.OrderNoDetail != null)
        {

            <table class="table table-bordered">
                <thead>
                    <tr class="nowrap info">
                        <th>OrderNo</th>
                        <th>ProductName</th>

                        <th>Quantity</th>
                        <th>Price</th>
                        @*<th>Size</th>

                            <th>Color</th>*@
                        <th>Dispatch Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderNoDetail)
                    {
                        <tr>
                            <td>
                                @if (item.OrderId == 0)
                                {
                                    @item.Transid
                                }
                                else
                                {
                                    @item.OrderId
                                }
                            </td>
                            <td>@item.ProductName</td>

                            <td>
                                @item.Qty
                            </td>
                            <td>@item.Price</td>
                            @*<td>@item.Size</td>
                                <td>@item.Color</td>*@
                            <td>@item.DispatchQty</td>

                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <center> <p> No Record Found</p></center>
        }
    </div>
</div>
