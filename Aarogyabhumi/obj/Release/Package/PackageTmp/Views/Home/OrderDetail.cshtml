@* Order detail popup body - rendered inside #GrdOrderNo on Myorders
   (directly, and via /Home/SrchOrderDetail + /Home/Showofflineorderdetail as JSON tblOrder).
   Model is M_Category (dynamic here, as before). *@
@{
    string ordNo = "";
    if (Model != null && Model.OrderNoDetail != null)
    {
        foreach (var first in Model.OrderNoDetail)
        {
            if (first.OrderId == 0)
            {
                ordNo = Convert.ToString(first.Transid);
            }
            else
            {
                ordNo = Convert.ToString(first.OrderId);
            }
            break;
        }
    }
    var detailRows = 0;
}
<h4>Order Detail@(string.IsNullOrEmpty(ordNo) ? "" : " - Order No. #")<span id="lblOrder">@ordNo</span></h4>
<div class="table-responsive">
    @if (Model != null && Model.OrderNoDetail != null)
    {
        <table class="table mytable">
            <thead>
                <tr>
                    <th>ProductName</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Dispatch Qty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderNoDetail)
                {
                    detailRows++;
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Qty</td>
                        <td>@item.Price</td>
                        <td>@item.DispatchQty</td>
                    </tr>
                }
                @if (detailRows == 0)
                {
                    <tr>
                        <td colspan="4" class="no-record">No Record Found</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="no-record">No Record Found</p>
    }
</div>
