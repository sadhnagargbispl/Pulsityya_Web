@{
    ViewBag.Title = "Compliance Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // certificate images / documents host - configured in Web.config (CertificateUrl)
    var certBase = System.Configuration.ConfigurationManager.AppSettings["CertificateUrl"];
    var certs = new[] {
        new { File = "1.jpg", Caption = "Certificate of Incorporation" },
        new { File = "2.jpg", Caption = "Registration Certificate" },
        new { File = "3.jpg", Caption = "Food Safety License" },
        new { File = "4.jpg", Caption = "Trademark Certificate" }
    };
    var docs = new[] {
        new { File = "e_articles_of_association.pdf", Caption = "e Articles of Association" },
        new { File = "e_memorandum_of_association.pdf", Caption = "e Memorandum of Association" }
    };
}

@section styles {
    <link rel="stylesheet" href="~/theme/plugins/spotlight-master/css/spotlight.min.css">
}

<section class="contents">
    <div class="breadcrmb">
        <img src="~/theme/img/page-banner.jpg" alt="Compliance Documents">
        <div class="breadcrmb-content">
            <div class="container">
                <h1>Compliance Documents</h1>
                <ul class="breadcrmb-loc">
                    <li><a href="~/Home/Index">Home</a></li>
                    <li><a class="active">Compliance Documents</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="content-row">
        <div class="container">
            <h2 class="first-head">Certificates <span class="brdr"></span></h2>
            <div class="row">
                @foreach (var c in certs)
                {
                    <div class="col-xs-6 col-sm-4 col-md-3">
                        <a class="spotlight doc-tile" href="@(certBase + c.File)" data-title="@c.Caption">
                            <img src="@(certBase + c.File)" onerror="this.onerror=null;this.style.display='none';" alt="@c.Caption" />
                        </a>
                        <span class="doc-cap">@c.Caption</span>
                    </div>
                }
            </div>

            <h2 class="first-head">Documents <span class="brdr"></span></h2>
            <div class="row">
                @foreach (var d in docs)
                {
                    <div class="col-xs-6 col-sm-4 col-md-3">
                        <a class="doc-tile" href="@(certBase + d.File)" target="_blank">
                            <img src="@(certBase + "pdf.jpg")" onerror="this.onerror=null;this.style.display='none';" alt="@d.Caption" />
                        </a>
                        <span class="doc-cap">@d.Caption</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section scripts {
    <!-- the theme's own lightbox replaces the hand-rolled cert modal -->
    <script src="~/theme/plugins/spotlight-master/js/spotlight.min.js"></script>
}
