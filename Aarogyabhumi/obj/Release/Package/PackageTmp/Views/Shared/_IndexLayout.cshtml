<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="img/resources/favicon.png" type="image/png">
    <title>@ViewBag.Title</title>
    <!-- Css Links -->
    <link rel="stylesheet" href="~/vender/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/vender/icofont/icofont.min.css">
    <link rel="stylesheet" href="~/vender/slick/slick/slick.css">
    <link rel="stylesheet" href="~/vender/slick/slick/slick-theme.css">
    <link rel="stylesheet" href="~/css/style.css">
    <!-- Font Awasome Intro -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <script src="~/vender/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vender/jquery/jquery.min.js"></script>
</head>
<body class="bg-light">
    <div class="homepage-one-header">

        <div class="homepage-nav-one-header">
            <nav class="navbar navbar-expand-lg bg-white osahan-header shadow-sm pt-4">
                <!-- Desktop Header Section Start -->
                <!-- #include file="inc_header.asp" -->
                @{Html.RenderAction("Desktopheader", "Home");}
                <!-- Desktop Header Section End -->
            </nav>

            <nav class="navbar navbar-expand-lg navbar-light navbar-default bg-white osahan-second-nav py-0 shadow-sm pt-3">
                <!-- Mobile Header Section Start -->
                <!-- #include file="inc_mobile_header.asp" -->
                @{Html.RenderAction("Mobileheader", "Home");}
                <!-- Mobile Header Section End -->
            </nav>
        </div>

        <!-- Slider Section Start -->
        @{Html.RenderAction("IndexBanner", "Home");}
        <!-- Slider Section End -->

    </div>
    @RenderBody()

    <!-- Footer Section Start -->
    @{ Html.RenderAction("Footer","Home");}
    <!-- Footer Section End -->

    <script src="~/vender/slick/slick/slick.min.js"></script>
    <script src="~/js/quantity.js"></script>
    <script src="~/js/script.js"></script>
</body>
</html>
