@model Shopinv.Models.M_Category

@if (Model.ProductDetail != null && Model.ProductDetail.Count()>0)
{
    foreach (var item in Model.ProductDetail)
    {

        <div class="col-lg-10 order-lg-2">
            <div class="single-product-thumbnail-wrap zoom-gallery">
                <div class="single-product-thumbnail product-large-thumbnail-3 axil-product big-product">
                    <div class="thumbnail">
                        <a href=@item.ImagePath class="popup-zoom">
                            <img src=@item.ImagePath alt="Product Images">
                        </a>
                    </div>
                    @if (@item.ImagePath1 != null)
                    {
                        <div class="thumbnail">
                            <a href=@item.ImagePath1 class="popup-zoom">
                                <img src=@item.ImagePath1 alt="Product Images">

                            </a>
                        </div>
                    }
                    @if (@item.ImagePath2 != null)
                    {
                        <div class="thumbnail">
                            <a href=@item.ImagePath2 class="popup-zoom">
                                <img src=@item.ImagePath2 alt="Product Images">
                            </a>
                        </div>
                    }
                    @if (@item.ImagePath3 != null)
                    {
                        <div class="thumbnail">
                            <a href=@item.ImagePath3 class="popup-zoom">
                                <img src=@item.ImagePath3 alt="Product Images">
                            </a>
                        </div>
                    }
                    @if (@item.ImagePath4 != null)
                    {
                        <div class="thumbnail">
                            <a href=@item.ImagePath4 class="popup-zoom">
                                <img src=@item.ImagePath4 alt="Product Images">
                            </a>
                        </div>
                    }
                    @if (@item.ImagePath5 != null)
                    {
                        <div class="thumbnail">
                            <a href=@item.ImagePath5 class="popup-zoom">
                                <img src=@item.ImagePath5 alt="Product Images">
                            </a>
                        </div>
                    }

                </div>
                @*<div class="product-quick-view position-view">
                        <a href=@item.ImagePath class="popup-zoom">
                            <i class="far fa-search-plus"></i>
                        </a>
                    </div>*@
            </div>
        </div>
        <div class="col-lg-2 order-lg-1">
            <div class="product-small-thumb-3 small-thumb-wrapper h-scroll">
                <div class="small-thumb-img">
                    <img src=@item.ImagePath alt="thumb image">
                </div>
                @if (@item.ImagePath1 != null)
                {
                    <div class="small-thumb-img">
                        <img src=@item.ImagePath1 alt="thumb image">
                    </div>

                }
                @if (@item.ImagePath2 != null)
                {
                    <div class="small-thumb-img">
                        <img src=@item.ImagePath2 alt="thumb image">
                    </div>
                }
                @if (@item.ImagePath3 != null)
                {
                    <div class="small-thumb-img">
                        <img src=@item.ImagePath3 alt="thumb image">
                    </div>
                }
                @if (@item.ImagePath4 != null)
                {
                    <div class="small-thumb-img">
                        <img src=@item.ImagePath4 alt="thumb image">
                    </div>
                }
                @if (@item.ImagePath5 != null)
                {
                    <div class="small-thumb-img">
                        <img src=@item.ImagePath5 alt="thumb image">
                    </div>
                }

            </div>
        </div>

    }
}





