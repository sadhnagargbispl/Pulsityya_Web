<body>
<!-- #include file="inc/header.asp" -->
<section class="contents"> 
    <div class="breadcrmb">
        <img src="img/page-banner.jpg" alt="About us">
        <div class="breadcrmb-content">
            <div class="container">
                <h1>Cart</h1> 
                <ul class="breadcrmb-loc">
                    <li><a href="/">Home</a></li>
                    <li><a class="active">Cart</a></li>
                </ul>
            </div>
        </div> 
    </div> 
    <!--  -->
    <div class="content-row"> 
        <div class="container">
            <div class="cart-row">
                <div class="row">
                    <div class="col-sm-7 col-md-8">
                        <div class="cart-item">
                            <div class="crt-lst">
                                <p class="pr_remove"><a></a></p>
                                <div class="crt-pic"><img src="img/sample-product.jpg" /></div>
                                <div class="crt-inf">
                                    <p class="pr_name"><span>Product ID 1007</span>Gir Cow A2 Bilona Ghee</p>
                                    <div class="row">
                                        <div class="col-xs-5 col-md-3 col-lg-2"> 
                                            <div class="num-incr-decr">
                                                <span class="decrMent" dt-min="1"></span> 
                                                <input step="1" value="1" type="text" name="quantity">
                                                <span class="incrMent" dt-max="50"></span> 
                                            </div>
                                        </div>
                                        <div class="col-xs-7 col-md-9 col-lg-10">
                                            <p class="pr_rate">
                                                <span class="pr_mrp">₹ 250</span> <span class="pr_offerprice">₹ 175</span>
                                                <span class="pr_discount">30% Off</span>
                                            </p>
                                        </div>
                                    </div>
                                    <p class="pr_size_color"></p>
                                </div>
                            </div>
                            <!--  -->
                            <div class="crt-lst">
                                <p class="pr_remove"><a></a></p>
                                <div class="crt-pic"><img src="img/sample-product.jpg" /></div>
                                <div class="crt-inf">
                                    <p class="pr_name"><span>Product ID 1007</span>Gir Cow A2 Bilona Ghee</p>
                                    <div class="row">
                                        <div class="col-xs-5 col-md-3 col-lg-2"> 
                                            <div class="num-incr-decr">
                                                <span class="decrMent" dt-min="1"></span> 
                                                <input step="1" value="1" type="text" name="quantity">
                                                <span class="incrMent" dt-max="50"></span> 
                                            </div>
                                        </div>
                                        <div class="col-xs-7 col-md-9 col-lg-10">
                                            <p class="pr_rate">
                                                <span class="pr_mrp">₹ 250</span> <span class="pr_offerprice">₹ 175</span>
                                                <span class="pr_discount">30% Off</span>
                                            </p>
                                        </div>
                                    </div>
                                    <p class="pr_size_color"></p>
                                </div>
                            </div>

                            <a href="product" class="btn btn-sub btn-shop">Continue Shopping</a>
                        </div>
                    </div>
                    <div class="col-sm-5 col-md-4">
                        <div class="price-lst-smry">
                            <h5>Order Summary</h5>
                            <ul>
                                <li><span class="lft">Total MRP</span><span class="rght">₹  500.00</span></li>
                                <li><span class="lft">Discount on MRP (-)</span><span class="rght">₹ 150.00</span></li>
                                <li class="ftr"><span class="lft">Grand Total </span><span class="rght">₹ 350.00</span></li>

                                <li><span class="lft">Shipping Fee (+)</span><span class="rght">₹ 60.00</span></li>
                                <li class="ftr"><span class="lft">Net Payable </span><span class="rght">₹ 410.00</span></li>
                            </ul>
 
                            <a class="btn btn-sub btn-order" href="login">Proceed to checkout</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>  
