<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <system.web>
        <compilation debug="false" targetFramework="4.8" />
        <httpRuntime targetFramework="4.8" />
        <customErrors mode="Off" />
    </system.web>

    <system.webServer>
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.asp" /> 
            </files>
        </defaultDocument>

        <httpErrors errorMode="Detailed" />

    </system.webServer>

</configuration>