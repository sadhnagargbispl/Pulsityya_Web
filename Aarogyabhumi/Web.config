<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- ==========================================================
         Every external host the site talks to lives here.
         To move the site to the Pulastya domains, change ONLY the
         five *Url keys below - no code change is needed.
         ========================================================== -->
    <!-- this site's own public address (KYC document links, payment return url) -->
    <add key="SiteUrl" value="https://pulastyaglobals.in" />
    <!-- franchise portal: product/banner images and invoice PDFs -->
    <add key="FranchiseUrl" value="https://franchise.pulastyaglobals.in" />
    <!-- MLM control panel: API, BV posting and SSO -->
    <add key="CpanelUrl" value="https://cpanel.pulastyaglobals.in" />
    <!-- gift voucher portal (inter-login form post) -->
    <add key="GvPortalUrl" value="https://gv.pulastyaglobals.in/members/index.php" />
    <!-- online store portal (inter-login form post) -->
    <add key="StorePortalUrl" value="https://store.pulastyaglobals.in/members/index.php" />
    <!-- compliance certificate images -->
    <add key="CertificateUrl" value="https://pulastyaglobals.in/demo/assets/images/certificate/" />
    <!-- Image URLs stored in the database still point at the old franchise host.
         While this is "true" they are re-hosted onto FranchiseUrl as they are read,
         so the database does not have to be touched. Set to "false" once the
         stored URLs are correct. -->
    <add key="RehostMediaUrls" value="true" />

    <add key="ImageUrl" value="https://franchise.pulastyaglobals.in/Uploads" />
    <add key="ApiUrl" value="https://cpanel.pulastyaglobals.in/ProcessAPIWithK.aspx" />
    <add key="Sendbox_xapikey_test" value="key_test_3f54b3a93c6444eeb3b32f25c432f7ac" />
    <add key="Sendbox_xapikey" value="key_live_7157996981114cf69a40f4a31ee3678e" />
    <add key="Sendbox_xapisecret_test" value="secret_test_747333d2239c44ceb7bfd7f699b5b2d3" />
    <add key="Sendbox_xapisecret" value="secret_live_655b087d089a4a9da33717b8ffc0e1d7" />
    <add key="Sendbox_authenticate" value="https://api.sandbox.co.in/authenticate" />
    <add key="Sendbox_panverify" value="https://api.sandbox.co.in/kyc/pan/verify" />
    <add key="Sendbox_accountverify" value="https://api.sandbox.co.in/bank/{ifsc}/accounts/{account_number}/verify" />
  </appSettings>
  <connectionStrings>
    <add name="sqlConn" connectionString="Data Source =103.193.74.91,1533;Initial Catalog=pulstyainv;Integrated Security=false;User ID=usrpulstya;PWD=GLbPul!$3@5Nda;Max Pool Size=2000;Pooling=true" providerName="System.Data.SqlClient" />
    <add name="sqlMLMConn" connectionString="Data Source =103.193.74.91,1533;Initial Catalog=pulstya;Integrated Security=false;User ID=usrpulstya;PWD=GLbPul!$3@5Nda;Max Pool Size=2000;Pooling=true" providerName="System.Data.SqlClient" />
  </connectionStrings>
