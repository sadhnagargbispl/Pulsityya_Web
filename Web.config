    <add name="constr" connectionString="Data Source =103.193.74.91,1533;Initial Catalog=darju9inv;Integrated Security=false;User ID=usrdarju9;PWD=Ju9!7@#DrVsh;Max Pool Size=2000;Pooling=true" providerName="System.Data.SqlClient" />
    <add name="sconstr" connectionString="Data Source =103.193.74.91,1533;Initial Catalog=darju9inv;Integrated Security=false;User ID=usrdarju9;PWD=Ju9!7@#DrVsh;Max Pool Size=2000;Pooling=true" providerName="System.Data.SqlClient" />
    <add name="conselect" connectionString="Data Source =103.193.74.91,1533;Initial Catalog=darju9inv;Integrated Security=false;User ID=usrdarju9;PWD=Ju9!7@#DrVsh;Max Pool Size=2000;Pooling=true" providerName="System.Data.SqlClient" />
