                                                            User Name <span style="color: red  !important; font-weight: bold; font-size: 1.4em">
                                                                *</span>
                                                        </label>
                                                        <div class="col-sm-10">
                                                            <asp:TextBox ID="txtUName" CssClass="form-control validate[required,custom[onlyLetterNumber]]"
