                                                    <asp:ListItem Text="Partnership Firm" Value="PF"></asp:ListItem>
                                                    <asp:ListItem Text="Private Limited Company" Value="PL"></asp:ListItem>
                                                </asp:RadioButtonList>
                                            </div>
                                        </div>
