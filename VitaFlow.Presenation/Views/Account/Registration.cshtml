@model VitaFlow.Domain.Entities.M_Registration
@{
    Layout = null;
    var comp = await CompanyInfo.GetAsync();
    var compName = comp.DisplayName();
    var compLogo = comp.LogoUrl(Url);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Party Registration</title>
    <link rel="icon" type="image/png" href="https://colorlib.com/etc/lf/Login_v11/images/icons/favicon.ico" />
    <link rel="stylesheet" type="text/css" href="~/login_files/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/login_files/font-awesome.min.css" />
    <meta name="robots" content="noindex, follow">
    <style>
        * { box-sizing: border-box; }

        body.rg-page {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #dbe9f9 0%, #eef2f9 50%, #e3ddf0 100%);
            color: #1f2937;
            padding: 32px 16px;
        }

        .rg-card {
            max-width: 760px;
            margin: 0 auto;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 18px 48px rgba(17, 38, 80, .12);
            overflow: hidden;
        }

        .rg-header {
            text-align: center;
            padding: 28px 24px 22px;
            background: linear-gradient(90deg, #155fa0 0%, #0d9488 100%);
            color: #fff;
        }

            .rg-header img {
                max-width: 130px;
                max-height: 90px;
                border-radius: 10px;
                background: #fff;
                padding: 6px;
                margin-bottom: 14px;
            }

            .rg-header h1 {
                font-size: 22px;
                font-weight: 700;
                letter-spacing: .6px;
                margin: 0;
                text-transform: uppercase;
            }

            .rg-header p {
                margin: 6px 0 0;
                font-size: 13.5px;
                opacity: .9;
            }

        .rg-body { padding: 26px 32px 30px; }

        .rg-section {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: #155fa0;
            margin: 6px 0 14px;
        }

            .rg-section::after {
                content: "";
                flex: 1;
                height: 1px;
                background: #e3e9f4;
            }

        .rg-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 20px;
        }

        .rg-full { grid-column: 1 / -1; }

        .rg-field { margin-bottom: 14px; }

            .rg-field label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #374151;
                margin-bottom: 6px;
            }

        .rg-req { color: #dc2626; margin-left: 2px; }

        .rg-opt {
            color: #6b7280;
            font-weight: 400;
            font-size: 12px;
            margin-left: 4px;
        }

        .rg-control {
            display: block;
            width: 100%;
            height: 44px;
            padding: 0 14px;
            font-size: 14.5px;
            color: #1f2937;
            background: #f8fafd;
            border: 1px solid #d5dcec;
            border-radius: 10px;
            outline: none;
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }

            .rg-control::placeholder { color: #9ca3af; }

            .rg-control:focus {
                background: #fff;
                border-color: #155fa0;
                box-shadow: 0 0 0 3px rgba(21, 95, 160, .15);
            }

            /* GST par readonly sirf autofill rokne ke liye hai, use grey na dikhayein */
            .rg-control[readonly]:not(#gstnum), .rg-control:disabled {
                background: #eef2f7;
                color: #4b5563;
            }

        .rg-field .text-danger {
            display: block;
            font-size: 12.5px;
            margin-top: 4px;
        }

        .rg-alert {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13.5px;
            margin-bottom: 16px;
        }

        .rg-captcha {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .rg-captcha .rg-control { flex: 1; }

            .rg-captcha canvas {
                height: 44px;
                border-radius: 10px;
                border: 1px solid #d5dcec;
            }

        .rg-actions {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
        }

        .rg-btn {
            width: 100%;
            height: 48px;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: #fff;
            background: linear-gradient(to right, #155fa0 0%, #0d9488 100%);
            cursor: pointer;
            transition: box-shadow .2s ease, background .2s ease;
        }

            .rg-btn:hover {
                background: linear-gradient(to right, #0d9488 0%, #155fa0 100%);
                box-shadow: 0 8px 18px rgba(13, 148, 136, .3);
            }

            .rg-btn:disabled { opacity: .7; cursor: wait; }

        .rg-login {
            font-size: 13.5px;
            color: #6b7280;
        }

            .rg-login a { color: #155fa0; font-weight: 600; }

        @@media (max-width: 640px) {
            body.rg-page { padding: 16px; }
            .rg-body { padding: 20px 18px 24px; }
            .rg-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body class="rg-page">

    <div class="rg-card">
        <div class="rg-header">
            <img src="@compLogo" alt="@compName" title="@compName" />
            <h1>New Registration</h1>
            <p>Fill in your details to apply for a franchise</p>
        </div>

        <div class="rg-body">
            <form id="signupform" asp-controller="Account" asp-action="Registration" autocomplete="off">
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(Convert.ToString(ViewBag.Rerr)))
                {
                    <div class="rg-alert">@ViewBag.Rerr</div>
                }

                <div class="rg-section">Business Details</div>
                <div class="rg-grid">
                    <div class="rg-field rg-full">
                        <label for="PartyGroup">Apply For<span class="rg-req">*</span></label>
                        <select name="GroupId" asp-for="GroupId" class="rg-control" id="PartyGroup">
                            <option selected="selected" value="0">-- Select Franchise Type --</option>
                            @if (Model.GroupList != null && Model.GroupList.Count() > 0)
                            {
                                foreach (var item in Model.GroupList)
                                {
                                    <option value="@item.GroupId">@item.GroupName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="GroupId" class="text-danger"></span>
                        <span class="text-danger">@ViewBag.groupiderr</span>
                    </div>

                    <div class="rg-field">
                        <label for="firmname">Firm Name<span class="rg-req">*</span></label>
                        <input class="rg-control" type="text" id="firmname" asp-for="Name" name="Name" placeholder="Enter firm name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="rg-field">
                        <label for="MobileNo">Mobile Number<span class="rg-req">*</span></label>
                        <input class="rg-control" type="text" asp-for="MobileNo" name="MobileNo" placeholder="10 digit mobile number" maxlength="10" onkeypress="return isNumberKey(event);" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>

                    <div class="rg-field rg-full">
                        <label for="gstnum">GST Number<span class="rg-opt">(Optional)</span></label>
                        <input class="rg-control" id="gstnum" type="text" name="GST" value="" placeholder="e.g. 22AAAAA0000A1Z5" maxlength="15"
                               readonly onfocus="this.removeAttribute('readonly');" />
                        <span asp-validation-for="GST" class="text-danger"></span>
                    </div>
                </div>

                <div class="rg-section">Address</div>
                <div class="rg-grid">
                    <div class="rg-field rg-full">
                        <label for="Address">Address<span class="rg-req">*</span></label>
                        <input class="rg-control" type="text" asp-for="Address" name="Address" placeholder="House / street / area" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="rg-field">
                        <label for="pincode">Pin Code<span class="rg-req">*</span></label>
                        <input class="rg-control" onkeypress="return isNumberKey(event);" onkeyup="GetPincodeDetail()" type="text" asp-for="PinCode" name="pincode" id="pincode" placeholder="6 digit pin code" maxlength="6" />
                        <span asp-validation-for="PinCode" class="text-danger"></span>
                    </div>

                    <div class="rg-field">
                        <label for="registraton">State<span class="rg-req">*</span></label>
                        <select name="StateCode" asp-for="StateCode" class="rg-control" id="registraton">
                            <option selected="selected" value="Select City" disabled>-- Select State --</option>
                            @if (Model.Statelist != null && Model.Statelist.Count() > 0)
                            {
                                foreach (var item in Model.Statelist)
                                {
                                    <option value="@item.StateCode">@item.StateName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="StateCode" class="text-danger"></span>
                        <span class="text-danger">@ViewBag.stateerr</span>
                    </div>

                    <div class="rg-field rg-full">
                        <label for="City">City / District<span class="rg-req">*</span></label>
                        <input class="rg-control" type="text" asp-for="City" name="city" placeholder="City" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>

                <div class="rg-section">Account Details</div>
                <div class="rg-grid">
                    <div class="rg-field rg-full">
                        <label for="ParentPartyCode">Parent Party<span class="rg-req">*</span></label>
                        <input type="hidden" name="PartyCode" asp-for="PartyCode" id="hiddenParentPartyCode" />
                        <select name="ParentPartyCode" asp-for="ParentPartyCode" class="rg-control" id="ParentPartyCode">
                            <option value="">-- Select Apply For first --</option>
                        </select>
                        <span asp-validation-for="PartyCode" class="text-danger"></span>
                        <span class="text-danger">@ViewBag.partyerr</span>
                        <span class="text-danger" id="partyname" style="display:none;"></span>
                    </div>

                    <div class="rg-field">
                        <label for="Password">Login Password<span class="rg-req">*</span></label>
                        <input class="rg-control" asp-for="Password" type="password" name="password" placeholder="Create a password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="rg-field">
                        <label for="captchaCode">Captcha<span class="rg-req">*</span></label>
                        <div class="rg-captcha">
                            <input type="text" name="code" id="captchaCode" class="rg-control" placeholder="Enter code" />
                            <canvas id="canvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="rg-actions">
                    <input type="submit" id="uploadButton" class="rg-btn" value="Submit" />
                    <button class="rg-btn" id="hidbtn" style="display:none;" type="button" disabled>
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Please wait...
                    </button>
                    <div class="rg-login">Already registered? <a href="~/Account/Login">Login here</a></div>
                </div>
            </form>
        </div>
    </div>

    <script src="~/login_files/jquery-3.2.1.min.js"></script>
    <script src="~/login_files/popper.js"></script>
    <script src="~/login_files/bootstrap.min.js"></script>
    <script src="~/assets/captcha/jquery-captcha.min.js"></script>
    <script type="text/javascript">
        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (charCode == 46) {
                return true;
            }
            else if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
            return true;
        }
        function GetPincodeDetail() {
            var PartyGroup = $("#PartyGroup").val();

            if (PartyGroup == "0") {
                alert("Please select franchise package");
                $("#uploadButton").show();
                $("#hidbtn").hide();
                return false;
            }

            var Pincode = $("#pincode").val();

            if (Pincode.length >= 6) {
                $.ajax({
                    url: '/Account/GetPincodeDetail',
                    type: 'GET',
                    dataType: 'json',
                    data: { Pincode: Pincode },
                    success: function (data) {
                        if (data.code == "200") {
                            $("#City").val(data.district);
                            $("#City").prop("readonly", true);
                            $("#registraton option").each(function () {
                                if ($(this).text().trim().toUpperCase() == data.state.trim().toUpperCase()) {
                                    $(this).prop("selected", true);
                                }
                            });
                            $("#registraton").prop("disabled", true);
                        } else {
                            $("#City").val("");
                            $("#City").prop("readonly", false);
                            $("#registraton").prop("disabled", false);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log(error);
                        $("#City").val("");
                        $("#City").prop("readonly", false);
                        $("#registraton").prop("disabled", false);
                    }
                });
            } else {
                $("#City").val("");
                $("#City").prop("readonly", false);
                $("#registraton").prop("disabled", false);
            }
        }
        $(document).ready(function () {
            $('#signupform').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    return false;
                }
            });

            $('#uploadButton').on('click', function (e) {
                $("#uploadButton").hide();
                $("#hidbtn").show();
                var PartyGroup = $("#PartyGroup").val();
                if (PartyGroup == "0") {
                    alert("Please select franchise package");
                    e.preventDefault();
                    $("#uploadButton").show();
                    $("#hidbtn").hide();
                    return false;
                }
                if ($("#hiddenParentPartyCode").val() == "") {
                    alert("Please select parent party");
                    e.preventDefault();
                    $("#uploadButton").show();
                    $("#hidbtn").hide();
                    return false;
                }
                // GST optional hai - bhara ho tabhi format check hota hai
                var gstnum = $("#gstnum").val().trim().toUpperCase();
                if (gstnum !== "") {
                    var reggst = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]$/;
                    if (!reggst.test(gstnum)) {
                        alert("GST Identification Number is not valid.");
                        e.preventDefault();
                        $("#uploadButton").show();
                        $("#hidbtn").hide();
                        return false;
                    }
                }
                if ($('input[name="code"]').val() == "") {
                    alert("Please enter captcha");
                    $('input[name="code"]').focus();
                    $("#uploadButton").show();
                    $("#hidbtn").hide();
                    return false;
                }
                const ans = captcha.valid($('input[name="code"]').val());
                if (ans == false) {
                    alert("Captcha is mismatch");
                    $('input[name="code"]').val('')
                    $('input[name="code"]').focus();
                    captcha.refresh();
                    $("#uploadButton").show();
                    $("#hidbtn").hide();
                    return false;
                }
                // Disabled select post nahi hota - pincode se state lock hui ho to bhi StateCode jaye
                $("#registraton").prop("disabled", false);
            });
            $("#PartyGroup").change(function () {
                GetParentPartyList($("#PartyGroup").val());
            });
            $("#ParentPartyCode").change(function () {
                $("#hiddenParentPartyCode").val($("#ParentPartyCode").val());
            });
        });
        function GetParentPartyList(GroupId) {
            $("#ParentPartyCode").empty();
            $("#hiddenParentPartyCode").val("");
            if (GroupId == "0") {
                $("#ParentPartyCode").append('<option value="">-- Select Apply For first --</option>');
                return;
            }
            $.ajax({
                url: '/Account/GetParentPartyList',
                dataType: 'JSON',
                method: 'GET',
                data: { 'GroupId': GroupId, "stateCode": 0, "District": "" },
                success: function (data) {
                    $("#ParentPartyCode").empty();
                    if (data.length > 0) {
                        $("#hiddenParentPartyCode").val(data[0].partyCode);
                        for (var i = 0; i < data.length; i++) {
                            $("#ParentPartyCode").append($("<option>").val(data[i].partyCode).text(data[i].partyName + " (" + data[i].partyCode + ")"));
                        }
                    }
                    else {
                        $("#ParentPartyCode").append('<option value="">No parent party found</option>');
                    }
                },
                error: function (error) {
                    console.log(error);
                }
            });
        }
    </script>
    <script>
        const captcha = new Captcha($('#canvas'), {
            length: 4
        });
    </script>
</body>
</html>
