@model VitaFlow.Domain.Entities.DistributorBillModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "DistributorBill";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string WBalance = ViewBag.WBalance;
    bool IsAdministrator = Convert.ToBoolean(Context.Session.GetString("IsSoldByHo"));
    string CVCaption = ViewBag.CVCaption;
    string BVCaption = ViewBag.BVCaption;
    string PVCaption = ViewBag.PVCaption;
    string RPCaption = ViewBag.RPCaption;
    string BarcodeCaption = ViewBag.BarcodeCaption;
}

<!-- Breadcrumb Start -->
<div class="breadcrumb-header justify-content-between">
    <div class="left-content">
        <div>
            <h2 class="main-content-title tx-24 mg-b-1 mg-b-lg-1">Hi, @Convert.ToString(Context.Session.GetString("UserName"))!</h2>
            <p class="mg-b-0"> @Convert.ToString(Context.Session.GetString("PartyName"))</p>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<div class="row row-sm row-deck">

    <div class="col-md-12 col-lg-12 col-xl-12 col-sm-12">
        <div class="card card-dashboard-eight pb-2 bg-light prodcutbox">
            <h5> Bill  Details </h5>
            <hr>
            <form id="distributorForm" method="post" name="distributorForm">
                <div class="row">
                    <div class="col-lg-12 ">

                        @Html.Hidden("IsAdd", "", new { name = "isAdd", id = "isAdd" })
                        @Html.HiddenFor(m => m.objCustomer.FormNo, new { name = "FormNo", id = "FormNo" })
                        @Html.HiddenFor(m => m.objProductListStr, new { name = "ListObjHidden", id = "ListObjHidden" })
                        @Html.HiddenFor(m => m.objCustomer.IsBillOnMrp, new { id = "IsBillOnMrp" })
                        @Html.HiddenFor(m => m.objCustomer.MinBillAmt, new { id = "MinBillAmt" })
                        @Html.HiddenFor(m => m.objCustomer.MinRepurch, new { id = "MinRepurch" })
                        @Html.HiddenFor(m => m.objCustomer.IsFirstBill, new { id = "FirstBill" })
                        @Html.HiddenFor(m => m.offerId, new { name = "offerId", id = "offerId" })
                        @Html.HiddenFor(m => m.objCustomer.StateCode, new { id = "StateCode" })
                        @Html.HiddenFor(m => m.objCustomer.IsActive, new { id = "IsActive" })
                        @Html.HiddenFor(m => m.objCustomer.Doj, new { name = "Doj", id = "Doj" })
                        @Html.HiddenFor(m => m.objCustomer.UpgradeDate, new { id = "UpgradeDate" })
                        @Html.Hidden("SpclOffer", "", new { name = "SpclOffer", id = "SpclOffer" })
                        @Html.Hidden("OfferType", "0", new { name = "OfferType", id = "OfferType" })
                        @Html.HiddenFor(m => m.objCustomer.MaxBV, new { id = "MaxBV", name = "MaxBV" })
                        @Html.HiddenFor(m => m.objProduct.isFixedQty, new { name = "isFixedQty", id = "isFixedQty" })
                        @Html.HiddenFor(m => m.objProduct.FixedQty, new { name = "FixedQty", id = "FixedQty" })
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Invoice Type</label>
                            <div class="col-sm-6">
                                @Html.HiddenFor(m => m.objCustomer.SelectedInvoiceType, new { id = "hiddenSelectedInvoiceType", name = "hiddenSelectedInvoiceType" })
                                <select asp-for="SelectedInvoiceType" id="SelectedInvoiceType" onchange="Disablepaymode()" class="form-control" tabindex="0" name="SelectedInvoiceType">
                                    <option value="">--Select Type--</option>
                                    <option value="PV">Activation</option>
                                    <option value="BV">Repurchase</option>
                                </select>
                            </div>

                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label Paymodedivlabel" style="display:none;">Payment Method</label>
                            <div class="col-sm-4" id="Paymodediv" style="display:none;">
                                <select id="PaymentMethodDrop" class="form-control" onchange="DispalyPaymode()" tabindex="0" name="PaymentMethodDrop">
                                    <option value="Cash">Use Cash</option>
                                </select>
                            </div>
                            <label class="col-sm-2 col-form-label" style="display:none;" id="passworddivlabel">Password</label>
                            <div class="col-sm-2" id="passworddiv" style="display:none;">
                                <input type="password" id="userpassw" class="form-control" value="" />
                                <input type="hidden" id="passwvarify" class="form-control" value="false" />
                            </div>
                            <div class="col-sm-1" id="passworddivbutton" style="display:none;">
                                <button type="button" id="Varify" class="btn btn-primary">Verify</button>
                            </div>

                        </div>
                        <div class="row mb-3">
                            <label for="IdNo" class="col-sm-2 col-form-label">IdNo</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(m => m.objCustomer.IdNo, new
                                {
                                    id = "IdNo",
                                    @class = "form-control",
                                    autocomplete = "off"
                                })
                            </div>
                            <label for="OfferList" class="col-sm-2 col-form-label" style="display:none;"> Choose Offer</label>
                            <div class="col-sm-4" style="display:none;">
                                @Html.DropDownListFor(m => m.NewofferId, ViewBag.OfferList as IEnumerable<SelectListItem>, new { tabindex = "0", @class = "form-control", @name = "OfferList", @id = "OfferList" })
                            </div>
                            <label class="col-sm-2 col-form-label">Name</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(m => m.objCustomer.Name, new { name = "Name", id = "Name", @maxlength = "50", @class = "form-control", @readonly = "readonly" })
                                <label class="control-label" for="category-name" id="IDType_" style="color:green;display:none;"></label>
                            </div>

                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">City[State]</label>
                            <div class="col-sm-4">
                                @Html.TextAreaFor(m => m.objCustomer.Address, new { name = "Address", id = "Address", @class = "form-control", @readonly = "readonly" })
                            </div>

                            <label class="col-sm-2 col-form-label">District</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(m => m.objCustomer.DistrictName, new { name = "DistrictName", id = "DistrictName", @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        @* Bill Tax Type ab manually choose nahi hota - state ke according automatic set hota hai *@
                        <input type="hidden" id="LoginStateCode" value="@Convert.ToString(Context.Session.GetString("StateCode"))" />
                        <input type="hidden" name="TaxType" id="TaxType" value="CS" />
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Bill Tax Type</label>
                            <div class="col-sm-4">
                                <input type="text" id="TaxTypeDisplay" class="form-control" value="CGST &amp; SGST" readonly="readonly" />
                            </div>
                        </div>

                        <hr>
                        <h3 class="mb-5"> Products Details  </h3>
                        <div id="DivHideShowID">

                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label"> Product  </label>
                                <div class="col-sm-1 col-4">
                                    <select class="form-control" id="prdselectiontype">
                                        <option value="P"> P </option>
                                        <option value="B"> B </option>
                                    </select>
                                </div>
                                <div class="col-sm-3 col-8">
                                    @Html.TextBoxFor(m => m.objProduct.ProductName, new { tabindex = "0", name = "ProductName", id = "ProductName", @class = "form-control" })
                                    @Html.HiddenFor(m => m.objProduct.ProductName, new { id = "ProductHidden" })
                                </div>

                                <label class="col-sm-2 col-form-label">Bar Code</label>
                                <div class="col-sm-4">
                                    @Html.TextBoxFor(m => m.objProduct.Barcode, new { tabindex = "0", name = "Barcode", id = "Barcode", @class = "form-control" })
                                    @Html.HiddenFor(m => m.objProduct.Barcode, new { id = "BarcodeHidden" })
                                    <select tabindex="0" name="BarcodeList" id="BarcodeList" style="display:none;width:100%" class="form-control">
                                        <option value="0">--Select barcode</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-3">

                                <label class="col-sm-2 col-form-label">Batch Code</label>
                                <div class="col-sm-4">
                                    <select tabindex="0" name="BatchcodeList" id="BatchcodeList" style="width:100%" class="form-control">
                                        <option value="0">--Select BatchCode</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label"> Qty  </label>
                                <div class="col-sm-4 mb-3">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.objProduct.Quantity, new { name = "Quantity", maxlength = "10", tabindex = "0", id = "Quantity", @class = "form-control" })
                                        </div>
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.objProduct.StockAvailable, new { name = "StockAvailable", id = "StockAvailable", @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>

                                <label class="col-sm-2 col-form-label">DP</label>
                                <div class="col-sm-4">
                                    @Html.TextBoxFor(m => m.objProduct.DP, new { name = "DP", id = "DP", @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label">Free Qty</label>
                                <div class="col-sm-4">
                                    @Html.Hidden("BuyFreeQty", "0", new { name = "BuyFreeQty", id = "BuyFreeQty" })
                                    @Html.TextBoxFor(m => m.objProduct.FreeQty, new { name = "FreeQty", maxlength = "10", tabindex = "0", id = "FreeQty", @class = "form-control onlyDecimalValues", @readonly = "readonly" })
                                </div>
                                @* Disc. (Disc% / Disc Amt.) UI se hata diya gaya hai - fields hidden hain taaki calculation chalti rahe *@
                                <label class="col-sm-2 col-form-label" style="display:none;"> Disc.  </label>
                                <div class="col-sm-4" style="display:none;">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.objProduct.DiscPer, new { name = "DiscPer", id = "DiscPer", @readonly = "readonly", @class = "form-control" })
                                        </div>
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.objProduct.DiscAmt, new { name = "DiscAmt", id = "DiscAmt", @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label">Amount</label>
                                <div class="col-sm-4">
                                    @Html.TextBoxFor(m => m.objProduct.Amount, new { name = "Amount", id = "Amount", @class = "form-control", @readonly = "readonly" })
                                </div>

                                <label class="col-sm-2 col-form-label"> Tax  </label>
                                <div class="col-sm-4">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.objProduct.TaxPer, new { name = "TaxPer", id = "TaxPer", @class = "form-control", @readonly = "readonly" })
                                        </div>
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.objProduct.TaxAmt, new { name = "TaxAmt", id = "TaxAmt", @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label"> Total Amount  </label>
                                <div class="col-sm-4">
                                    @Html.TextBoxFor(m => m.objProduct.TotalAmount, new { name = "TotalAmount", id = "TotalAmount", @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <hr>
                            <button type="button" id="AddRecordInGrid" class="btn btn-primary mt-4"> <i class="fa fa-plus" aria-hidden="true"></i> Add Product</button>
                            <button type="button" id="ClearDetails" class="btn btn-info mt-4"> <i class="fa fa-minus" aria-hidden="true"></i> Clear Product</button>
                            <div class="clearfix"> </div>
                            <div class="table-responsive">
                                <table class="table table-bordered mt-5" id="grid"></table>
                            </div>
                            <div class="row mb-3 mt-3">
                                <label class="col-sm-2 col-form-label"> Delivery Place </label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.objProduct.DeliveryPlace, new { name = "DeliveryPlace", id = "DeliveryPlace", @class = "form-control" })
                                </div>
                                <div class="col-sm-2">
                                    <button type="button" id="paymodebtn" class="btn btn-primary" data-toggle="collapse" data-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">  Pay Mode </button>
                                    @Html.HiddenFor(m => m.objProduct.PayDetails.PayMode, new { @name = "hiddenPaymode", @id = "hiddenPaymode" })
                                </div>
                            </div>
                            <div class="clearfix"> </div>
                            <!-- Collapse Data Start -->
                            <div class="row">
                                <div class="collapse w-100" id="collapseExample">
                                    <div class="card card-body cardbg">
                                        <div class="row">
                                            <div class="col-sm-4">Payment Mode :</div>
                                            <div class="col-sm-4"></div>
                                            <div class="col-sm-4"><button type="button" id="paymodeclose" style="float:right;" class="btn btn-primary">Close</button></div>
                                        </div>
                                        <hr>
                                        <div class="row mb-3" style="display:none;">
                                            <div class="col-sm-2">
                                                <div class="form-check mt-2">
                                                    <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios1" value="option1">
                                                    <label class="form-check-label" for="exampleRadios1">
                                                        By Card(CC)
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AmountByCard, new { @class = "form-control", @name = "AmountByCard", @id = "AmountByCard", @disabled = "disabled", tabindex = "0" })
                                            </div>

                                            <div class="col-sm-1">
                                                <label class="col-form-label"> Card No.    </label>
                                            </div>

                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.CardNo, new { tabindex = "0", @class = "form-control", @name = "CardNo", @id = "CardNo", @maxlength = "16", @disabled = "disabled" })
                                            </div>

                                            <div class="col-sm-1">
                                                <label class="col-form-label"> </label>
                                            </div>

                                            <div class="col-sm-2">
                                                @Html.DropDownListFor(m => m.objProduct.PayDetails.CardType, ViewBag.CardTypes as IEnumerable<SelectListItem>, new { tabindex = "0", @class = "form-control", @name = "CardType", @id = "CardType", @disabled = "disabled" })
                                            </div>
                                        </div>

                                        @* FP Voucher paymode hata diya gaya hai - inputs hidden rakhe hain taaki JS/binding na toote *@
                                        <div class="row mb-3" style="display:none;">
                                            <div class="col-sm-2">
                                                <div class="form-check mt-2">
                                                    @Html.CheckBoxFor(m => m.objProduct.PayDetails.IsV, new { @name = "IsV", id = "IsV", @class = "form-check-input bvoffer" })
                                                    <label class="form-check-label" for="IsV">
                                                        FP Voucher
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-sm-2" style="display:none;">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.FpVoucher, new { @class = "form-control", @placeholder = "Voucher Code", @name = "FpVoucher", @id = "FpVoucher", @disabled = "disabled" })
                                            </div>
                                            <div class="col-sm-2">
                                                <label class="col-form-label">FPV Balance  </label>
                                            </div>
                                            <div class="col-sm-2">
                                                <input type="text" id="vamt" class="form-control" value="0" readonly />
                                            </div>
                                            <div class="col-sm-2">
                                                <label class="col-form-label">Ad. Amount  </label>
                                            </div>

                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AmountByVoucher, new { @class = "form-control", @placeholder = "Amount", @name = "AmountByVoucher", @id = "AmountByVoucher", @readonly = "readonly" })
                                                <input type="hidden" value="0" id="hidfpamt" />
                                            </div>

                                        </div>

                                        <div class="row mb-3" style="display:none;">
                                            <div class="col-sm-2">
                                                <div class="form-check mt-2">
                                                    @Html.CheckBoxFor(m => m.objProduct.PayDetails.IsCU, new { @name = "IsCU", id = "IsCU", @class = "form-check-input bvoffer" })
                                                    <label class="form-check-label" for="IsCU">
                                                        Coupon
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.Coupon, new { @class = "form-control", @placeholder = "Coupon Code", @name = "Coupon", @id = "Coupon", @disabled = "disabled" })
                                            </div>
                                            <div class="col-sm-2">
                                                <label class="col-form-label">Coupon Amount  </label>
                                            </div>
                                            <div class="col-sm-2">
                                                <input type="text" id="camt" class="form-control" value="0" readonly />
                                            </div>
                                            <div class="col-sm-2">
                                                <label class="col-form-label">Ad. Amount  </label>
                                            </div>

                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AmountbyCoupon, new { @class = "form-control", @placeholder = "Amount", @name = "AmountbyCoupon", @id = "AmountbyCoupon", @maxlength = "16", @readonly = "readonly" })
                                                <input type="hidden" value="0" id="hidcamt" />
                                            </div>

                                        </div>

                                        @* By Wallet paymode hata diya gaya hai - inputs hidden rakhe hain taaki JS/binding na toote *@
                                        <div class="row mb-3" style="display:none;">
                                            <div class="col-sm-2">
                                                <div class="form-check mt-2">
                                                    @Html.CheckBoxFor(m => m.objProduct.PayDetails.IsW, new { @class = "form-check-input", @name = "W", id = "W" })
                                                    <label class="form-check-label" for="W">
                                                        By Wallet(W)
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AmountByWallet, new { @class = "form-control onlyNumeric", @name = "AmountByWallet", @id = "AmountByWallet", @disabled = "disabled" })
                                            </div>
                                            <div class="col-sm-1">
                                                <label class="col-form-label"> Avail Bal.  </label>
                                            </div>
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AvailBal, new { @class = "form-control", @name = "AvailBal", @id = "AvailBal", @readonly = "readonly" })
                                            </div>
                                            <div class="col-sm-1">
                                                <label for="inputEmail3" class="col-form-label">Rem Bal. </label>
                                            </div>
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.RemBal, new { @class = "form-control", @name = "RemBal", @id = "RemBal", @readonly = "readonly" })
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-2">
                                                <div class="form-check mt-2">
                                                    @Html.CheckBoxFor(m => m.objProduct.PayDetails.IsBD, new { @name = "BD", id = "BD", @class = "form-check-input" })
                                                    <label class="form-check-label" for="W">
                                                        By Bank
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AmountByBD, new { @class = "form-control", @name = "AmountByBD", @id = "AmountByBD", @disabled = "disabled" })
                                            </div>
                                            <div class="col-sm-3">
                                                @Html.DropDownListFor(m => m.objProduct.PayDetails.BankCode,
                                                ViewBag.BankNames as IEnumerable<SelectListItem>,
                                                                                                new { @class = "form-control", id = "BankCode", disabled = "disabled" })
                                                @Html.HiddenFor(m => m.objProduct.PayDetails.BDBankName)
                                            </div>
                                            <!-- Account No -->
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.AccNo,
                                                                                                new { @class = "form-control", id = "AccNo", disabled = "disabled", @placeholder = "Acc No." })
                                            </div>
                                            <!-- IFSC -->
                                            <div class="col-sm-3">
                                                @Html.TextBoxFor(m => m.objProduct.PayDetails.IFSCCode,
                                                                                                new { @class = "form-control", id = "IFSCCode", disabled = "disabled", @placeholder = "IFSC Code" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Collapse Data End -->

                            </div>
                        </div>
                    </div>

                </div>

                <div class="clearfix"> </div>

                <hr>
                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label"> Total Qty </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.TotalQty, new { name = "TotalQty", id = "TotalQty", @class = "form-control", @readonly = "readonly" })
                    </div>
                    <label class="col-sm-2 col-form-label"> Total Ad. @BVCaption  </label>
                    <div class="col-sm-2">
                        <input type="text" name="TotalAdBV" id="TotalAdBV" class="form-control" readonly="readonly" value="0" />
                    </div>

                    <label class="col-sm-2 col-form-label"> Total @BVCaption  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.TotalBV, new { name = "TotalBV", id = "TotalBV", @class = "form-control", @readonly = "readonly" })
                    </div>

                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Total @PVCaption  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.TotalPV, new { name = "TotalPV", id = "TotalPV", @class = "form-control", @readonly = "readonly" })
                    </div>

                    <label class="col-sm-2 col-form-label"> Amount  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.TotalTotalAmount, new { name = "TotalTotalAmount", id = "TotalTotalAmount", @class = "form-control", @readonly = "readonly" })
                    </div>
                    @* Trade Disc.(-) UI se hata diya gaya hai (value post hoti rahegi) *@
                    <label class="col-sm-2 col-form-label" style="display:none;"> Trade Disc.(-)  </label>
                    <div class="col-sm-2" style="display:none;">
                        @Html.TextBoxFor(m => m.objProduct.TotalDiscount, new { name = "TotalDisc", id = "TotalDisc", @class = "form-control", @readonly = "readonly" })
                    </div>

                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Tax Amt.(+)  </label>
                    <div class="col-sm-2">
                        @Html.HiddenFor(m => m.objProduct.TotalTaxPer, new { id = "TotalTaxPercent" })
                        @Html.TextBoxFor(m => m.objProduct.TotalTaxAmount, new { name = "TotalTax", id = "TotalTax", @class = "form-control", @readonly = "readonly" })
                    </div>
                    <label class="col-sm-2 col-form-label"> RoundOff  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.Roundoff, new { name = "RoundOff", id = "RoundOff", @class = "form-control", @readonly = "readonly" })
                    </div>

                    <label class="col-sm-2 col-form-label"> Total Amount  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.TotalPayAmount, new { name = "TotalAmountNet", id = "TotalAmountNet", @class = "form-control", @readonly = "readonly" })
                    </div>

                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Cash Amount  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.CashAmount, new { name = "CashAmount", id = "CashAmount", @class = "form-control", @readonly = "readonly" })
                    </div>
                    <label class="col-sm-2 col-form-label"> Net Payable  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.TotalNetPayable, new { name = "NetPayable", id = "NetPayable", @class = "form-control", @readonly = "readonly" })
                    </div>

                    <label class="col-sm-2 col-form-label" style="display:none;"> Total Weight (gms.)  </label>
                    <div class="col-sm-2" style="display:none;">
                        <input type="email" class="form-control" id="inputEmail3" value="0">
                    </div>

                    <label class="col-sm-2 col-form-label"> Courier Charges  </label>
                    <div class="col-sm-2">
                        @Html.TextBoxFor(m => m.objProduct.CourierCharges, new { name = "CourierCharges", id = "CourierCharges", @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <hr>
                <div class="row">
                    <button type="button" id="BillCalculation" class="btn btn-primary mt-4 mr-1" style="display:none;">Calculate</button>
                    <button type="button" id="SaveDistributorForm" class="btn btn-primary mt-4 mr-1">Save</button>
                    <button type="button" id="hidbtn" style="display:none;" class="btn btn-primary mt-4 mr-1" disabled>
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Wait...
                    </button>
                    <button type="button" id="cancelClick" class="btn btn-info mt-4">Cancel</button>
                </div>
            </form>

        </div>
        <div class="clearfix"> </div>
    </div>

</div>

<script type="text/javascript">
        var IsYes = false;
        var AvailableProductList = [{}];
        var AvailableBarcodeList = [];
        var AvailableBatchcodeList = [];
        var IsEditGrid = false;
        var formdata;
        var IsWalletEntry = false;
        var OTPEntered = false;
        var OTPValue = "";
        var ProductSearchList;
        var ItemList = [];
        var BarcodeItemList = [];
        var OfferItemList = [];
        var OfferItemListDetail = [];
        var BuyOfferItemList = [];
        var grid, dialog;
        var ProductArray;
        var CurrentSelectedProductDetails = null;
        var PrevValueOfDiscPer;
        var SearchText;
        var count = 0;
        var TotalQty = 0;
        var TotalRP = 0;
        var TotalNetBV = 0;
        var TotalNetPV = 0;
        var TotalSumAmount = 0;
        var TotalDisc = 0;
        var TotalTaxtAmt = 0;
        var TotalTaxtPer = 0;
        var TotalSumNetAmount = 0;
        var NetAmounPayable = 0;
        var RoundOff = 0;
        var CashAmount = 0;
        var PayGrid;
        var errorPaymode = false;
        var NetPayableAmountFinal = 0;
        var FinalAmountToPay;
        var LatestAmountEnteresdInPayMode = [{}];
        var IsRegisteredCustomerCheck = true;
        var IsCommissionAdd = 0, IsDiscountAdd = 1;
        var SelectedKitFalse = false;
        var KitDescriptionList;
        var ProductGrid = [{ "Weight": "",
        "TotalWeight": "", "AvailStock": "", "SNo": "", "Code": "",
        "ProductName": "", "MRP": "", "DP": "","NETDP":"", "Rate": "", "BatchNo": "",
        "Barcode": "", "RP": "", "BV": "", "CV": "", "PV": "", "Qty": "", "FreeQty": "",
        "RPValue": "", "BVValue": "", "CVValue": "", "PVValue": "", "CommsnPer": "", "CommsnAmt": "",
        "DiscPer": "", "DiscAmt": "", "Amount": "", "TaxType": "", "TaxPer": "", "TaxAmt": "",
        "TotalAmount": "", "ProductTye": "","IsCalc":"false","Price":"","IsFpv":"No","IsCoupon":"No" }];
        var MaxBillQty = 100;
        var SelectedOfferID = "0";
        var IsOfferProduct = false;
        var StockError = false;
        var OfferProdQty = 0;
        var MinBV4upgrade = 0;
        var MinBV4offer = 0;
        var MaxBV4offer = 0;
        var SelectedInvoiceTypeFalse = false;
        var Frwbalance = 0;
        var prdselectiontype = "";

        // ================= COMMON HELPERS (document.ready ke bahar) =================
        function toNum(v) {
            var n = parseFloat(v);
            return isNaN(n) ? 0 : n;
        }

        function ShowWarn(msg) {
            toastr.warning(msg, 'Warning', {
                closeButton: true,
                progressBar: true,
                positionClass: 'toast-top-right',
                timeOut: 5000,
                extendedTimeOut: 1000
            });
        }

        // grid ki asli rows (placeholder row ko chhod kar)
        function GetRealRows() {
            return $.grep(ProductGrid, function (r) {
                return r && r.SNo !== "" && r.SNo !== null && r.SNo !== undefined;
            });
        }

        // grid ke S.No. ko 1..n me dobara sequence karo
        function RenumberGrid() {
            var n = 1;
            $.each(ProductGrid, function (idx, r) {
                if (r.SNo !== "" && r.SNo !== null && r.SNo !== undefined) { r.SNo = n++; }
            });
            count = n - 1;
        }

        $(document).keydown(function (event) {
            if (event.shiftKey && event.keyCode == 78) {
                $("#DeliveryPlace").focus();
                event.preventDefault();
            }
        });

        $(document).ready(function () {
            getAllProductNames();
            fillGrid();
            changeValues();
            getAllBarcode();
            ApplyAutoTaxType();
            $("#Paymodediv").hide();
            $(".Paymodedivlabel").hide();
            Frwbalance = parseFloat(@WBalance);

            // Clear Product (pehle keydown ke andar bind tha, ab yahan)
            $("#ClearDetails").click(function (e) {
                $("#ProductName").val('');
                $("#Barcode").val('');
                $("#ProductNameList").empty();
                $("#BarcodeList").empty();
                $("#BatchcodeList").empty();
                ProductArray = undefined;
                resetProductDetails();
                changeValues();
            });

            $("#ProductName").focusin(function () {
                if ($("#IdNo").val() == "") {
                    $("#IdNo").focus();
                }
            });

            $("#Barcode").focusin(function () {
                if ($("#IdNo").val() == "") {
                    $("#IdNo").focus();
                }
            });

            $("#Quantity").focusin(function () {
                var SelectedInvoiceTypeVal = $("#SelectedInvoiceType").val();
                if (SelectedInvoiceTypeVal == "") {
                    $("#SelectedInvoiceType").focus();
                    SelectedInvoiceTypeFalse = false;
                    ShowWarn("Please select Invoice Type!");
                }
                else {
                    SelectedInvoiceTypeFalse = true;
                }
            });
            $("#IdNo").focusout(function (e) {
                e.preventDefault();
                e.stopPropagation();
                var Value = $("#IdNo").val();
                if (Value != "")
                    GetCustomerInfo(Value);
            });

            $("#ProductName").autocomplete({
                source: function (request, response) {
                    prdselectiontype = $("#prdselectiontype").val();
                    if (prdselectiontype == "P") {
                        var results = $.ui.autocomplete.filter(ItemList, request.term);
                        response(results.slice(0, 50));
                    }
                    else {
                        var results = $.ui.autocomplete.filter(BarcodeItemList, request.term);
                        response(results.slice(0, 50));
                    }
                },
                minLength: 1,
                scroll: true,
                select: function (event, ui) {
                    prdselectiontype = $("#prdselectiontype").val();
                    $("#ProductName").val(ui.item.label);
                    var productName = ui.item.label;
                    var index = OfferItemList.indexOf(productName);
                    var offerType = $("#OfferType").val();
                    if (SelectedOfferID != "0" && (offerType == "2" || offerType == "3")) {
                        if (index == -1) {
                            GetProductInfo(prdselectiontype, ui.item.label, false, 0);
                            $("#Quantity").focus();
                        }
                        else {
                            ShowWarn("Sorry you can't select offer products.");
                        }
                    }
                    else {
                        GetProductInfo(prdselectiontype, ui.item.label, false, 0);
                        $("#Quantity").focus();
                    }
                    return false;
                },

            }).focus(function () {
                $(this).autocomplete("search", "");
            });

            $("#Quantity").focusout(function () {
                var barcode = $("#BarcodeList").val();
                var offerType1 = $("#OfferType").val();
                var availablestock = toNum($("#StockAvailable").val());
                if (barcode != "" && barcode != "0") {
                    $("#BuyFreeQty").val(0);
                    var qtyCurrent = $("#Quantity").val();
                    if (qtyCurrent != "") {
                        qtyCurrent = parseFloat(qtyCurrent);
                        var offer = false;
                        var flexiible = "Y";
                        var freeQ = 0;
                        if (IsEditGrid == true) {
                            var productName = $("#ProductName").val();
                            var index = ProductGrid.findIndex(x => x.ProductName == productName);
                            if (index != -1) {
                                offer = ProductGrid[index].IsOfferProduct;
                                freeQ = ProductGrid[index].OfferQty;
                                flexiible = ProductGrid[index].IsofferFlexible;
                            }
                        }
                        else {
                            if (IsOfferProduct) {
                                offer = IsOfferProduct;
                                freeQ = CurrentSelectedProductDetails.offerDetail.FreeQty;
                                flexiible = CurrentSelectedProductDetails.offerDetail.IsFlexible;
                            }
                        }
                        if (offer && offerType1 != "2" && offerType1 != "3") {
                            if (flexiible == "Y" && qtyCurrent >= parseInt(CurrentSelectedProductDetails.offerDetail.Qty)) {
                                var Freeq = parseFloat(freeQ);
                                var offset = parseInt(qtyCurrent / parseInt(CurrentSelectedProductDetails.offerDetail.Qty));
                                var totalfree = offset * Freeq;
                                $("#BuyFreeQty").val(totalfree);
                                var tQuantity = totalfree + qtyCurrent;
                                $("#Quantity").val(tQuantity);
                            }

                            else if (flexiible == "N" && qtyCurrent >= parseInt(CurrentSelectedProductDetails.offerDetail.Qty)) {
                                var Freeq = parseFloat(freeQ);
                                $("#BuyFreeQty").val(Freeq);
                                var tQuantity = parseInt(CurrentSelectedProductDetails.offerDetail.FreeQty) + parseInt(CurrentSelectedProductDetails.offerDetail.Qty);
                                $("#Quantity").val(tQuantity);
                            }
                        }
                        if (qtyCurrent > availablestock) {
                            ShowWarn("Insufficient Stock!");
                            $("#Quantity").val(0);
                        }
                        else if (qtyCurrent <= 1000.999) {
                            DoCalculation(false);
                        }
                        else {
                            alert("Please enter quantity less than 1000.999!");
                            $("#Quantity").val(0);
                        }
                    }
                    else {
                        $("#Quantity").val(0);
                    }
                }
                else {
                    $("#Quantity").val(0);
                }
            });

            // =====================================================================
            // ADD PRODUCT IN GRID  (FIXED)
            //  - freeQty -> FreeQty (NaN bug)
            //  - S.No. sirf successful add par
            //  - product select kiye bina add nahi
            //  - duplicate merge me stock check (grid qty + nayi qty)
            // =====================================================================
            $("#AddRecordInGrid").click(function (e) {
                StockError = false;

                // 1. product select hua hai?
                if (ProductArray == undefined || ProductArray == null) {
                    ShowWarn("Please select a product first");
                    IsEditGrid = false;
                    return false;
                }

                var invType = $("#SelectedInvoiceType").val();

                // 2. qty read
                var Qty = toNum($("#Quantity").val());
                if ($("#FreeQty").val() == "") {
                    $("#FreeQty").val('0');
                }
                var tqty = Qty;

                $("#SaveDistributorForm").attr("disabled", false);

                var availStock = toNum(ProductArray.AvailStock);

                // 3. validations
                if (availStock <= 0) {
                    if (ProductArray.ProductTye == "F") {
                        OfferOutOfStock();
                    } else {
                        ShowWarn("InSufficient Stock!");
                    }
                    StockError = true;
                    IsEditGrid = false;
                    return false;
                }

                if (tqty == 0) {
                    ShowWarn("Please Enter Quantity!");
                    $("#Quantity").focus();
                    IsEditGrid = false;
                    return false;
                }

                if (tqty > availStock) {
                    if (ProductArray.ProductTye == "F") {
                        OfferOutOfStock();
                    } else {
                        ShowWarn("Adjust Quantity. Entered Quantity + Free Quantity should be less than available stock");
                    }
                    $("#Quantity").focus();
                    StockError = true;
                    IsEditGrid = false;
                    return false;
                }

                // 4. BV invoice me calculation ke baad add nahi
                if (invType == "BV") {
                    for (var c = 0; c < ProductGrid.length; c++) {
                        if (ProductGrid[c].IsCalc == true || ProductGrid[c].IsCalc == "true") {
                            ShowWarn("You cannot add products due to the grid calculation.");
                            IsEditGrid = false;
                            return false;
                        }
                    }
                }

                // 5. same product + batch grid me pehle se hai?
                var existingIndex = -1;
                for (var i = 0; i < ProductGrid.length; i++) {
                    if (ProductGrid[i].Code == ProductArray.ProdCode &&
                        ProductGrid[i].BatchNo == ProductArray.BatchNo) {
                        existingIndex = i;
                        break;
                    }
                }

                // placeholder row hatao (existingIndex adjust karke)
                if (ProductGrid.length > 0 && (ProductGrid[0].SNo === "" || ProductGrid[0].SNo == null || ProductGrid[0].SNo == undefined)) {
                    ProductGrid = ProductGrid.splice(1);
                    if (existingIndex > 0) { existingIndex--; }
                }

                var isFlexible = "Y";
                var offerq = 0;
                if (CurrentSelectedProductDetails != null && CurrentSelectedProductDetails.offerDetail != null) {
                    isFlexible = CurrentSelectedProductDetails.offerDetail.IsFlexible;
                    offerq = CurrentSelectedProductDetails.offerDetail.FreeQty;
                }

                // ============ NEW PRODUCT ============
                if (existingIndex == -1) {
                    count = GetRealRows().length + 1;
                    ProductArray.SNo = count;
                    var isBV = (invType == "BV");

                    ProductGrid.push({
                        "Weight": ProductArray.Weight, "TotalWeight": ProductArray.TotalWeight,
                        "CatName": ProductArray.CatName, "CatId": ProductArray.CatId, "AvailStock": ProductArray.AvailStock,
                        "SNo": ProductArray.SNo, "Code": ProductArray.ProdCode, "ProductName": ProductArray.ProductName,
                        "MRP": ProductArray.MRP, "DP": ProductArray.DP, "Rate": toNum(ProductArray.Rate).toFixed(2),
                        "BatchNo": ProductArray.BatchNo, "Barcode": ProductArray.Barcode, "RP": ProductArray.RP,
                        "BV": isBV ? ProductArray.BV : 0,
                        "CV": ProductArray.CV,
                        "PV": isBV ? 0 : ProductArray.PV,
                        "Qty": ProductArray.Qty,
                        "RPValue": ProductArray.RPValue,
                        "BVValue": isBV ? ProductArray.BVValue : 0,
                        "CVValue": ProductArray.CVValue,
                        "PVValue": isBV ? 0 : ProductArray.PVValue,
                        "CommsnPer": ProductArray.CommsnPer,
                        "CommsnAmt": toNum(ProductArray.CommssnAmt).toFixed(2),
                        "DiscPer": ProductArray.DiscPer,
                        "DiscAmt": toNum(ProductArray.DiscAmt).toFixed(2),
                        "Amount": toNum(ProductArray.Amount).toFixed(2),
                        "TaxType": ProductArray.TaxType,
                        "TaxPer": toNum(ProductArray.TaxPer).toFixed(2),
                        "TaxAmt": toNum(ProductArray.TaxAmt).toFixed(2),
                        "TotalAmount": toNum(ProductArray.TotalAmt).toFixed(2),
                        "ProductTye": ProductArray.ProductTye,
                        "FreeQty": ProductArray.FreeQty,
                        "OfferQty": offerq, "IsOfferProduct": IsOfferProduct, "IsofferFlexible": isFlexible,
                        "BuyFreeQty": ProductArray.BuyFreeQty, "OriDP": ProductArray.OriDP,
                        "IsCalc": "false", "IsFpv": "No", "IsCoupon": "No"
                    });
                }
                // ============ EXISTING PRODUCT - merge ============
                else if (IsEditGrid == false) {
                    var row = ProductGrid[existingIndex];

                    if (row.IsOfferProduct == false || row.IsOfferProduct == undefined || row.IsofferFlexible == "Y") {

                        var newQty = toNum(row.Qty) + toNum(ProductArray.Qty);
                        var newFreeQty = toNum(row.FreeQty) + toNum(ProductArray.FreeQty);

                        if ((newQty + newFreeQty) <= availStock) {
                            row.Qty = newQty.toFixed(2);
                            row.FreeQty = newFreeQty.toFixed(2);
                            row.BuyFreeQty = toNum(row.BuyFreeQty) + toNum(ProductArray.BuyFreeQty);
                            row.TaxAmt = (toNum(row.TaxAmt) + toNum(ProductArray.TaxAmt)).toFixed(2);
                            row.TaxPer = toNum(row.TaxPer).toFixed(2);
                            row.DiscAmt = (toNum(row.DiscAmt) + toNum(ProductArray.DiscAmt)).toFixed(2);
                            row.TotalAmount = (toNum(row.TotalAmount) + toNum(ProductArray.TotalAmt)).toFixed(2);
                            row.Amount = (toNum(row.Amount) + toNum(ProductArray.Amount)).toFixed(2);
                            row.Rate = toNum(ProductArray.Rate).toFixed(2); // per-unit rate, add nahi karna
                            row.CommsnAmt = (toNum(row.CommsnAmt) + toNum(ProductArray.CommssnAmt)).toFixed(2);
                            row.RPValue = (toNum(row.RPValue) + toNum(ProductArray.RPValue)).toFixed(2);
                            row.CVValue = (toNum(row.CVValue) + toNum(ProductArray.CVValue)).toFixed(2);
                            if (invType == "BV") {
                                row.BVValue = (toNum(row.BVValue) + toNum(ProductArray.BVValue)).toFixed(2);
                            } else {
                                row.PVValue = (toNum(row.PVValue) + toNum(ProductArray.PVValue)).toFixed(2);
                            }
                        }
                        else {
                            StockError = true;
                            ShowWarn("Total quantity (already in grid + new) exceeds available stock");
                            $("#Quantity").focus();
                            IsEditGrid = false;
                            return false;
                        }
                    }
                    else {
                        ShowWarn("This offer product is already in grid.");
                        IsEditGrid = false;
                        return false;
                    }
                }
                // ============ EDIT MODE (grid row click karke edit) ============
                else {
                    var r = ProductGrid[existingIndex];
                    r.Qty = toNum(ProductArray.Qty).toFixed(2);
                    r.FreeQty = toNum(ProductArray.FreeQty).toFixed(2);
                    r.BuyFreeQty = ProductArray.BuyFreeQty;
                    r.TaxAmt = toNum(ProductArray.TaxAmt).toFixed(2);
                    r.TaxPer = toNum(ProductArray.TaxPer).toFixed(2);
                    r.DiscAmt = toNum(ProductArray.DiscAmt).toFixed(2);
                    r.TotalAmount = toNum(ProductArray.TotalAmt).toFixed(2);
                    r.Amount = toNum(ProductArray.Amount).toFixed(2);
                    r.Rate = toNum(ProductArray.Rate).toFixed(2);
                    r.CommsnAmt = toNum(ProductArray.CommssnAmt).toFixed(2);
                    r.RPValue = toNum(ProductArray.RPValue).toFixed(2);
                    r.CVValue = toNum(ProductArray.CVValue).toFixed(2);
                    if (invType == "BV") {
                        r.BVValue = toNum(ProductArray.BVValue).toFixed(2);
                    } else {
                        r.PVValue = toNum(ProductArray.PVValue).toFixed(2);
                    }
                }

                // 6. grid refresh + reset
                fillGrid();
                CalculateTotals();
                resetProductDetails();
                $("#ProductName").val('');
                $("#Barcode").val('');
                $("#ProductNameList").empty();
                $("#BarcodeList").empty();
                $("#BatchcodeList").empty();

                // add ho gaya - purana ProductArray dobara use na ho
                ProductArray = undefined;

                if ($("#prdselectiontype").val() == "P") {
                    $("#ProductName").focus();
                } else {
                    $("#Barcode").focus();
                }

                IsEditGrid = false;
            });

            // Save button wapas normal state me laane ke liye
            function ResetSaveButton() {
                $("#SaveDistributorForm").attr("disabled", false);
                $("#hidbtn").hide();
                $("#SaveDistributorForm").show();
            }

            // grid me shuruaat me ek khaali placeholder row hoti hai (SNo = ""), usse chhod kar ginti
            function GetValidProductCount() {
                return GetRealRows().length;
            }

            $("#SaveDistributorForm").click(function (e) {
                $("#SaveDistributorForm").attr("disabled", true);
                $("#hidbtn").show();
                $("#SaveDistributorForm").hide();
                errorPaymode = false;
                var SelectedInvoiceTypeVal = $("#SelectedInvoiceType").val();
                if (SelectedInvoiceTypeVal == '') {
                    ShowWarn("Please select invoice type");
                    ResetSaveButton();
                    return false;
                }

                if ($.trim($("#IdNo").val()) == "") {
                    ShowWarn("Please enter IdNo");
                    ResetSaveButton();
                    $("#IdNo").focus();
                    return false;
                }

                if (GetValidProductCount() <= 0) {
                    ShowWarn("Please select atleast one product");
                    ResetSaveButton();
                    return false;
                }

                if (SelectedInvoiceTypeVal == "PV") {
                    var TotalAmountNetVal = parseFloat($("#TotalAmountNet").val()) || 0;
                    if (TotalAmountNetVal < 3000) {
                        toastr.warning("For Activation, Total Amount should be minimum ₹3000.", 'Warning', {
                            closeButton: true,
                            progressBar: true,
                            positionClass: 'toast-top-right',
                            timeOut: 6000,
                            extendedTimeOut: 1500
                        });
                        ResetSaveButton();
                        return false;
                    }
                    // PV (Activation): validation pass -> bill save
                    SaveBill();
                }
                else if (SelectedInvoiceTypeVal == "BV") {
                    var offercheckedCount = $('.bvoffer:checked').length;
                    if (offercheckedCount >= 1) {
                        for (var i = 0; i < ProductGrid.length; i++) {
                            if (ProductGrid[i].SNo != "") {
                                if (ProductGrid[i].IsCalc == "false") {
                                    ShowWarn("Please apply calculation before submit");
                                    $('#collapseExample').collapse('show');
                                    ResetSaveButton();
                                    return false;
                                }

                                if ($('#IsCU').is(":checked") && ProductGrid[i].IsCoupon == "No") {
                                    ShowWarn("You check coupon but you can't calculate.");
                                    $('#collapseExample').collapse('show');
                                    ResetSaveButton();
                                    return false;
                                }
                                if ($('#IsV').is(":checked") && ProductGrid[i].IsFpv == "No") {
                                    ShowWarn("You check FPV but you can't calculate.");
                                    $('#collapseExample').collapse('show');
                                    ResetSaveButton();
                                    return false;
                                }
                            }
                        }
                    }

                    $.ajax({
                        url: '/Transaction/GetWalletBalance',
                        dataType: 'JSON',
                        method: 'GET',
                        data: { Waltype: 'B' },
                        success: function (data) {
                            SaveBill();
                        },
                        error: function (error) {
                            console.log(error);
                            toastr.error("Wallet balance check failed. Please try again.", 'Error', {
                                closeButton: true, progressBar: true, positionClass: 'toast-top-right',
                                timeOut: 6000, extendedTimeOut: 1500
                            });
                            ResetSaveButton();
                        }
                    });
                }
                else {
                    ResetSaveButton();
                }

            });

            function CVClaculation() {
                var hidfpamt = $("#hidfpamt").val();
                var hidcamt = $("#hidcamt").val();
                var fphalf = 0;
                if ($("#IsCU").is(":checked") == true && $("#IsV").is(":checked") == false) {
                    if ($("#Coupon").val() != "") {
                        if (TotalNetBV <= parseFloat(hidcamt)) {
                            SetBVTextbox(TotalNetBV);
                        }
                        else {
                            SetBVTextbox(hidcamt);
                        }
                    }
                }
                else if ($("#IsCU").is(":checked") == false && $("#IsV").is(":checked") == true) {
                    fphalf = parseFloat(hidfpamt) / 2;
                    if (TotalNetBV <= fphalf) {
                        SetBVTextbox(TotalNetBV);
                    }
                    else {
                        SetBVTextbox(fphalf);
                    }
                }
                else if ($("#IsV").is(":checked") == true && $("#IsCU").is(":checked") == true) {
                    if ($("#Coupon").val() != "" && $("#FpVoucher").val() != "") {
                        fphalf = parseFloat(hidfpamt) / 2;
                        var temptot = parseFloat(fphalf) + parseFloat(hidcamt);
                        if (TotalNetBV <= temptot) {
                            SetBVTextbox(TotalNetBV);
                        }
                        else {
                            SetBVTextbox(temptot);
                        }
                    }
                }
                else if ($("#IsV").is(":checked") == false && $("#IsCU").is(":checked") == false) {
                    SetBVTextbox(0);
                }
            }
            $("#paymodeclose").click(function (e) {
                $('#collapseExample').collapse('hide');
            });
            $("#cancelClick").click(function (e) {
                if (confirm("Are you sure you want to cancel")) {
                    window.location.reload();
                }
            });
            $("#BillCalculation").click(function (e) {
                if (GetRealRows().length <= 0) {
                    ShowWarn("Please select atleast one product");
                    return false;
                }

                var totalfpvBalance = parseFloat($("#vamt").val()) || 0;
                var FPVBalance = parseFloat($("#vamt").val()) || 0;
                if (totalfpvBalance === 0) {
                    toastr.error("You currently have no FPV balance available to apply to this order.", 'Error', {
                        closeButton: true,
                        progressBar: true,
                        positionClass: 'toast-top-right',
                        timeOut: 8000,
                        extendedTimeOut: 2000
                    });
                    return false;
                }

                var TotalAmountNet = $("#TotalAmountNet").val();
                var totalBill = parseFloat(TotalAmountNet) || 0;
                var totalfpvBalance = parseFloat(FPVBalance) || 0;
                var allowedFPV = Math.floor(totalBill / 2);
                var finalFPV = Math.min(totalfpvBalance, allowedFPV);
                if (totalBill < (finalFPV * 2)) {
                    toastr.error("Discount applicable only on orders above " + totalBill + ".", 'Error', {
                        closeButton: true,
                        progressBar: true,
                        positionClass: 'toast-top-right',
                        timeOut: 8000,
                        extendedTimeOut: 2000
                    });
                    return false;
                }

                if (finalFPV > 0) {
                    $("#hidfpamt").val(finalFPV);
                    $("#AmountByVoucher").val(finalFPV);
                } else {
                    $("#hidfpamt").val('0');
                    $("#AmountByVoucher").val('0');
                }

                var FpvAmount = $("#AmountByVoucher").val();
                var Couponamount = $("#AmountbyCoupon").val();

                var Totaladjustamount = parseFloat(FpvAmount) + parseFloat(Couponamount);
                if (Totaladjustamount == 0) {
                    ShowWarn("Please select FPV or Coupon for calculation");
                    return false;
                }
                var passwvarify = $("#passwvarify").val();
                if (passwvarify == "false") {
                    ShowWarn("Please varify user.");
                    $("#userpassw").focus();
                    return false;
                }
                var totalDP = ProductGrid.reduce(function (sum, item) {
                    var dp = parseFloat(item.DP);
                    var qty = parseFloat(item.Qty);
                    dp = isNaN(dp) ? 0 : dp;
                    qty = isNaN(qty) ? 0 : qty;
                    return sum + (dp * qty);
                }, 0);
                var DiscPer = (Totaladjustamount / (parseFloat(totalDP))) * 100;
                DiscPer = parseFloat(DiscPer).toFixed(2);
                for (var i = 0; i < ProductGrid.length; i++) {
                    if (ProductGrid[i].SNo != "") {
                        ProductGrid[i].DiscPer = parseFloat(DiscPer);
                        var DiscountAmt = (parseFloat(ProductGrid[i].DP) * parseFloat(ProductGrid[i].Qty)) * (parseFloat(DiscPer) / 100);
                        DiscountAmt = parseFloat(DiscountAmt).toFixed(2);
                        ProductGrid[i].DiscAmt = DiscountAmt;
                        var NETDP = parseFloat(ProductGrid[i].DP) - (ProductGrid[i].DP * (DiscPer / 100));
                        NETDP = parseFloat(NETDP).toFixed(2);
                        var TaxPer = parseFloat(ProductGrid[i].TaxPer) / 100;
                        var Price = ((NETDP * ProductGrid[i].Qty) * 100) / (parseFloat(ProductGrid[i].TaxPer) + 100);
                        Price = parseFloat(Price).toFixed();
                        var Taxamount = parseFloat(Price) * TaxPer;
                        var finalamount = NETDP * ProductGrid[i].Qty;
                        finalamount = parseFloat(finalamount).toFixed(2);
                        ProductGrid[i].TaxAmt = Taxamount.toFixed(2);
                        ProductGrid[i].TotalAmount = finalamount;
                        ProductGrid[i].NETDP = NETDP;
                        ProductGrid[i].Price = Price;
                        ProductGrid[i].IsCalc = true;
                        ProductGrid[i].Rate = Price;
                        ProductGrid[i].Amount = Price;

                        if ($('#IsCU').is(":checked")) {
                            ProductGrid[i].IsCoupon = "Yes";
                        }
                        if ($('#IsV').is(":checked")) {
                            ProductGrid[i].IsFpv = "Yes";
                        }
                    }
                }
                fillGrid();
                CalculateTotals();
                var totaladfp = parseFloat($("#AmountByVoucher").val()) || 0;
                var totalBVValue = parseFloat($("#TotalBV").val()) || 0;

                if (totaladfp > 0) {
                    var calculated = totalBVValue - (totaladfp / 2);
                    $("#TotalAdBV").val(Math.max(0, calculated));
                } else {
                    $("#TotalAdBV").val(totalBVValue);
                }
                $('#collapseExample').collapse('hide');
            });

