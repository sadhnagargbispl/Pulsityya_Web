        function GetCustomerInfo(IdNo) {
            $.ajax({
                url: '/Transaction/GetCustInfo',
                dataType: 'JSON',
                method: 'POST',
                data: { IdNo: IdNo },

                success: function (objResult) {

                    if (objResult == null) {
                        return;
                    }

                    // Record not found
                    if (objResult.name == "") {
                        ShowWarn("Record does not exist.");
                        $("#IdNo").val('');
                        return;
                    }

                    // Blocked ID
                    if (objResult.isBlock == true) {
                        ShowWarn("Blocked ID not allowed.");
                        $("#IdNo").val('');
                        return;
                    }
                    var SelectedInvoiceTypeVal = $("#SelectedInvoiceType").val();

                    // PV (Activation): already active ID allowed nahi
                    if (SelectedInvoiceTypeVal == "PV") {
                        if (objResult.isActive == true) {
                            ShowWarn("Your ID is already active. You can proceed with the repurchase.");
                            $("#IdNo").val('');
                            return;
                        }
                    }

                    // BV (Repurchase): deactive ID allowed nahi - pehle Activation invoice zaroori hai
                    if (SelectedInvoiceTypeVal == "BV") {
                        if (objResult.isActive != true) {
                            toastr.warning("This ID is not active. Repurchase allowed only for active IDs - please raise an Activation invoice first.", "Warning", {
                                closeButton: true,
                                progressBar: true,
                                positionClass: "toast-top-right",
                                timeOut: 8000,
                                extendedTimeOut: 2000
                            });
                            $("#IdNo").val('');
