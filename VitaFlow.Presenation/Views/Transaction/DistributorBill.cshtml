    function CalculateTotals() {
        if (ProductGrid != null) {
            var TotalBV = 0;
            var TotalCV = 0;
            var TotalPV = 0;
            var TotalWeight = 0;
            var TotalDiscountPer = 0;
            var TotalCommsonAmt = 0;
            TotalQty = 0;
            TotalRP = 0;            // pehle reset nahi hota tha - har call par jama hota gaya
            TotalSumNetAmount = 0;
            TotalTaxtAmt = 0;
            TotalDisc = 0;
            TotalSumAmount = 0;
            TotalTaxPer = 0;
            for (var i = 0; i < ProductGrid.length; i++) {
                if (ProductGrid[i].SNo != "") {
                    TotalWeight += parseFloat(ProductGrid[i].TotalWeight) || 0;
                    TotalBV += parseFloat(ProductGrid[i].BVValue);
                    TotalCV += parseFloat(ProductGrid[i].CVValue);
                    TotalPV += parseFloat(ProductGrid[i].PVValue);
                    TotalDiscountPer += parseFloat(ProductGrid[i].DiscPer);
                    TotalCommsonAmt += parseFloat(ProductGrid[i].CommsnAmt);
                    TotalQty += parseFloat(ProductGrid[i].Qty);
                    TotalRP += parseFloat(ProductGrid[i].RPValue);
                    TotalTaxPer += parseFloat(ProductGrid[i].TaxPer);
                    TotalSumAmount += parseFloat(ProductGrid[i].Amount);
                    TotalDisc += parseFloat(ProductGrid[i].DiscAmt);
                    TotalTaxtAmt += parseFloat(ProductGrid[i].TaxAmt);
                    TotalSumNetAmount += parseFloat(ProductGrid[i].TotalAmount);
                }
            }
            CashAmount = $("#CashAmount").val();
            if (CashAmount != "") {
                CashAmount = parseFloat(CashAmount);
            }
            var total = parseFloat(TotalSumNetAmount) || 0;

            // Round to nearest integer
            var netPayable = Math.round(total);

            // Round off (2 decimal precision)
            var RoundOff = Math.round((netPayable - total) * 100) / 100;
            NetAmounPayable = (parseFloat(TotalSumNetAmount) + RoundOff);
            TotalNetBV = TotalBV;

            $("#TotalBV").val(TotalBV);
            $("#TotalCommsonAmt").val(TotalCommsonAmt);
            $("#TotalCV").val(TotalCV);
            $("#TotalPV").val(TotalPV);
            $("#TotalDiscPer").val(TotalDiscountPer.toFixed(2));
            $("#TotalRP").val(TotalRP);
            $("#TotalQty").val(TotalQty);
            $("#TotalTotalAmount").val(TotalSumAmount.toFixed(2));
            $("#TotalDisc").val(TotalDisc.toFixed(2));
            $("#TotalTax").val(TotalTaxtAmt.toFixed(2));
            $("#TotalTaxPercent").val(TotalTaxPer.toFixed(2));   // pehle TotalTaxtPer (hamesha 0) dikhta tha
            $("#TotalAmountNet").val(TotalSumNetAmount.toFixed(2));
            $("#RoundOff").val(RoundOff.toFixed(2));
            $("#CashAmount").val(NetAmounPayable);
            $("#NetPayable").val(NetAmounPayable);
            $("#TotalWeight").val(TotalWeight);
            FinalAmountToPay = NetAmounPayable;
            getCourierCharge();
        }
    }

    function resetProductDetails() {
        $("#DP").val(0);
        $("#Quantity").val(0);
        $("#FreeQty").val(0);
        $("#StockAvailable").val(0);
        $("#DiscPer").val(0);
        $("#DiscAmt").val(0);
        $("#Amount").val(0);
        $("#TaxPer").val(0);
        $("#TaxAmt").val(0);
        $("#TotalAmount").val(0);
        $("#BuyFreeQty").val(0);
    }

    // NOTE: ClearProductdetailsWithoutChangingValues() ka definition aapke original
    // code me is file me nahi tha (shayad _Layout ya kisi common JS me hai). Agar wahan
    // nahi hai to GetProductInfo me "No Product Found" par ReferenceError aayega -
    // neeche ek safe fallback hai jo sirf tab banta hai jab pehle se defined na ho.
    if (typeof ClearProductdetailsWithoutChangingValues !== "function") {
        window.ClearProductdetailsWithoutChangingValues = function () {
            resetProductDetails();
            ProductArray = null;
        };
    }

    function SaveBill() {

        var ListObjStr = JSON.stringify(ProductGrid);
        $("#ListObjHidden").val(ListObjStr);
        formdata = new FormData($("#distributorForm")[0]);
        $.ajax({
            url: '@Url.Action("SaveDistributorBill", "Transaction")',
            type: 'POST',
            data: formdata,
            processData: false,
            contentType: false,
            dataType: "json",
            success: function (objResponse) {
                $("#hidbtn").hide();
                $("#SaveDistributorForm").show();
                $("#SaveDistributorForm").attr("disabled", false);
                if (objResponse != null) {

                    if (objResponse.responseStatus == "OK") {

                        toastr.success(objResponse.responseMessage, 'success', {
                            closeButton: true, progressBar: true, positionClass: 'toast-top-right',
                            timeOut: 5000, extendedTimeOut: 1000
                        });
                        setTimeout(function () {
                            window.location.href = '/Transaction/DistributorBill';
                        }, 1000);
                    }
                    else {
                        toastr.error(objResponse.responseMessage, 'Warning', {
                            closeButton: true, progressBar: true, positionClass: 'toast-top-right',
                            timeOut: 5000, extendedTimeOut: 1000
                        });
                    }
                }
            },
            error: function (xhr, data) {
                console.log(xhr);
                console.log("Error:", data);
                // error par bhi button wapas laana zaroori hai, warna page stuck dikhta hai
                ResetSaveButton();
                toastr.error("Bill save nahi ho paaya. Please try again.", 'Error', {
                    closeButton: true, progressBar: true, positionClass: 'toast-top-right',
                    timeOut: 6000, extendedTimeOut: 1500
                });
            }
        });
    }

    function FillGridValuesInTextBox(objResult) {
        IsEditGrid = true;
        var selType = $("#prdselectiontype").val();
        var TempProductArray = [];
        TempProductArray.push({ "Weight": objResult.Weight, "TotalWeight": objResult.TotalWeight, "CatName": objResult.CatName, "CatId": objResult.CatId, "AvailStock": objResult.AvailStock, "SNo": objResult.SNo, "ProductName": objResult.ProductName, "BatchNo": objResult.BatchNo, "Barcode": objResult.Barcode, "ProdCode": objResult.Code, "Qty": objResult.Qty, "TaxType": objResult.TaxType, "MRP": objResult.MRP, "DP": objResult.DP, "OriDP": objResult.OriDP, "RP": objResult.RP, "BV": objResult.BV, "CV": objResult.CV, "PV": objResult.PV, "CommsnPer": objResult.CommsnPer, "DiscPer": objResult.DiscPer, "TaxPer": objResult.TaxPer, "CommssnAmt": objResult.CommsnAmt, "TaxAmt": objResult.TaxAmt, "RPValue": objResult.RPValue, "CVValue": objResult.CVValue, "PVValue": objResult.PVValue, "BVValue": objResult.BVValue, "DiscAmt": objResult.DiscAmt, "Amount": objResult.Amount, "TotalAmt": objResult.TotalAmount, "Rate": objResult.Rate });
        if (selType == "P") {
            $("#ProductName").val(objResult.ProductName);
            fillBarcodeList(objResult.ProductName);
        }
        else {
            $("#ProductName").val(objResult.Barcode);
            fillBarcodeList(objResult.ProductName);
            for (var i = 0; i < AvailableProductList.length; i++) {
                $("#ProductList").append("<option value=" + AvailableProductList[i].ProdCode + ">" + AvailableProductList[i].ProductName + "</option>");
            }
            $("#ProductList").val(objResult.Code);
        }
        fillBatchcodeList(objResult.ProductName);
        $("#BatchcodeList").val(objResult.BatchNo);
        $("#BarcodeList").val(objResult.Barcode);
        $("#StockAvailable").val(objResult.AvailStock);
        $("#DP").val(objResult.DP);
        $("#DiscPer").val(objResult.DiscPer);
        $("#DiscAmt").val(objResult.DiscAmt);
        $("#TaxPer").val(objResult.TaxPer);
        $("#TaxAmt").val(objResult.TaxAmt);
        $("#Amount").val(objResult.Amount);
        $("#TotalAmount").val(objResult.TotalAmount);
        $("#BuyFreeQty").val(objResult.BuyFreeQty);

        if (objResult.IsOfferProduct) {
            if (objResult.IsofferFlexible == "N") {
                $("#Quantity").val(objResult.Qty);
                $("#Quantity").attr("readonly", true);
                $("#FreeQty").val(objResult.FreeQty);
            }
            else {
                $("#Quantity").val(objResult.Qty);
                $("#Quantity").attr("readonly", false);
                if (objResult.FreeQty == "") {
                    $("#FreeQty").val('0');
                }
                else {
                    $("#FreeQty").val(objResult.FreeQty);
                }
            }
        }
        else {
            $("#Quantity").val(objResult.Qty);
            $("#Quantity").attr("readonly", false);
            $("#FreeQty").val(objResult.FreeQty);
        }
        ProductArray = TempProductArray[0];
        $("#Quantity").focus();
    }
</script>
