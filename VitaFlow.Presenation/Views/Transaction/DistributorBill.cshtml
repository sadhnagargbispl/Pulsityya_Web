                                            "BarCode": objResult[i].barcode,
                                            "BatchCode": objResult[i].batchNo });
                                    }

                                    fillBarcodeList(objResult[0].productName);
                                }
                                if (isProductSearch == "B") {
                                    for (var i = 0; i < objResult.length; i++) {
                                        $("#BarcodeHidden").val(objResult[i].barcode);
                                        AvailableBarcodeList.push({ "ProductName": objResult[i].productName,
                                            "BarCode": objResult[i].barcode, "BatchCode": objResult[i].batchNo });
                                    }
                                    fillBarcodeList(objResult[0].productName);
                                    var f = true;
                                    for (var i = 0; i < objResult.length; i++) {
                                        if (f == true) {
                                            f = false;
                                            $("#ProductHidden").val(objResult[i].productName);
                                        }
                                        AvailableProductList = AvailableProductList.splice(1);
                                        AvailableProductList.push({ "ProdCode": objResult[i].productCodeStr, "ProductName": objResult[i].productName });
                                        $("#ProductNameList").append("<option value=" + objResult[i].productCodeStr + ">" + objResult[i].productName + "</option>");
                                    }
                                }
                                if (AvailableBatchcodeList != null && AvailableBatchcodeList.length > 0) {
                                    AvailableBatchcodeList = $.grep(AvailableBatchcodeList, function (e) {
                                        return e.ProductName != objResult[0].ProductName;
                                    });
                                }
                                for (var i = 0; i < objResult[0].batchdetail.length; i++) {
                                    AvailableBatchcodeList.push({ "BatchCode": objResult[0].batchdetail[i].batchNo, "ProductName": objResult[0].batchdetail[i].ProductName });
                                }
                                fillBatchcodeList(objResult[0].ProductName);
                                fillProductValues(objResult[0], offerProduct, offerQty, IsSpclOffer);
                            }
                            else {
                                WarnToast("You can select this product only with a valid offer.");
                                ClearProductdetailsWithoutChangingValues();
                                return;
                            }
                        }
                        else {
                            WarnToast("No Product Found!");
                            ClearProductdetailsWithoutChangingValues();
                        }
                    },
                    error: function (xhr, data) {
                        console.log(xhr);
                        console.log("Error:", data);
                    }
                });
