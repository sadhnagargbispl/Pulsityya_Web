                        }
                    }

                    // Fill Customer Information
                    $("#IsActive").val(objResult.isActive);
                    $("#FormNo").val(objResult.formNo);
                    $("#IdNo").val(objResult.idNo);
                    $("#Name").val(objResult.name);

                    var Address = objResult.cityName + " [" + objResult.stateName + "]";
                    $("#Address").val(Address);

                    $("#DistrictName").val(objResult.districtName);
                    $("#ReferenceIdNo").val(objResult.referenceIdNo);
