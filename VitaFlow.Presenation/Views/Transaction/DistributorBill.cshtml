    // ID daalte hi Invoice Type ke options ID ki state ke hisaab se set karta hai:
    //   ID active NAHI hai              -> sirf Activation(A).
    //   ID active HAI                   -> Upgrade(T) + Repurchase(R), default Upgrade.
    //   ID top package par pahunch gayi  -> Upgrade band, seedha Repurchase(R).
    function SetInvoiceTypeByIdStatus(IsActive, CanUpgrade, KitName) {
        var idActive = (IsActive == true || IsActive == "True" || IsActive == "true");
        var canUpg = (CanUpgrade === undefined || CanUpgrade === null)
                     ? true
                     : (CanUpgrade == true || CanUpgrade == "True" || CanUpgrade == "true");
        var $sel = $("#SelectedInvoiceType");

        $sel.find("option[value='A']").prop("disabled", idActive);
        $sel.find("option[value='T']").prop("disabled", !idActive || !canUpg);
        $sel.find("option[value='R']").prop("disabled", !idActive);

        $sel.find("option[value='T']").text(
            (idActive && !canUpg)
                ? "Top package" + (KitName ? " (" + KitName + ")" : "") + " - only Repurchase"
                : "Upgrade");

        var cur = $sel.val();
        if ((cur == "A" && idActive)
            || ((cur == "T" || cur == "R") && !idActive)
            || (cur == "T" && !canUpg)) {
            $sel.val("");
        }

        if ($sel.val() == "" || $sel.val() == null) {
            $sel.val(!idActive ? "A" : (canUpg ? "T" : "R"));
        }
        $("#hiddenSelectedInvoiceType").val($sel.val());

        getAllProductNames();
    }

