    // Bill Tax Type state ke hisaab se automatic: same state => CGST & SGST, warna IGST.
    function ApplyAutoTaxType() {
        var loginStateCode = parseFloat($("#LoginStateCode").val());
        var custStateCode = parseFloat($("#StateCode").val());
        var taxType = "CS";

        if (!isNaN(loginStateCode) && loginStateCode > 0 && !isNaN(custStateCode) && custStateCode > 0
            && loginStateCode !== custStateCode) {
            taxType = "I";
        }

        $("#TaxType").val(taxType);
        $("#TaxTypeDisplay").val(taxType === "I" ? "IGST" : "CGST & SGST");
    }

