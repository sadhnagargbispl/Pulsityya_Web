        function CalculateTotals() {
            if (ProductGrid != null) {
                var TotalBV = 0;
                var TotalCV = 0;
                var TotalPV = 0;
                var TotalWeight = 0;
                TotalQty = 0;
                TotalRP = 0;
                var TotalDiscountPer = 0;
                var TotalCommsonAmt = 0;
                TotalSumNetAmount = 0;
                TotalTaxtAmt = 0;
                TotalTaxtPer = 0;
                TotalDisc = 0;
                TotalSumAmount = 0;
                for (var i = 0; i < ProductGrid.length; i++) {
                    if (ProductGrid[i].SNo != "") {
                        TotalWeight += toNum(ProductGrid[i].TotalWeight);
                        TotalBV += toNum(ProductGrid[i].BVValue);
                        TotalCV += toNum(ProductGrid[i].CVValue);
                        TotalPV += toNum(ProductGrid[i].PVValue);
                        TotalDiscountPer += toNum(ProductGrid[i].DiscPer);
                        TotalCommsonAmt += toNum(ProductGrid[i].CommsnAmt);
                        TotalQty += toNum(ProductGrid[i].Qty);
                        TotalRP += toNum(ProductGrid[i].RPValue);
                        TotalTaxtPer += toNum(ProductGrid[i].TaxPer);
                        TotalSumAmount += toNum(ProductGrid[i].Amount);
                        TotalDisc += toNum(ProductGrid[i].DiscAmt);
                        TotalTaxtAmt += toNum(ProductGrid[i].TaxAmt);
                        TotalSumNetAmount += toNum(ProductGrid[i].TotalAmount);
                    }
                }
                CashAmount = $("#CashAmount").val();
                if (CashAmount != "") {
                    CashAmount = parseFloat(CashAmount);
                }
                var total = parseFloat(TotalSumNetAmount) || 0;

                // Round to nearest integer
                var netPayable = Math.round(total);

                // Calculate round off (2 decimal precision)
                var RoundOff = Math.round((netPayable - total) * 100) / 100;
                NetAmounPayable = (parseFloat(TotalSumNetAmount) + RoundOff);
                TotalNetBV = TotalBV;
                //display in textboxes
                $("#TotalBV").val(TotalBV);
                $("#TotalCommsonAmt").val(TotalCommsonAmt);
                $("#TotalCV").val(TotalCV);
                $("#TotalPV").val(TotalPV);
                $("#TotalDiscPer").val(TotalDiscountPer.toFixed(2));
                $("#TotalRP").val(TotalRP);
                $("#TotalQty").val(TotalQty);
                $("#TotalTotalAmount").val(TotalSumAmount.toFixed(2));
                $("#TotalDisc").val(TotalDisc.toFixed(2));
                $("#TotalTax").val(TotalTaxtAmt.toFixed(2));
                $("#TotalTaxPercent").val(TotalTaxtPer.toFixed(2));
                $("#TotalAmountNet").val(TotalSumNetAmount.toFixed(2));
                $("#RoundOff").val(RoundOff.toFixed(2));
                $("#CashAmount").val(NetAmounPayable);
                $("#NetPayable").val(NetAmounPayable);
                $("#TotalWeight").val(TotalWeight);
                FinalAmountToPay = NetAmounPayable;
                getCourierCharge();
            }
        }
        function getCourierCharge() {
            var weight = $("#TotalWeight").val();
            $.ajax({
                url: '/Transaction/GetCourierCharge',
                dataType: 'JSON',
                method: 'GET',
                data: { 'PackageWeight': weight },
                success: function (data) {
                    $("#CourierCharge").val(data);
                },
                error: function (error) {
                    console.log(error);
                }
            });
        }
        function resetProductDetails() {
            $("#DP").val(0);
            $("#Quantity").val(0);
            $("#FreeQty").val(0);
            $("#StockAvailable").val(0);
            $("#DiscPer").val(0);
            $("#DiscAmt").val(0);
            $("#Amount").val(0);
            $("#TaxPer").val(0);
            $("#TaxAmt").val(0);
            $("#TotalAmount").val(0);
            $("#BuyFreeQty").val(0);
        }

        // NOTE: ClearProductdetailsWithoutChangingValues original page me define nahi tha
        // (call hota tha, JS error aata tha). Safe version yahan add kiya hai.
        function ClearProductdetailsWithoutChangingValues() {
            ProductArray = undefined;
            resetProductDetails();
        }

        function SaveBill() {

            var ListObjStr = JSON.stringify(ProductGrid);
            $("#ListObjHidden").val(ListObjStr);
            formdata = new FormData($("#distributorForm")[0]);
            $.ajax({
                url: '@Url.Action("SaveDistributorBill", "Transaction")',
                type: 'POST',
                data: formdata,
                processData: false,
                contentType: false,
                dataType: "json",
                success: function (objResponse) {
                    $("#hidbtn").hide();
                    $("#SaveDistributorForm").show();
                    $("#SaveDistributorForm").attr("disabled", false);
                    if (objResponse != null) {

                        if (objResponse.responseStatus == "OK") {

                            toastr.success(objResponse.responseMessage, 'success', {
                                closeButton: true,
                                progressBar: true,
                                positionClass: 'toast-top-right',
                                timeOut: 5000,
                                extendedTimeOut: 1000
                            });
                            setTimeout(function () {
                                window.location.href = '/Transaction/DistributorBill';
                            }, 1000);
                        }
                        else {
                            toastr.error(objResponse.responseMessage, 'Warning', {
                                closeButton: true,
                                progressBar: true,
                                positionClass: 'toast-top-right',
                                timeOut: 5000,
                                extendedTimeOut: 1000
                            });

                        }
                    }
                },
                error: function (xhr, data) {
                    console.log(xhr);
                    console.log("Error:", data);
                    $("#hidbtn").hide();
                    $("#SaveDistributorForm").show();
                    $("#SaveDistributorForm").attr("disabled", false);
                    toastr.error("Bill save nahi ho paaya. Please try again.", 'Error', {
                        closeButton: true, progressBar: true, positionClass: 'toast-top-right',
                        timeOut: 6000, extendedTimeOut: 1500
                    });
                }
            });
        }
        function FillGridValuesInTextBox(objResult) {
            IsEditGrid = true;
            SearchText = $("#prdselectiontype").val();
            var TempProductArray = [{}];
            if ((TempProductArray[0].SNo) != undefined) {
                TempProductArray = TempProductArray.splice(1);
            }
            TempProductArray.push({ "CatName": objResult.CatName, "CatId": objResult.CatId, "AvailStock": objResult.AvailStock, "SNo": objResult.SNo, "ProductName": objResult.ProductName, "BatchNo": objResult.BatchNo, "Barcode": objResult.Barcode, "ProdCode": objResult.Code, "Qty": objResult.Qty, "TaxType": objResult.TaxType, "MRP": objResult.MRP, "DP": objResult.DP, "OriDP": objResult.OriDP, "RP": objResult.RP, "BV": objResult.BV, "CV": objResult.CV, "PV": objResult.PV, "CommsnPer": objResult.CommsnPer, "DiscPer": objResult.DiscPer, "TaxPer": objResult.TaxPer, "CommssnAmt": objResult.CommsnAmt, "TaxAmt": objResult.TaxAmt, "RPValue": objResult.RPValue, "CVValue": objResult.CVValue, "PVValue": objResult.PVValue, "BVValue": objResult.BVValue, "DiscAmt": objResult.DiscAmt, "Amount": objResult.Amount, "TotalAmt": objResult.TotalAmount, "Rate": objResult.Rate });
            if (SearchText == "P") {
                $("#ProductName").val(objResult.ProductName);
                fillBarcodeList(objResult.ProductName);
            }
            else {
                $("#ProductName").val(objResult.Barcode);
                fillBarcodeList(objResult.ProductName);
                for (var i = 0; i < AvailableProductList.length; i++) {
                    $("#ProductList").append("<option value=" + AvailableProductList[i].ProdCode + ">" + AvailableProductList[i].ProductName + "</option>");
                }
                $("#ProductList").val(objResult.Code);
            }
            fillBatchcodeList(objResult.ProductName);
            $("#BatchcodeList").val(objResult.BatchNo);
            $("#BarcodeList").val(objResult.Barcode);
            $("#StockAvailable").val(objResult.AvailStock);
            $("#DP").val(objResult.DP);
            $("#DiscPer").val(objResult.DiscPer);
            $("#DiscAmt").val(objResult.DiscAmt);
            $("#TaxPer").val(objResult.TaxPer);
            $("#TaxAmt").val(objResult.TaxAmt);
            $("#Amount").val(objResult.Amount);
            $("#TotalAmount").val(objResult.TotalAmount);
            $("#BuyFreeQty").val(objResult.BuyFreeQty);

            if (objResult.IsOfferProduct) {
                if (objResult.IsofferFlexible == "N") {
                    $("#Quantity").val(objResult.Qty);
                    $("#Quantity").attr("readonly", true);
                    $("#FreeQty").val(objResult.FreeQty);
                }
                else {
                    $("#Quantity").val(objResult.Qty);
                    $("#Quantity").attr("readonly", false);
                    if (objResult.FreeQty == "") {
                        $("#FreeQty").val('0');
                    }
                    else {
                        $("#FreeQty").val(objResult.FreeQty);
                    }
                }
            }
            else {
                $("#Quantity").val(objResult.Qty);
                $("#Quantity").attr("readonly", false);
                $("#FreeQty").val(objResult.FreeQty);
            }
            ProductArray = TempProductArray[1];
            // edit me FreeQty bhi ProductArray me hona chahiye (warna NaN)
            ProductArray.FreeQty = toNum(objResult.FreeQty);
            ProductArray.BuyFreeQty = toNum(objResult.BuyFreeQty);
            $("#Quantity").focus();
        }
</script>
