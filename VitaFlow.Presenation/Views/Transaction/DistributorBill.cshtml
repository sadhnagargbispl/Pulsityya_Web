        function RemovePaymode(paymode) {
            LatestAmountEnteresdInPayMode = $.grep(LatestAmountEnteresdInPayMode, function (e) {
                return e.Paymode !== paymode;
            });
            RecalculateCashAmount();
        }
        function safeParse(val) {
            var num = parseFloat(val);
            return isNaN(num) ? 0 : num;
        }
        function clearError() {
            $("#paymodeError").text("");
        }

