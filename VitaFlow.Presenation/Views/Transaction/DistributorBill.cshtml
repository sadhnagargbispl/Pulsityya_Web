        function GetProductInfo(isProductSearch, data, offerProduct, offerQty) {

            var dataValue = data;
            var getInfo = true;
            var IsBillOnMrp = $("#IsBillOnMrp").val();
            var OfferType = parseFloat($("#OfferType").val());
            var index = OfferItemList.indexOf(data);
            var offerID = 0;
            var IsSpclOffer = false;

            var SpclOffer = parseFloat($("#SpclOffer").val());
            if (SpclOffer > 0) {
                if (ProductGrid.length < SpclOffer) {
                    if (index != -1) {
                        offerID = SelectedOfferID;
                        IsOfferProduct = true;
                        IsBillOnMrp = true;
                        IsSpclOffer = true;
                    }
                    else {
                        getInfo = false;
                        IsOfferProduct = false;
                        IsBillOnMrp = false;
                        IsSpclOffer = false;
                        $("#ProductName").val("");
                        ShowWarn("Product is not in offer hence can't be added at first " + SpclOffer + " position");
                    }
                }
                else {
                    IsOfferProduct = false;
                    IsBillOnMrp = false;
                    IsSpclOffer = false;
                }
            }
            else {
                if (index != -1) {
                    offerID = SelectedOfferID;
                    IsOfferProduct = true;
                    IsBillOnMrp = true;
                }
                else {
                    offerID = 0;
                    IsOfferProduct = false;
                    IsBillOnMrp = false;
                }
            }
            if ((OfferType == 2 || OfferType == 3) && index != -1) {
                offerID = SelectedOfferID;
                IsOfferProduct = true;
                IsBillOnMrp = true;
                IsSpclOffer = false;
            }

            if (getInfo && (isProductSearch == "P" || isProductSearch == "B")) {
                if (dataValue != "" && dataValue != null && dataValue != undefined) {

                    $.ajax({
                        url: '/Transaction/GetproductInfoBatchWise',
                        type: 'POST',
                        async: false,
                        data: { "SearchType": isProductSearch, "data": dataValue, "isCForm": false, "BillType": "distributor", "IsBillOnMrp": IsBillOnMrp, "OfferID": offerID, "StockforParty": null, "allhalf": false, "IsSpclOffer": IsSpclOffer },
                        dataType: "json",
                        success: function (objResult) {

                            if (objResult != null && objResult.length > 0) {

                                // Invoice Type ke against galat product (barcode se bhi) add na ho paye
