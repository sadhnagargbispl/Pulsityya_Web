    // Invoice Type -> Product For code:  A / T -> "J" (Joining),  R -> "R" (Repurchase).
    // "Both" wale products dono me aate hain. Invoice Type select na ho to koi filter nahi.
    function GetProdForCode() {
        var invType = $("#SelectedInvoiceType").val() || "";
        if (invType == "A" || invType == "T") { return "J"; }
        if (invType == "R") { return "R"; }
        return "";
    }

    function IsProductAllowedForInvoiceType(product) {
        var want = GetProdForCode();
        if (want == "") { return true; }

        var pf = (product && product.productFor) ? String(product.productFor).toUpperCase() : "B";
        if (pf == "B" || pf == want) { return true; }

        var msg = (want == "J")
            ? "Yeh Repurchase ka product hai - Activation/Upgrade bill me add nahi kar sakte."
            : "Yeh Joining ka product hai - Repurchase bill me add nahi kar sakte.";
        WarnToast(msg, 6000);
        return false;
    }

    function GetProductInfo(isProductSearch, data, offerProduct, offerQty) {

        var dataValue = data;
        var getInfo = true;
        var IsBillOnMrp = $("#IsBillOnMrp").val();
        var OfferType = parseFloat($("#OfferType").val());
        var index = OfferItemList.indexOf(data);
        var offerID = 0;
        var IsSpclOffer = false;

        var SpclOffer = parseFloat($("#SpclOffer").val());
        if (SpclOffer > 0) {
            if (ProductGrid.length < SpclOffer) {
                if (index != -1) {
                    offerID = SelectedOfferID;
                    IsOfferProduct = true;
                    IsBillOnMrp = true;
                    IsSpclOffer = true;
                }
                else {
                    getInfo = false;
                    IsOfferProduct = false;
                    IsBillOnMrp = false;
                    IsSpclOffer = false;
                    $("#ProductName").val("");
