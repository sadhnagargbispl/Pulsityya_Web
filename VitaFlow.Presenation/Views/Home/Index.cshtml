@model VitaFlow.Domain.Entities.User
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home Page";
    var vfSummary = Model.dashboardSummary ?? new VitaFlow.Domain.Entities.DashboardSummary();
}

<style>
    .vf-stat-card {
        background: #fff;
        border: none;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(17, 38, 80, .07);
        padding: 22px 24px;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 18px;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .vf-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 32px rgba(17, 38, 80, .12);
        }

    .vf-stat-icon {
        flex-shrink: 0;
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #fff;
    }

    .vf-stat-icon.sale-today { background: linear-gradient(135deg, #2e5fe6, #00b8a9); }
    .vf-stat-icon.sale-total { background: linear-gradient(135deg, #00b8a9, #2ec4a6); }
    .vf-stat-icon.purchase-today { background: linear-gradient(135deg, #f0932b, #eb4d4b); }
    .vf-stat-icon.purchase-total { background: linear-gradient(135deg, #6c5ce7, #a55eea); }

    .vf-stat-body { min-width: 0; }

    .vf-stat-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: #6b7891;
        margin: 0 0 6px;
    }

    .vf-stat-value {
        font-size: 24px;
        font-weight: 700;
        color: #1b2740;
        line-height: 1.2;
        word-break: break-word;
    }

    @@media (max-width: 575px) {
        .vf-stat-card { padding: 18px; gap: 14px; }
        .vf-stat-value { font-size: 20px; }
    }
</style>

<div class="vf-dashboard">
    <!-- Breadcrumb Start -->
    <div class="breadcrumb-header justify-content-between">
        <div class="left-content">
            <div>
                <h2 class="main-content-title tx-24 mg-b-1 mg-b-lg-1">Hi, @Convert.ToString(Context.Session.GetString("UserName"))!</h2>
                <p class="mg-b-0"> @Convert.ToString(Context.Session.GetString("PartyName"))</p>
            </div>
        </div>
    </div>
    <!-- Breadcrumb End -->

    <div class="row row-sm row-deck">
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="vf-stat-card">
                <div class="vf-stat-icon sale-today"><i class="fa fa-shopping-bag" aria-hidden="true"></i></div>
                <div class="vf-stat-body">
                    <p class="vf-stat-label">Today Sale</p>
                    <div class="vf-stat-value">&#8377; @vfSummary.TodaySale.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="vf-stat-card">
                <div class="vf-stat-icon sale-total"><i class="fa fa-line-chart" aria-hidden="true"></i></div>
                <div class="vf-stat-body">
                    <p class="vf-stat-label">Total Sale</p>
                    <div class="vf-stat-value">&#8377; @vfSummary.TotalSale.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="vf-stat-card">
                <div class="vf-stat-icon purchase-today"><i class="fa fa-shopping-cart" aria-hidden="true"></i></div>
                <div class="vf-stat-body">
                    <p class="vf-stat-label">Today Purchase</p>
                    <div class="vf-stat-value">&#8377; @vfSummary.TodayPurchase.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="vf-stat-card">
                <div class="vf-stat-icon purchase-total"><i class="fa fa-cubes" aria-hidden="true"></i></div>
                <div class="vf-stat-body">
                    <p class="vf-stat-label">Total Purchase</p>
                    <div class="vf-stat-value">&#8377; @vfSummary.TotalPurchase.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
</div>
